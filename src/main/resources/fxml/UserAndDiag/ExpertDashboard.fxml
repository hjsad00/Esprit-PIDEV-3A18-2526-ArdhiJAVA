<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="1060.0"
    stylesheets="@../../Style/UserAndDiagStyles.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.ExpertDashboardController">
    <children>

        <!-- ═══════════════════════════════════════════════
             LAYER 1: DEEP BACKGROUND
        ════════════════════════════════════════════════ -->
        <AnchorPane>
            <children>
                <AnchorPane style="-fx-background-color: #0A0F0D;"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                <!-- Top-left green ambient -->
                <AnchorPane style="-fx-background-color: radial-gradient(center 10% 15%, radius 40%, #1a3d2b, transparent);"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                <!-- Bottom-right warm amber ambient -->
                <AnchorPane style="-fx-background-color: radial-gradient(center 90% 85%, radius 35%, #1f2a10, transparent);"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                <!-- Subtle grid -->
                <AnchorPane opacity="0.05"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- ═══════════════════════════════════════════════
             LAYER 2: LAYOUT
        ════════════════════════════════════════════════ -->
        <VBox spacing="0.0">
            <children>

                <!-- ─────────────────────────────────────────
                     HEADER BAR
                ───────────────────────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="0.0" prefHeight="62.0" minHeight="62.0" maxHeight="62.0"
                    style="-fx-padding: 0 32; -fx-background-color: rgba(8,14,11,0.82);">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.55)" radius="12" offsetY="4"/>
                    </effect>
                    <children>
                        <!-- Back button -->
                        <Button mnemonicParsing="false" onAction="#goBack"
                            style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 8; -fx-text-fill: rgba(200,230,210,0.8); -fx-cursor: hand; -fx-padding: 7 14; -fx-font-size: 13;"
                            text="← Retour">
                            <HBox.margin><Insets right="18.0"/></HBox.margin>
                        </Button>

                        <!-- Accent line -->
                        <AnchorPane prefWidth="3.0" prefHeight="22.0"
                            style="-fx-background-color: #5db87a; -fx-background-radius: 2;">
                            <HBox.margin><Insets right="14.0"/></HBox.margin>
                        </AnchorPane>

                        <!-- Title -->
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                            <children>
                                <Label text="ESPACE EXPERT"
                                    style="-fx-text-fill: rgba(160,210,175,0.55); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                <Label text="Tableau de Bord Agronome"
                                    style="-fx-text-fill: #eef4f0; -fx-font-size: 17; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                            </children>
                        </VBox>

                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

                        <!-- Refresh button -->
                        <Button mnemonicParsing="false" onAction="#handleRefresh"
                            style="-fx-background-color: rgba(93,184,122,0.12); -fx-background-radius: 10; -fx-border-color: rgba(93,184,122,0.3); -fx-border-radius: 10; -fx-text-fill: #7dc995; -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 12; -fx-font-weight: bold;"
                            text="↻  Actualiser"/>
                    </children>
                </HBox>

                <!-- Green bottom border of header -->
                <AnchorPane prefHeight="1.0"
                    style="-fx-background-color: rgba(93,184,122,0.18);"/>

                <!-- ─────────────────────────────────────────
                     MAIN BODY: LEFT PANEL + RIGHT DETAIL
                ───────────────────────────────────────── -->
                <HBox spacing="0.0" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- ══════════════════════════════════
                             LEFT PANEL — Review Queue
                        ═══════════════════════════════════ -->
                        <VBox prefWidth="290.0" minWidth="290.0" maxWidth="290.0" spacing="14.0"
                            style="-fx-background-color: rgba(6,12,9,0.6); -fx-border-color: rgba(93,184,122,0.12); -fx-border-width: 0 1 0 0; -fx-padding: 20 16;">
                            <children>

                                <!-- Panel Label -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <AnchorPane prefWidth="3.0" prefHeight="16.0"
                                            style="-fx-background-color: #5db87a; -fx-background-radius: 2;"/>
                                        <Label text="DEMANDES EN ATTENTE"
                                            style="-fx-text-fill: rgba(160,210,175,0.6); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <!-- List -->
                                <ListView fx:id="reviewListView" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent;
                                           -fx-control-inner-background: transparent;
                                           -fx-border-color: transparent;
                                           -fx-padding: 0;"/>
                            </children>
                        </VBox>

                        <!-- ══════════════════════════════════
                             RIGHT PANEL — Detail View
                        ═══════════════════════════════════ -->
                        <ScrollPane fx:id="detailScrollPane" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minWidth="0.0"
                            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                            <content>
                                <VBox fx:id="detailPanel" spacing="20.0" minWidth="0.0"
                                    style="-fx-background-color: transparent; -fx-padding: 28 32 40 32;">
                                    <children>

                                        <!-- ── EMPTY STATE ── -->
                                        <VBox fx:id="vboxNoSelection" alignment="CENTER" spacing="12.0"
                                            style="-fx-padding: 80 0 0 0;">
                                            <children>
                                                <Label text="🌿"
                                                    style="-fx-font-size: 48; -fx-opacity: 0.3;"/>
                                                <Label fx:id="lblNoSelection" text="Sélectionnez un cas à examiner"
                                                    style="-fx-text-fill: rgba(180,210,190,0.35); -fx-font-size: 16; -fx-font-family: 'Georgia'; -fx-font-style: italic;"
                                                    alignment="CENTER" maxWidth="999999"/>
                                                <Label fx:id="lblNoSelectionSub" text="Choisissez une demande dans le panneau de gauche"
                                                    style="-fx-text-fill: rgba(150,180,160,0.25); -fx-font-size: 11;"
                                                    alignment="CENTER" maxWidth="999999"/>
                                            </children>
                                        </VBox>

                                        <!-- ════════════════════════════════════
                                             DIAGNOSIS REVIEW PANEL
                                        ════════════════════════════════════ -->
                                        <VBox fx:id="diagnosisPanel" visible="false" managed="false" spacing="0.0" minWidth="0.0"
                                            style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 18; -fx-border-color: rgba(93,184,122,0.15); -fx-border-radius: 18; -fx-border-width: 1;">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.35)" radius="22" offsetY="6"/>
                                            </effect>
                                            <children>

                                                <!-- Panel header -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                    style="-fx-background-color: linear-gradient(to bottom right, rgba(40,90,60,0.6), rgba(30,60,45,0.7)); -fx-background-radius: 18 18 0 0; -fx-padding: 16 24;">
                                                    <children>
                                                        <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36"
                                                            style="-fx-background-color: rgba(93,184,122,0.2); -fx-background-radius: 10;">
                                                            <Label text="🔬" style="-fx-font-size: 18;"/>
                                                        </StackPane>
                                                        <VBox spacing="2.0">
                                                            <children>
                                                                <Label text="ÉVALUATION DU DIAGNOSTIC"
                                                                    style="-fx-text-fill: rgba(160,210,175,0.6); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <Label text="Revue d'analyse IA"
                                                                    style="-fx-text-fill: #e8f4ec; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                                                            </children>
                                                        </VBox>
                                                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                                                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                                            <children>
                                                                <Label fx:id="lblFarmerName" text="Agriculteur"
                                                                    style="-fx-text-fill: rgba(200,230,210,0.85); -fx-font-size: 12; -fx-font-weight: bold;"/>
                                                                <Label fx:id="lblDiagDate" text="Date"
                                                                    style="-fx-text-fill: rgba(160,190,170,0.5); -fx-font-size: 10;"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- Panel body -->
                                                <VBox spacing="18.0" style="-fx-padding: 24;">
                                                    <children>

                                                        <!-- Image + AI result side by side -->
                                                        <HBox spacing="24.0" alignment="CENTER_LEFT">
                                                            <children>
                                                                <!-- Image -->
                                                                <StackPane style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12; -fx-padding: 8;">
                                                                    <effect>
                                                                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.5)" radius="14" offsetY="4"/>
                                                                    </effect>
                                                                    <ImageView fx:id="diagImage" fitHeight="180.0" fitWidth="250.0"
                                                                        preserveRatio="true" pickOnBounds="true"/>
                                                                </StackPane>

                                                                <!-- AI Diagnosis result -->
                                                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="RÉSULTAT IA"
                                                                            style="-fx-text-fill: rgba(230,200,100,0.55); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                        <Label fx:id="lblAiDiagnosis" text="Chargement..."
                                                                            wrapText="true" minWidth="0.0" prefWidth="100.0"
                                                                            style="-fx-text-fill: #e8d96a; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                                                                        <AnchorPane prefHeight="1.0" maxWidth="999999"
                                                                            style="-fx-background-color: rgba(255,255,255,0.06);"/>
                                                                        <Label text="Votre diagnostic expert"
                                                                            style="-fx-text-fill: rgba(200,220,210,0.5); -fx-font-size: 10; -fx-font-weight: bold;"/>
                                                                        <TextField fx:id="txtExpertDiseaseName"
                                                                            promptText="Confirmer ou corriger le nom de la maladie..."
                                                                            minWidth="50.0"
                                                                            style="-fx-background-color: rgba(255,255,255,0.05);
                                                                                   -fx-text-fill: white;
                                                                                   -fx-prompt-text-fill: rgba(255,255,255,0.25);
                                                                                   -fx-border-color: rgba(93,184,122,0.25);
                                                                                   -fx-border-radius: 8;
                                                                                   -fx-background-radius: 8;
                                                                                   -fx-padding: 9 12;
                                                                                   -fx-font-size: 12;"/>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                        <!-- Notes -->
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <Label text="NOTES &amp; RECOMMANDATIONS"
                                                                    style="-fx-text-fill: rgba(200,220,210,0.5); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <TextArea fx:id="txtExpertNotes"
                                                                    promptText="Vos observations cliniques, recommandations de traitement..."
                                                                    prefRowCount="4" wrapText="true"
                                                                    style="-fx-background-color: rgba(255,255,255,0.04);
                                                                           -fx-text-fill: rgba(220,235,225,0.9);
                                                                           -fx-prompt-text-fill: rgba(255,255,255,0.2);
                                                                           -fx-border-color: rgba(93,184,122,0.2);
                                                                           -fx-border-radius: 10;
                                                                           -fx-background-radius: 10;
                                                                           -fx-control-inner-background: rgba(20,40,30,0.4);
                                                                           -fx-font-size: 12;
                                                                           -fx-padding: 10;"/>
                                                            </children>
                                                        </VBox>

                                                        <!-- Submit button -->
                                                        <Button onAction="#handleSubmitDiagnosis"
                                                            prefHeight="44.0" maxWidth="999999"
                                                            style="-fx-background-color: linear-gradient(to bottom right, #3d8a58, #2d6642);
                                                                   -fx-background-radius: 10;
                                                                   -fx-border-color: rgba(93,184,122,0.4);
                                                                   -fx-border-radius: 10;
                                                                   -fx-text-fill: white;
                                                                   -fx-font-size: 13;
                                                                   -fx-font-weight: bold;
                                                                   -fx-cursor: hand;"
                                                            text="✅  Soumettre l'Avis Diagnostic">
                                                            <effect>
                                                                <DropShadow blurType="GAUSSIAN" color="rgba(60,140,90,0.4)" radius="12" offsetY="3"/>
                                                            </effect>
                                                        </Button>

                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <!-- ════════════════════════════════════
                                             PROGRESS REVIEW PANEL
                                        ════════════════════════════════════ -->
                                        <VBox fx:id="progressPanel" visible="false" managed="false" spacing="0.0" minWidth="0.0"
                                            style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 18; -fx-border-color: rgba(150,100,220,0.15); -fx-border-radius: 18; -fx-border-width: 1;">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.35)" radius="22" offsetY="6"/>
                                            </effect>
                                            <children>

                                                <!-- Panel header -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                    style="-fx-background-color: linear-gradient(to bottom right, rgba(60,30,90,0.65), rgba(45,22,70,0.75)); -fx-background-radius: 18 18 0 0; -fx-padding: 16 24;">
                                                    <children>
                                                        <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36"
                                                            style="-fx-background-color: rgba(150,100,220,0.2); -fx-background-radius: 10;">
                                                            <Label text="📊" style="-fx-font-size: 18;"/>
                                                        </StackPane>
                                                        <VBox spacing="2.0">
                                                            <children>
                                                                <Label text="SUIVI DE TRAITEMENT"
                                                                    style="-fx-text-fill: rgba(200,170,255,0.55); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <Label fx:id="lblProgressTitle" text="Revue de progression"
                                                                    style="-fx-text-fill: #f0ecfc; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>
                                                            </children>
                                                        </VBox>
                                                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
                                                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                                            <children>
                                                                <Label fx:id="lblProgressFarmer" text="Agriculteur"
                                                                    style="-fx-text-fill: rgba(220,200,255,0.85); -fx-font-size: 12; -fx-font-weight: bold;"/>
                                                                <Label fx:id="lblDiseaseName" text="Maladie"
                                                                    style="-fx-text-fill: rgba(180,160,220,0.5); -fx-font-size: 10;"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- Panel body -->
                                                <VBox spacing="18.0" style="-fx-padding: 24;">
                                                    <children>

                                                        <!-- Photo comparison -->
                                                        <HBox fx:id="photoComparisonBox" alignment="CENTER" spacing="20.0">
                                                            <children>
                                                                <VBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="AVANT"
                                                                            style="-fx-text-fill: rgba(200,200,200,0.45); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                        <StackPane style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.07); -fx-border-radius: 10; -fx-padding: 6;">
                                                                            <effect>
                                                                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.4)" radius="10" offsetY="3"/>
                                                                            </effect>
                                                                            <ImageView fx:id="imgOriginal" fitHeight="150.0" fitWidth="210.0"
                                                                                preserveRatio="true" pickOnBounds="true"/>
                                                                        </StackPane>
                                                                    </children>
                                                                </VBox>

                                                                <Label text="→"
                                                                    style="-fx-text-fill: rgba(200,180,255,0.3); -fx-font-size: 26;"/>

                                                                <VBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="APRÈS"
                                                                            style="-fx-text-fill: rgba(200,200,200,0.45); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                        <StackPane style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.07); -fx-border-radius: 10; -fx-padding: 6;">
                                                                            <effect>
                                                                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.4)" radius="10" offsetY="3"/>
                                                                            </effect>
                                                                            <ImageView fx:id="imgFollowUp" fitHeight="150.0" fitWidth="210.0"
                                                                                preserveRatio="true" pickOnBounds="true"/>
                                                                        </StackPane>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                        <!-- AI Analysis box -->
                                                        <VBox fx:id="aiAnalysisBox" spacing="8.0"
                                                            style="-fx-background-color: rgba(212,170,30,0.08); -fx-background-radius: 10; -fx-border-color: rgba(212,170,30,0.22); -fx-border-radius: 10; -fx-padding: 14 16;">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label text="🤖" style="-fx-font-size: 14;"/>
                                                                        <Label fx:id="lblAiAnalysisTitle" text="Analyse IA"
                                                                            style="-fx-text-fill: #e8c96a; -fx-font-size: 11; -fx-font-weight: bold;"/>
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="lblAiAnalysis" text="..."
                                                                    wrapText="true" minWidth="0.0" prefWidth="100.0"
                                                                    style="-fx-text-fill: rgba(230,215,160,0.8); -fx-font-size: 12;"/>
                                                            </children>
                                                        </VBox>

                                                        <!-- Separator with label -->
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <AnchorPane prefWidth="3.0" prefHeight="14.0"
                                                                    style="-fx-background-color: rgba(150,100,220,0.6); -fx-background-radius: 2;"/>
                                                                <Label text="GESTION DES TÂCHES"
                                                                    style="-fx-text-fill: rgba(200,170,255,0.55); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <AnchorPane prefHeight="1.0" HBox.hgrow="ALWAYS"
                                                                    style="-fx-background-color: rgba(255,255,255,0.06);"/>
                                                            </children>
                                                        </HBox>

                                                        <!-- Task list container -->
                                                        <VBox fx:id="taskListContainer" spacing="8.0"/>

                                                        <!-- Add new task row -->
                                                        <HBox spacing="8.0" alignment="CENTER_LEFT"
                                                            style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.07); -fx-border-radius: 10; -fx-padding: 10 12;">
                                                            <children>
                                                                <Label text="Ajouter"
                                                                    style="-fx-text-fill: rgba(200,180,255,0.55); -fx-font-size: 10; -fx-font-weight: bold;"/>
                                                                <TextField fx:id="txtNewTaskDay" promptText="Jour"
                                                                    prefWidth="58.0"
                                                                    style="-fx-background-color: rgba(255,255,255,0.05);
                                                                           -fx-text-fill: white;
                                                                           -fx-prompt-text-fill: rgba(255,255,255,0.2);
                                                                           -fx-border-color: rgba(150,100,220,0.2);
                                                                           -fx-border-radius: 6;
                                                                           -fx-background-radius: 6;
                                                                           -fx-padding: 7 10;
                                                                           -fx-font-size: 11;"/>
                                                                <TextField fx:id="txtNewTaskDescription"
                                                                    promptText="Description de la tâche..."
                                                                    HBox.hgrow="ALWAYS" minWidth="50.0"
                                                                    style="-fx-background-color: rgba(255,255,255,0.05);
                                                                           -fx-text-fill: white;
                                                                           -fx-prompt-text-fill: rgba(255,255,255,0.2);
                                                                           -fx-border-color: rgba(150,100,220,0.2);
                                                                           -fx-border-radius: 6;
                                                                           -fx-background-radius: 6;
                                                                           -fx-padding: 7 10;
                                                                           -fx-font-size: 11;"/>
                                                                <Button onAction="#handleAddTask" text="＋"
                                                                    style="-fx-background-color: rgba(93,184,122,0.2);
                                                                           -fx-background-radius: 6;
                                                                           -fx-border-color: rgba(93,184,122,0.35);
                                                                           -fx-border-radius: 6;
                                                                           -fx-text-fill: #7dc995;
                                                                           -fx-font-size: 15;
                                                                           -fx-cursor: hand;
                                                                           -fx-padding: 4 12;"/>
                                                            </children>
                                                        </HBox>

                                                        <!-- Separator -->
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <AnchorPane prefWidth="3.0" prefHeight="14.0"
                                                                    style="-fx-background-color: rgba(212,170,30,0.5); -fx-background-radius: 2;"/>
                                                                <Label text="VERDICT &amp; RAPPORT"
                                                                    style="-fx-text-fill: rgba(220,200,120,0.55); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <AnchorPane prefHeight="1.0" HBox.hgrow="ALWAYS"
                                                                    style="-fx-background-color: rgba(255,255,255,0.06);"/>
                                                            </children>
                                                        </HBox>

                                                        <!-- Verdict combo -->
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <Label text="VERDICT EXPERT"
                                                                    style="-fx-text-fill: rgba(200,180,120,0.5); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <ComboBox fx:id="verdictCombo"
                                                                    promptText="Choisir un verdict..."
                                                                    maxWidth="999999"
                                                                    style="-fx-background-color: rgba(255,255,255,0.05);
                                                                           -fx-border-color: rgba(212,170,30,0.25);
                                                                           -fx-border-radius: 8;
                                                                           -fx-background-radius: 8;
                                                                           -fx-text-fill: white;
                                                                           -fx-font-size: 12;"/>
                                                            </children>
                                                        </VBox>

                                                        <!-- Notes -->
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <Label text="NOTES &amp; RECOMMANDATIONS"
                                                                    style="-fx-text-fill: rgba(200,200,200,0.45); -fx-font-size: 9; -fx-font-weight: bold;"/>
                                                                <TextArea fx:id="txtProgressNotes"
                                                                    promptText="Vos observations et recommandations..."
                                                                    prefRowCount="4" wrapText="true"
                                                                    style="-fx-background-color: rgba(255,255,255,0.04);
                                                                           -fx-text-fill: rgba(220,235,225,0.9);
                                                                           -fx-prompt-text-fill: rgba(255,255,255,0.2);
                                                                           -fx-border-color: rgba(150,100,220,0.2);
                                                                           -fx-border-radius: 10;
                                                                           -fx-background-radius: 10;
                                                                           -fx-control-inner-background: rgba(20,15,35,0.4);
                                                                           -fx-font-size: 12;
                                                                           -fx-padding: 10;"/>
                                                            </children>
                                                        </VBox>

                                                        <!-- Submit button -->
                                                        <Button onAction="#handleSubmitProgress"
                                                            prefHeight="44.0" maxWidth="999999"
                                                            style="-fx-background-color: linear-gradient(to bottom right, #6a35b0, #4e2880);
                                                                   -fx-background-radius: 10;
                                                                   -fx-border-color: rgba(150,100,220,0.4);
                                                                   -fx-border-radius: 10;
                                                                   -fx-text-fill: white;
                                                                   -fx-font-size: 13;
                                                                   -fx-font-weight: bold;
                                                                   -fx-cursor: hand;"
                                                            text="✅  Soumettre l'Avis de Suivi">
                                                            <effect>
                                                                <DropShadow blurType="GAUSSIAN" color="rgba(100,50,180,0.4)" radius="12" offsetY="3"/>
                                                            </effect>
                                                        </Button>

                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</StackPane>