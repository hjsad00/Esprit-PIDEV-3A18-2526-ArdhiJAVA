<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="1060.0" style="-fx-background-color: linear-gradient(to bottom right, #F5F7F0, #E8EBE0);" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.AdminTraitementsController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 25;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="10"/>
                    </effect>
                    <children>
                        <Button mnemonicParsing="false" onAction="#retour" style="-fx-background-color: #F5F7F0; -fx-background-radius: 8; -fx-cursor: hand;" text="← Retour" textFill="#6B7F3F">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                            <padding>
                                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
                            </padding>
                        </Button>
                        <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                            <image>
                                <Image url="@../../img/ardhi_logo.png"/>
                            </image>
                        </ImageView>
                        <Label text="Gestion Traitements" style="-fx-text-fill: #6B7F3F;">
                            <font>
                                <Font name="System Bold" size="22.0"/>
                            </font>
                        </Label>
                        <Label text="Administration" style="-fx-text-fill: #C4A574; -fx-background-color: #FFF8F0; -fx-background-radius: 5; -fx-padding: 4 10;">
                            <font>
                                <Font name="System Bold" size="11.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Main Content -->
                <VBox fx:id="mainContainer" spacing="12.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Search Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 20;">
                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="8"/>
                            </effect>
                            <children>
                                <Label text="🔍" style="-fx-font-size: 18;"/>
                                <TextField fx:id="tfRecherche" promptText="Rechercher par Solution, Description..." prefWidth="280.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 8;">
                                    <font>
                                        <Font size="12.0"/>
                                    </font>
                                </TextField>
                                <Label text="Type :" style="-fx-text-fill: #666666;">
                                    <font>
                                        <Font size="12.0"/>
                                    </font>
                                    <HBox.margin>
                                        <Insets left="10.0"/>
                                    </HBox.margin>
                                </Label>
                                <ComboBox fx:id="cbFiltreType" promptText="Tous les types" prefWidth="150.0"/>
                                <Button onAction="#rafraichir" style="-fx-background-color: #5B99A3; -fx-background-radius: 5; -fx-cursor: hand;" text="Réinitialiser" textFill="WHITE">
                                    <font>
                                        <Font size="11.0"/>
                                    </font>
                                    <padding>
                                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/>
                                    </padding>
                                </Button>
                                <Label fx:id="lblInfo" text="" style="-fx-text-fill: #888888;">
                                    <font>
                                        <Font size="11.0"/>
                                    </font>
                                    <HBox.margin>
                                        <Insets left="15.0"/>
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Content Area -->
                        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Table -->
                                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 0;" HBox.hgrow="ALWAYS">
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="8"/>
                                    </effect>
                                    <children>
                                        <Label text="💡 Astuce : Cliquez sur une ligne pour modifier. Cliquez dans le vide pour ajouter." style="-fx-text-fill: #888888;">
                                            <font>
                                                <Font name="System Italic" size="12.0"/>
                                            </font>
                                            <padding>
                                                <Insets left="15.0" top="10.0" bottom="5.0"/>
                                            </padding>
                                        </Label>
                                        <TableView fx:id="tableTraitements" style="-fx-background-radius: 10; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                                                <TableColumn fx:id="colDiagId" prefWidth="60.0" text="Diag ID"/>
                                                <TableColumn fx:id="colSolution" prefWidth="150.0" text="Solution"/>
                                                <TableColumn fx:id="colType" prefWidth="100.0" text="Type"/>
                                                <TableColumn fx:id="colDescription" prefWidth="250.0" text="Description"/>
                                            </columns>

                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Form / Details Panel -->
                                <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="320.0">
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="8"/>
                                    </effect>
                                    <children>
                                        <Label fx:id="lblTitreFormulaire" text="Détails du Traitement" style="-fx-text-fill: #2c3e50;">
                                            <font>
                                                <Font name="System Bold" size="16.0"/>
                                            </font>
                                            <VBox.margin>
                                                <Insets bottom="10.0"/>
                                            </VBox.margin>
                                        </Label>

                                        <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                            <content>
                                                <VBox spacing="12.0" style="-fx-background-color: transparent;">
                                                    <children>
                                                        <Label text="ID Diagnostic" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                                                        <TextField fx:id="tfDiagId" promptText="ID du diagnostic" style="-fx-background-radius: 5;"/>

                                                        <Label text="Nom de la Solution" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                                                        <TextField fx:id="tfSolution" promptText="Soin Mildiou..." style="-fx-background-radius: 5;"/>

                                                        <Label text="Type de Traitement" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                                                        <ComboBox fx:id="cbType" promptText="Sélectionner un type..." maxWidth="Infinity"/>

                                                        <Label text="Description Détaillée" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                                                        <TextArea fx:id="taDescription" promptText="Détails du traitement..." wrapText="true" prefHeight="100.0" style="-fx-background-radius: 5;"/>

                                                    </children>
                                                </VBox>
                                            </content>
                                        </javafx.scene.control.ScrollPane>

                                        <!-- Buttons -->
                                        <HBox spacing="10.0" alignment="CENTER" VBox.vgrow="ALWAYS">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <children>
                                                <Button fx:id="btnAjouter" onAction="#ajouterTraitement" text="Ajouter" style="-fx-background-color: #6B7F3F; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" prefWidth="100.0"/>
                                                <Button fx:id="btnModifier" onAction="#modifierTraitement" text="Modifier" style="-fx-background-color: #C4A574; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" prefWidth="100.0" visible="false"/>
                                                <Button fx:id="btnSupprimer" onAction="#supprimerTraitement" text="Supprimer" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" prefWidth="100.0" visible="false"/>
                                            </children>
                                        </HBox>
                                        <Button onAction="#viderChamps" text="Abandonner" style="-fx-background-color: transparent; -fx-text-fill: #95a5a6; -fx-underline: true; -fx-cursor: hand;" maxWidth="Infinity"/>

                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>