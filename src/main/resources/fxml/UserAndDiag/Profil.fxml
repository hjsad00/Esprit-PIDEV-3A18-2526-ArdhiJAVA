<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.ProfilController">
    <children>
        <!-- BACKGROUND LAYER -->
        <AnchorPane style="-fx-background-image: url('@../../img/profil_background.jpg'); -fx-background-size: cover; -fx-background-position: center;">
            <children>
                <!-- Dark Overlay -->
                <javafx.scene.layout.Region style="-fx-background-color: black;" opacity="0.4" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- CONTENT LAYER -->
        <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="20.0" alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="100.0" right="20.0" bottom="40.0" left="20.0" />
                    </padding>
                    <children>
                        <!-- PROFILE FORM CARD -->
                        <VBox alignment="CENTER" spacing="20.0" maxWidth="550.0" style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1; -fx-border-radius: 20;">
                            <children>
                                <!-- Title -->
                                <Label text="Informations Personnelles" style="-fx-text-fill: #333;">
                                    <font>
                                        <Font name="System Bold" size="22.0"/>
                                    </font>
                                </Label>

                                <Label text="Mettez à jour vos informations de compte" style="-fx-text-fill: #666; -fx-font-size: 13px;"/>

                                <!-- Form Fields -->
                                <VBox spacing="15.0" maxWidth="500.0">
                                    <children>
                                        <HBox spacing="15.0">
                                            <children>
                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Nom" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                        <TextField fx:id="tfNom" promptText="Votre nom" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Prénom" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                        <TextField fx:id="tfPrenom" promptText="Votre prénom" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Adresse Email" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                <TextField fx:id="tfEmail" promptText="exemple@ardhi.tn" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                            </children>
                                        </VBox>

                                        <!-- Phone Number Field with Verification -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Numéro de Téléphone" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                                    <ComboBox fx:id="cbCountryCode" promptText="+216" prefWidth="120.0" style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.8); -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8;" />
                                                    <TextField fx:id="tfPhone" promptText="12 345 678" HBox.hgrow="ALWAYS" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                    <Button fx:id="btnVerifyPhone" mnemonicParsing="false" onAction="#verifyPhone" text="Vérifier" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 11; -fx-font-weight: bold;">
                                                        <padding><Insets bottom="8.0" top="8.0" left="12.0" right="12.0" /></padding>
                                                    </Button>
                                                </HBox>
                                                <!-- SMS Verification Code Input (hidden initially) -->
                                                <HBox fx:id="hboxSmsCode" spacing="6.0" alignment="CENTER_LEFT" managed="false" visible="false">
                                                    <TextField fx:id="tfSmsCode" promptText="Code SMS" prefWidth="120.0" style="-fx-background-color: #FFF8E1; -fx-text-fill: #333; -fx-background-radius: 8; -fx-border-color: #F39C12; -fx-border-radius: 8; -fx-padding: 10;"/>
                                                    <Button fx:id="btnValidateCode" mnemonicParsing="false" onAction="#validateSmsCode" text="Valider" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 11; -fx-font-weight: bold;">
                                                        <padding><Insets bottom="8.0" top="8.0" left="12.0" right="12.0" /></padding>
                                                    </Button>
                                                    <Label fx:id="lblPhoneStatus" style="-fx-text-fill: #888888;" text=""/>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Location Field with Autocomplete -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Localisation" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                <TextField fx:id="tfLocation" promptText="Tapez votre ville..." style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                <ListView fx:id="lvCitySuggestions" maxHeight="150.0" managed="false" visible="false" style="-fx-background-color: white; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 2);"/>
                                            </children>
                                        </VBox>

                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label text="Mon rôle" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                    <ComboBox fx:id="cbRole" promptText="Choisir votre rôle" style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.8); -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-pref-height: 40;" maxWidth="Infinity"/>
                                                </children>
                                            </VBox>

                                            <!-- Security Section - Unified, less boxy -->
                                            <VBox spacing="10.0" style="-fx-padding: 10 0;">
                                                <children>
                                                    <Label text="Sécurité &amp; Biométrie" style="-fx-font-weight: bold; -fx-text-fill: #444; -fx-font-size: 15px;"/>
                                                    <CheckBox fx:id="cbTwoFactor" text="Activer l'authentification à deux facteurs (2FA)" style="-fx-text-fill: #555;"/>
                                                    
                                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                        <Button fx:id="btnEnroll" text="Configurer Empreinte" onAction="#enrollFingerprint" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                                            <font>
                                                                <Font name="System Bold" size="12.0"/>
                                                            </font>
                                                            <padding>
                                                                <Insets top="8" bottom="8" left="15" right="15"/>
                                                            </padding>
                                                        </Button>
                                                        
                                                        <Button fx:id="btnDeleteFingerprint" text="Supprimer Empreinte" onAction="#deleteFingerprint" visible="false" managed="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                                             <font>
                                                                <Font name="System Bold" size="12.0"/>
                                                            </font>
                                                            <padding>
                                                                <Insets top="8" bottom="8" left="15" right="15"/>
                                                            </padding>
                                                        </Button>

                                                        <Label fx:id="lblEnrollStatus" text="Non configuré" style="-fx-text-fill: #888; -fx-font-style: italic;"/>
                                                    </HBox>
                                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                        <Button fx:id="btnEnrollFace" text="Configurer Visage" onAction="#enrollFace" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                                            <font>
                                                                <Font name="System Bold" size="12.0"/>
                                                            </font>
                                                            <padding>
                                                                <Insets top="8" bottom="8" left="15" right="15"/>
                                                            </padding>
                                                        </Button>
                                                        
                                                        <Button fx:id="btnDeleteFace" text="Supprimer Visage" onAction="#deleteFace" visible="false" managed="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                                             <font>
                                                                <Font name="System Bold" size="12.0"/>
                                                            </font>
                                                            <padding>
                                                                <Insets top="8" bottom="8" left="15" right="15"/>
                                                            </padding>
                                                        </Button>

                                                        <Label fx:id="lblFaceEnrollStatus" text="Non configuré" style="-fx-text-fill: #888; -fx-font-style: italic;"/>
                                                    </HBox>
                                                    
                                                    <!-- Camera Preview for Face Registration -->
                                                    <VBox fx:id="paneCameraFace" alignment="CENTER" spacing="10" managed="false" visible="false">
                                                        <ImageView fx:id="cameraViewFace" fitHeight="150" fitWidth="200" preserveRatio="true"/>
                                                        <HBox spacing="10" alignment="CENTER">
                                                            <Button onAction="#captureFace" text="Capturer" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 8;" />
                                                            <Button onAction="#cancelFaceEnroll" text="Annuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" />
                                                        </HBox>
                                                    </VBox>

                                                    <Label text="L'empreinte et le visage permettent une connexion rapide et sécurisée." wrapText="true" style="-fx-text-fill: #777; -fx-font-size: 11px; -fx-font-style: italic;" maxWidth="480"/>
                                                </children>
                                            </VBox>
                                        
                                        <HBox spacing="15.0">
                                             <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label text="Mot de passe actuel" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                    <PasswordField fx:id="tfAncienMdp" promptText="Requis pour changer" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                </children>
                                            </VBox>

                                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label text="Nouveau mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                                    <PasswordField fx:id="tfNouveauMdp" promptText="Optionnel" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-background-color: rgba(255,255,255,0.8);"/>
                                                </children>
                                            </VBox>
                                        </HBox>

                                    </children>
                                </VBox>

                                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#modifier" prefWidth="150.0" style="-fx-background-color: #6B7F3F; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 1);" text="Enregistrer" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                            <padding>
                                                <Insets bottom="10.0" top="10.0"/>
                                            </padding>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#supprimer" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #e74c3c; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;" text="Supprimer compte" textFill="#e74c3c">
                                            <font>
                                                <Font name="System Bold" size="13.0"/>
                                            </font>
                                            <padding>
                                                <Insets bottom="9.0" top="9.0"/>
                                            </padding>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </javafx.scene.control.ScrollPane>
        <!-- HEADER OVERLAY -->
        <AnchorPane pickOnBounds="false">
             <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 10 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.3)" radius="10" offsetY="2"/>
                    </effect>
                    <children>
                        <Button mnemonicParsing="false" onAction="#retour" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: white;" text="←">
                            <font>
                                <Font size="20.0"/>
                            </font>
                        </Button>
                        <Label text="Mon Profil" style="-fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);">
                            <font>
                                <Font name="System Bold" size="20.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>
             </children>
        </AnchorPane>
    </children>
</StackPane>