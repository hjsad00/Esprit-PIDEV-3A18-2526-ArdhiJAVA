<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="1060.0" style="-fx-background-color: linear-gradient(to bottom right, #F5F7F0, #E8EBE0);" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.AdminSettingsController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 25;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="10"/>
                    </effect>
                    <children>
                        <Button mnemonicParsing="false" onAction="#retour" style="-fx-background-color: #F5F7F0; -fx-background-radius: 8; -fx-cursor: hand;" text="← Retour" textFill="#6B7F3F">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                            <padding>
                                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
                            </padding>
                        </Button>
                        <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                            <image>
                                <Image url="@../../img/ardhi_logo.png"/>
                            </image>
                        </ImageView>
                        <Label text="Paramètres du système" style="-fx-text-fill: #6B7F3F;">
                            <font>
                                <Font name="System Bold" size="22.0"/>
                            </font>
                        </Label>
                        <Label text="Administration" style="-fx-text-fill: #C4A574; -fx-background-color: #FFF8F0; -fx-background-radius: 5; -fx-padding: 4 10;">
                            <font>
                                <Font name="System Bold" size="11.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Free Tier Settings -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="15"/>
                    </effect>
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                    </padding>

                    <Label text="🆓 Paramètres du tier gratuit" style="-fx-text-fill: #6B7F3F;">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <Label text="Ces paramètres s'appliquent aux utilisateurs sans abonnement actif." style="-fx-text-fill: #666;"/>

                    <HBox spacing="30.0" alignment="CENTER_LEFT">
                        <VBox spacing="8.0">
                            <Label text="Nombre de diagnostics par heure" style="-fx-text-fill: #333;">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <TextField fx:id="tfDiagnosticsParHeure" promptText="3" prefWidth="120.0"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-font-size: 14;"/>
                            <Label text="(-1 = illimité)" style="-fx-text-fill: #999; -fx-font-size: 11;"/>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Privilèges" style="-fx-text-fill: #333;">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <CheckBox fx:id="cbAccesTraitement" text="Autoriser l'accès aux recommandations" 
                                      style="-fx-text-fill: #666;"/>
                            <CheckBox fx:id="cbAccesPlanTraitement" text="Autoriser l'accès au Plan de soin IA" 
                                      style="-fx-text-fill: #666;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Status Label -->
                <Label fx:id="lblStatus" text="" style="-fx-text-fill: #27ae60; -fx-font-size: 13;" alignment="CENTER" maxWidth="Infinity"/>

                <!-- Spacer to push buttons to bottom -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Save/Reset Buttons at Bottom -->
                <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 25;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="10"/>
                    </effect>
                    <Button onAction="#sauvegarder" 
                            style="-fx-background-color: #6B7F3F; -fx-background-radius: 8; -fx-cursor: hand;" 
                            text="💾 Sauvegarder" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="13.0"/>
                        </font>
                        <padding>
                            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                    </Button>
                    <Button onAction="#reinitialiser" 
                            style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-cursor: hand;" 
                            text="↺ Réinitialiser" textFill="WHITE">
                        <font>
                            <Font size="13.0"/>
                        </font>
                        <padding>
                            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
                        </padding>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
