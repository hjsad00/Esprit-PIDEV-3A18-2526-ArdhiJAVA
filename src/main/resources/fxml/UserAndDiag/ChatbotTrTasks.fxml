<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="350.0" spacing="10.0" style="-fx-padding: 10; -fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.ChatbotTrTasksController">
   <children>
      <TextArea fx:id="chatArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13;" />
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="inputField" onAction="#sendMessage" promptText="Posez votre question..." HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#sendMessage" text="Envoyer" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" />
         </children>
      </HBox>
   </children>
</VBox>
