<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="1060.0" stylesheets="@../../Style/UserAndDiagStyles.css" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.HealthScanHistoryController">
    <children>
        <!-- Background Image -->
        <AnchorPane styleClass="community-background" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <!-- Dark Overlay -->
        <Rectangle height="710.0" width="1060.0" opacity="0.4" fill="BLACK" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="80.0">
            <children>
                <!-- Table Container (Glass) -->
                <VBox style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 15;" VBox.vgrow="ALWAYS">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.2)" radius="10"/>
                    </effect>
                    <children>
                        <TableView fx:id="tableHistorique" VBox.vgrow="ALWAYS" fixedCellSize="40" styleClass="table-view, history-table" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10; -fx-background-insets: 0;">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date du Scan"/>
                                <TableColumn fx:id="colAiAnalysis" prefWidth="500.0" text="Résultat de l'analyse"/>
                                <TableColumn fx:id="colHealthScore" prefWidth="100.0" text="Score Santé"/>
                            </columns>

                            <placeholder>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label text="🌿" style="-fx-font-size: 48; -fx-opacity: 0.5;"/>
                                        <Label text="Aucun scan pour le moment" style="-fx-text-fill: #555;">
                                            <font>
                                                <Font size="14.0"/>
                                            </font>
                                        </Label>
                                        <Label text="Effectuez un scan de vos plantes pour commencer" style="-fx-text-fill: #666;">
                                            <font>
                                                <Font size="12.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" prefHeight="30.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Label text="Double-cliquez sur un scan pour voir les vulnérabilités" style="-fx-text-fill: rgba(0,0,0,0.7);">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 5 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.3)" radius="10" offsetY="2"/>
            </effect>
            <children>
                <Button mnemonicParsing="false" onAction="#retourDashboard" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: white;" text="←">
                    <font>
                        <Font size="20.0"/>
                    </font>
                </Button>
                <Label text="Historique des Scans" style="-fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);" minWidth="200">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>

                <!-- Search Bar (Glass) -->
                <TextField fx:id="tfRecherche" promptText="Rechercher (culture, analyse)..." style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.7); -fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20;" HBox.hgrow="ALWAYS" maxWidth="400"/>

                <Label fx:id="lblInfo" text="Chargement..." style="-fx-text-fill: white; -fx-font-size: 11px;">
                </Label>

                <Button onAction="#reinitialiser"
                        style="-fx-background-color: linear-gradient(to right, #6B7F3F, #4A5A2B); -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 5, 0, 0, 1); -fx-padding: 8 20;"
                        text="🔄 Réinitialiser" textFill="white">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</AnchorPane>