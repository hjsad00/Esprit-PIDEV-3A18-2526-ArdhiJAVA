<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextFlow?>

<StackPane prefHeight="600.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.LoginController">

    <!-- Background Pattern -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #F5F7F0, #E8EBE0);" />

    <!-- Main Content -->
    <HBox alignment="CENTER" maxWidth="660.0" spacing="0.0" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 8);">

        <!-- Left Side - Branding (Green Theme) -->
        <AnchorPane prefWidth="330.0">
            <children>
                <!-- Green Gradient Background -->
                <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: linear-gradient(to bottom, #6B7F3F, #4A5A2B); -fx-background-radius: 20 0 0 20; -fx-padding: 30;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                    <!-- Logo -->
                    <StackPane>
                        <Circle fill="white" radius="45.0" stroke="#E8EBE0" strokeWidth="3.0">
                            <effect><DropShadow color="rgba(0,0,0,0.2)" radius="8" /></effect>
                        </Circle>
                        <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                            <image>
                                <Image url="@/img/ardhi_logo.png" />
                            </image>
                        </ImageView>
                    </StackPane>

                    <!-- Welcome Text -->
                    <VBox alignment="CENTER" spacing="10.0">
                        <Label style="-fx-text-fill: white;" text="Bienvenue sur">
                            <font><Font size="16.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="ARDHI">
                            <font><Font size="36.0" /></font>
                            <effect><Glow level="0.6" /></effect>
                        </Label>
                        <Label style="-fx-text-fill: #E8EBE0; -fx-font-weight: bold;" text="Connectez-vous">
                            <font><Font size="16.0" /></font>
                        </Label>
                    </VBox>

                    <Label maxWidth="250.0" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-text-alignment: CENTER;" text="Accédez à votre tableau de bord et gérez votre exploitation." wrapText="true">
                        <font><Font size="13.0" /></font>
                    </Label>

                </VBox>
                <Label layoutX="10.0" layoutY="10.0" style="-fx-text-fill: white; -fx-font-weight: bold;">
                    <font>
                        <Font size="36.0" />
                    </font>
                    <effect>
                        <Glow level="0.6" />
                    </effect>

                </Label>
            </children>
        </AnchorPane>

        <!-- Right Side - Login Form (Light/Clean Theme) -->
        <VBox alignment="CENTER" prefWidth="330.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 0 20 20 0; -fx-padding: 30 40;">

            <!-- Form Header -->
            <VBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-text-fill: #6B7F3F; -fx-font-weight: bold;" text="Connexion">
                    <font><Font size="26.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #666666;" text="Heureux de vous revoir !">
                    <font><Font size="12.0" /></font>
                </Label>
            </VBox>

            <!-- Form Fields -->
            <VBox maxWidth="280.0" spacing="15.0">

                <!-- Email Field -->
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-weight: bold;" text="Adresse Email">
                        <font><Font size="11.0" /></font>
                    </Label>
                    <TextField fx:id="tfEmail" promptText="exemple@ardhi.tn" style="-fx-background-color: #F9F9F9; -fx-text-fill: #333; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10;">
                        <font><Font size="12.0" /></font>
                    </TextField>
                </VBox>

                <!-- Password Field with Eye Toggle -->
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-weight: bold;" text="Mot de passe">
                        <font><Font size="11.0" /></font>
                    </Label>
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="pfMdp" promptText="••••••••" style="-fx-background-color: #F9F9F9; -fx-text-fill: #333; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10;">
                                <font><Font size="12.0" /></font>
                            </PasswordField>
                            <TextField fx:id="tfPasswordVisible" promptText="••••••••" visible="false" style="-fx-background-color: #F9F9F9; -fx-text-fill: #333; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10;">
                                <font><Font size="12.0" /></font>
                            </TextField>
                        </StackPane>
                        <Button fx:id="btnTogglePassword" mnemonicParsing="false" onAction="#togglePasswordVisibility" text="👁" style="-fx-background-color: #F0F0F0; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 14;">
                            <padding><Insets bottom="8.0" top="8.0" left="8.0" right="8.0" /></padding>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Link -->
                <Hyperlink onAction="#motDePasseOublie" style="-fx-text-fill: #6B7F3F;" text="Mot de passe oublié ?" underline="true">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Hyperlink>

            </VBox>

            <!-- Login Button (Olive Green) -->
            <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#login" prefWidth="280.0" style="-fx-background-color: linear-gradient(to right, #6B7F3F, #4A5A2B); -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 13;" text="SE CONNECTER">
                <padding>
                    <Insets bottom="10.0" top="10.0" />
                </padding>
                <effect>
                    <DropShadow color="rgba(107, 127, 63, 0.4)" offsetY="2" radius="8" />
                </effect>
            </Button>

            <!-- Biometric Login Button -->
            <Button fx:id="btnBiometric" onAction="#loginWithBiometric" managed="false" mnemonicParsing="false" prefWidth="280.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 13;" text="Se connecter avec Empreinte" visible="false">
                <padding>
                    <Insets bottom="10.0" top="10.0" />
                </padding>
                <effect>
                    <DropShadow color="rgba(0, 120, 215, 0.4)" offsetY="2" radius="8" />
                </effect>
            </Button>

            <!-- Face Login Button -->
            <Button fx:id="btnFaceLogin" onAction="#loginWithFace" mnemonicParsing="false" prefWidth="280.0" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 13;" text="Connexion Faciale">
                <padding>
                    <Insets bottom="10.0" top="10.0" />
                </padding>
                <effect>
                    <DropShadow color="rgba(155, 89, 182, 0.4)" offsetY="2" radius="8" />
                </effect>
            </Button>

            <!-- Camera Preview for Face Login -->
            <VBox fx:id="paneCameraLogin" alignment="CENTER" spacing="10" managed="false" visible="false">
                <ImageView fx:id="cameraViewLogin" fitHeight="150" fitWidth="200" preserveRatio="true"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button onAction="#captureAndVerifyFace" text="Scanner &amp; Vérifier" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 8;" />
                    <Button onAction="#cancelFaceLogin" text="Annuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" />
                </HBox>
            </VBox>

            <Label style="-fx-text-fill: #888888;" text="Vous n'avez pas de compte ?">
                <font>
                    <Font size="10.0" />
                </font>
            </Label>

            <!-- Divider -->
            <HBox alignment="CENTER" maxWidth="280.0" spacing="10.0">
                <Line endX="100.0" opacity="0.3" startX="0.0" stroke="#888" strokeWidth="1.0" />
                <Label style="-fx-text-fill: #888;" text="OU">
                    <font><Font size="10.0" /></font>
                </Label>
                <Line endX="100.0" opacity="0.3" startX="0.0" stroke="#888" strokeWidth="1.0" />
            </HBox>

            <!-- Register Button (Outlined Green) -->
            <Button mnemonicParsing="false" onAction="#goToInscription" prefWidth="280.0" style="-fx-background-color: transparent; -fx-text-fill: #6B7F3F; -fx-cursor: hand; -fx-background-radius: 20; -fx-border-color: #6B7F3F; -fx-border-radius: 20; -fx-border-width: 1.5; -fx-font-weight: bold; -fx-font-size: 12;" text="CRÉER UN COMPTE">
                <padding>
                    <Insets bottom="8.0" top="8.0" />
                </padding>
            </Button>

        </VBox>
    </HBox>
</StackPane>
