<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="1060.0" style="-fx-background-color: linear-gradient(to bottom right, #F5F7F0, #E8EBE0);" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserAndDiag.AdminUserBadgesController">
    <children>
        <VBox fx:id="mainContainer" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 25;">
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="10"/>
                    </effect>
                    <children>
                        <Button mnemonicParsing="false" onAction="#retour" style="-fx-background-color: #F5F7F0; -fx-background-radius: 8; -fx-cursor: hand;" text="Retour" textFill="#6B7F3F">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                            <padding>
                                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
                            </padding>
                        </Button>
                        <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                            <image>
                                <Image url="@../../img/ardhi_logo.png"/>
                            </image>
                        </ImageView>
                        <Label text="Affectation des Badges" style="-fx-text-fill: #6B7F3F;">
                            <font>
                                <Font name="System Bold" size="22.0"/>
                            </font>
                        </Label>
                        <Label text="Administration" style="-fx-text-fill: #C4A574; -fx-background-color: #FFF8F0; -fx-background-radius: 5; -fx-padding: 4 10;">
                            <font>
                                <Font name="System Bold" size="11.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>

    <!-- Main Content -->
    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
        </padding>

        <!-- Table Section -->
        <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12;">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="15"/>
            </effect>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Search/Filter Section -->
            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12;">
                <Label text="🔍" style="-fx-font-size: 14;"/>
                <TextField fx:id="tfFiltre" promptText="Nom utilisateur ou badge..." prefWidth="250.0" 
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #ddd;"/>
                
                <Button onAction="#resetFiltre" style="-fx-background-color: #999; -fx-background-radius: 6; -fx-cursor: hand;" 
                        text="Réinitialiser" textFill="WHITE">
                    <font><Font size="11.0"/></font>
                    <padding><Insets bottom="6.0" left="10.0" right="10.0" top="6.0"/></padding>
                </Button>
                <Label fx:id="lblInfo" text="0 affectations" style="-fx-text-fill: #999; -fx-font-style: italic;">
                    <font><Font size="11.0"/></font>
                    <HBox.margin><Insets left="10.0"/></HBox.margin>
                </Label>
            </HBox>

            <TableView fx:id="tableUserBadges" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUser" prefWidth="200.0" text="Utilisateur"/>
                    <TableColumn fx:id="colBadge" prefWidth="150.0" text="Badge"/>
                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Date d'obtention"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Form Section -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" prefWidth="350.0" hbarPolicy="NEVER">
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12;">
                <effect>
                    <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="15"/>
                </effect>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <Label fx:id="lblTitreFormulaire" text="Attribuer un badge" style="-fx-text-fill: #6B7F3F;">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>

                <!-- User Selection -->
                <VBox spacing="5.0">
                    <Label text="Utilisateur *" style="-fx-text-fill: #666;"/>
                    <ComboBox fx:id="cbUser" promptText="Choisir un utilisateur" maxWidth="Infinity"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                </VBox>

                <!-- Badge Selection -->
                <VBox spacing="5.0">
                    <Label text="Badge *" style="-fx-text-fill: #666;"/>
                    <ComboBox fx:id="cbBadge" promptText="Choisir un badge" maxWidth="Infinity"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                </VBox>

                <Label text="Note: L'attribution est immédiate." style="-fx-text-fill: #999; -fx-font-size: 11; -fx-font-style: italic;"/>

                <!-- Buttons -->
                <HBox spacing="10.0" alignment="CENTER">
                    <Button fx:id="btnAttribuer" mnemonicParsing="false" onAction="#attribuer" 
                            style="-fx-background-color: linear-gradient(to right, #6B7F3F, #4A5A2B); -fx-background-radius: 8; -fx-cursor: hand;" 
                            text="Attribuer" textFill="WHITE" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <font>
                            <Font name="System Bold" size="12.0"/>
                        </font>
                        <padding>
                            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
                        </padding>
                    </Button>
                    <Button fx:id="btnRevoquer" mnemonicParsing="false" onAction="#revoquer" 
                            style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-cursor: hand;" 
                            text="Révoquer" textFill="WHITE" visible="false" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <font>
                            <Font name="System Bold" size="12.0"/>
                        </font>
                        <padding>
                            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
                        </padding>
                    </Button>
                </HBox>

                <Button mnemonicParsing="false" onAction="#vider" 
                        style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-cursor: hand;" 
                        text="Annuler / Nouveau" textFill="WHITE" maxWidth="Infinity">
                    <font>
                        <Font size="11.0"/>
                    </font>
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0"/>
                    </padding>
                </Button>
            </VBox>
        </ScrollPane>
    </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
