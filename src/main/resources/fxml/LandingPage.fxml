                              style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 20;">
                           <children>
                              <Label text="Nos Services" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" />
                              
                              <ScrollPane fx:id="servicesScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                                  <content>
                                      <VBox spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 0 15 0 0;">
                                          <children>
                                              <!-- Service Item: Diagnostic -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToUserDiag" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="🧠" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Diagnostic IA" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Analyse de maladies" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>

                                              <!-- Service Item: Marketplace -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToMarketplace" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="🛒" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Marketplace" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Vente et achat" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>

                                              <!-- Service Item: Maintenance -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToMaintenance" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="🔧" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Maintenance" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Gestion matériel" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>

                                              <!-- Service Item: Cultures -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToCultures" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="🌱" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Cultures" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Suivi parcellaire" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>

                                              <!-- Service Item: Evenements -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToEvents" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="📅" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Évènements" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Agenda agricole" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>
                                              
                                               <!-- Service Item: Employés -->
                                              <HBox spacing="15.0" alignment="CENTER_LEFT" onMouseClicked="#goToEmployees" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                  <children>
                                                      <Label text="👥" style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" />
                                                      <VBox>
                                                          <Label text="Employés" style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" />
                                                          <Label text="Gestion RH" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                      </VBox>
                                                  </children>
                                              </HBox>
                                          </children>
                                      </VBox>
                                  </content>
                              </ScrollPane>
                           </children>
                        </VBox>

                         <!-- SCROLLABLE NAVIGATION CONTROLS -->
                         <!-- Left Arrow -->
                         <Button mnemonicParsing="false" onAction="#prevSlide" text="❮" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="335.0"
                                 style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 50; -fx-cursor: hand; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-padding: 0;">
                             <effect>
                                 <DropShadow color="rgba(0,0,0,0.3)" radius="10" />
                             </effect>
                         </Button>

                         <!-- Right Arrow -->
                         <Button mnemonicParsing="false" onAction="#nextSlide" text="❯" AnchorPane.rightAnchor="440.0" AnchorPane.topAnchor="335.0"
                                 style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 50; -fx-cursor: hand; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-padding: 0;">
                             <effect>
                                 <DropShadow color="rgba(0,0,0,0.3)" radius="10" />
                             </effect>
                         </Button>

                     </children>
                  </AnchorPane>
                  
                  <!-- GREEN FOOTER SECTION -->
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #334418; -fx-padding: 40 20; -fx-background-radius: 20 20 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, -5);">
                     <children>
                        <Label text="Restez connecté" style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 16px; -fx-font-weight: bold;" />
                        <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 10 0;">
                           <children>
                              <Label text="FACEBOOK" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" />
                              <Label text="INSTAGRAM" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" />
                              <Label text="TWITTER" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" />
                           </children>
                        </HBox>
                        
                        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                             <Label text="À propos" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" />
                             <Label text="Contact" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" />
                             <Label text="Confidentialité" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" />
                         </HBox>
                        
                        <Label text="© 2026 Ardhi. All rights reserved." style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px; -fx-padding: 20 0 0 0;" />
                     </children>
                  </VBox>
                  
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- LAYER 3: FIXED HEADER (Sticky) -->
      <!-- LAYER 3: FIXED HEADER (Sticky) -->
      <AnchorPane pickOnBounds="false" StackPane.alignment="TOP_CENTER">
          <children>
               <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.6);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                   <children>
                       <!-- Logo -->
                       <ImageView fitHeight="45.0" fitWidth="120.0" preserveRatio="true">
                           <image>
                               <Image url="@../img/ardhi_logo.png" />
                           </image>
                       </ImageView>
                       
                       <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
        
                       <!-- Navigation Menu -->
                       <HBox fx:id="navMenu" alignment="CENTER" spacing="15.0">
                           <children>
                               <Button fx:id="btnNavDiagnostics" mnemonicParsing="false" onAction="#goToAgriculteur" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Diagnostic IA" />
                                <Button fx:id="btnNavMarketplace" mnemonicParsing="false" onAction="#goToMarketplace" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Marketplace" />
                               <Button fx:id="btnNavMaintenance" mnemonicParsing="false" onAction="#goToMaintenance" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Maintenance" />
                                <Button fx:id="btnNavCultures" mnemonicParsing="false" onAction="#goToCultures" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cultures" />
                               <Button fx:id="btnNavEvents" mnemonicParsing="false" onAction="#goToEvents" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Évènements" />
                               <Button fx:id="btnNavEmployees" mnemonicParsing="false" onAction="#goToEmployees" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Employés" />
                           </children>
                       </HBox>
        
                       <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
        
                       <!-- Auth Area -->
                       <StackPane>
                           <children>
                               <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#goToLogin" style="-fx-background-color: #6B7F3F; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20;" text="Se connecter">
                                   <font><Font name="System Bold" size="13.0" /></font>
                                   <effect><DropShadow color="rgba(0,0,0,0.3)" radius="10" /></effect>
                               </Button>
                               <HBox fx:id="profileContainer" alignment="CENTER" maxHeight="45.0" maxWidth="45.0" minHeight="45.0" minWidth="45.0" onMouseClicked="#goToProfile" style="-fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 100; -fx-border-color: rgba(255,255,255,0.5); -fx-border-radius: 100;" visible="false">
                                   <children>
                                       <Label text="👤" textFill="WHITE" style="-fx-font-size: 24px;" />
                                   </children>
                               </HBox>
                           </children>
                       </StackPane>
                   </children>
               </HBox>
          </children>
      </AnchorPane>
   </children>
</StackPane>
