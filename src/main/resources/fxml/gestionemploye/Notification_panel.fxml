<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.gestionemployecontroller.NotificationController"
            prefHeight="700.0" prefWidth="900.0" styleClass="main-container"
            stylesheets="@../../Style/modern-lists.css">

    <!-- ========== HEADER ========== -->
    <top>
        <VBox spacing="15" styleClass="page-header" style="-fx-padding: 20;">
            <!-- Titre et statistiques -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="lblTitre" text="🔔 Notifications" styleClass="label-title"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStats" text="0 notification(s)"
                       style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
            </HBox>

            <!-- Filtres et actions -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Filtrer :" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                <ComboBox fx:id="cmbFiltre" prefWidth="200" styleClass="combo-box"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnActualiser" text="🔄 Actualiser"
                        onAction="#handleActualiser"
                        styleClass="button-neutral"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;">
                    <tooltip>
                        <Tooltip text="Analyser et détecter de nouvelles alertes"/>
                    </tooltip>
                </Button>

                <Button fx:id="btnMarquerToutLu" text="✓ Tout marquer lu"
                        onAction="#handleMarquerToutLu"
                        styleClass="button-secondary"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;">
                    <tooltip>
                        <Tooltip text="Marquer toutes les notifications comme lues"/>
                    </tooltip>
                </Button>

                <Button fx:id="btnArchiver" text="📦 Archiver lues"
                        onAction="#handleArchiverLues"
                        styleClass="button-neutral"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;">
                    <tooltip>
                        <Tooltip text="Archiver toutes les notifications lues"/>
                    </tooltip>
                </Button>
            </HBox>

            <!-- Barre de progression -->
            <ProgressIndicator fx:id="progressIndicator"
                               visible="false"
                               maxHeight="30" maxWidth="30"
                               style="-fx-progress-color: #3498db;"/>
        </VBox>
    </top>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: #f5f5f5;">
            <VBox fx:id="notificationContainer" spacing="15"
                  style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
                <!-- Les notifications seront ajoutées dynamiquement ici -->
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
