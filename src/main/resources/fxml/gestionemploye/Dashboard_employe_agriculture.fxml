<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="710.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.gestionemployecontroller.DashboardEmployeAgricultureController">
    <children>
        <!-- LAYER 1: FIXED BACKGROUND (single image) -->
        <AnchorPane>
            <children>
                <ImageView fitHeight="710.0" fitWidth="1060.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <image>
                        <Image url="@../../img/emp.jpg" />
                    </image>
                </ImageView>
                <!-- Dark gradient overlay -->
                <Rectangle height="710.0" style="-fx-fill: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);" width="1060.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- LAYER 2: SCROLLABLE CONTENT -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="TOP_CENTER" prefHeight="725.0" prefWidth="1045.0" style="-fx-background-color: transparent;">
                    <children>
                        <!-- MAIN SECTION -->
                        <AnchorPane minHeight="698.0" prefHeight="698.0" prefWidth="1120.0" style="-fx-background-color: transparent;">
                            <children>
                                <!-- Left Hero Text -->
                                <VBox alignment="CENTER_LEFT" spacing="25.0" style="-fx-padding: 0 50 0 50;" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="180.0">
                                    <children>

                                        <!-- Action Buttons -->
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" />
                                    </children>
                                </VBox>

                                <!-- Right Panel: Two service cards only -->
                                <VBox alignment="TOP_CENTER" layoutX="639.0" layoutY="225.0" maxHeight="450.0" maxWidth="320.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 20;" AnchorPane.rightAnchor="119.40000000000009" AnchorPane.topAnchor="225.0">
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="%dashboard.services" />

                                        <ScrollPane fx:id="servicesScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED">
                                            <content>
                                                <VBox spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 0 15 0 0;">
                                                    <children>
                                                        <!-- Card: Gestion employés -->
                                                        <HBox alignment="CENTER_LEFT" onMouseClicked="#goToEmployeListFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="👥" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="%dashboard.card.employees" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="%dashboard.card.employees.desc" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <!-- Card: Gestion tâches -->
                                                        <HBox alignment="CENTER_LEFT" onMouseClicked="#goToTacheListFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="📋" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="%dashboard.card.tasks" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="%dashboard.card.tasks.desc" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>

                                <!-- 🌦️ PANNEAU MÉTÉO AGRICOLE -->
                                <VBox fx:id="weatherPanel" alignment="TOP_LEFT" layoutX="39.2" layoutY="465.8" prefHeight="163.0" prefWidth="459.0" spacing="10.0" style="-fx-background-color: rgba(0,0,0,0.55); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 18; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 4);" AnchorPane.bottomAnchor="69.39999999999998" AnchorPane.leftAnchor="39.2">
                                    <children>
                                        <!-- Header météo -->
                                        <HBox alignment="CENTER_LEFT" prefHeight="77.0" prefWidth="380.0" spacing="10.0">
                                            <children>
                                                <Label fx:id="lblMeteoIcone" style="-fx-font-size: 36px; -fx-font-family: 'Segoe UI Emoji';" text="🌤️" />
                                                <VBox spacing="2.0">
                                                    <Label fx:id="lblTemperature" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="--°C" />
                                                    <Label fx:id="lblMeteoDesc" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Chargement..." />
                                                    <Label fx:id="lblMeteoVille" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;" text="📍 Tunis" />
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <!-- Stats météo complémentaires -->
                                                <VBox alignment="CENTER_RIGHT" prefHeight="78.0" prefWidth="134.0" spacing="3.0">
                                                    <Label fx:id="lblMeteoHumid" prefHeight="16.0" prefWidth="110.0" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11px;" text="💧 Humidité : --%" />
                                                    <Label fx:id="lblMeteoVent" prefHeight="16.0" prefWidth="103.0" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11px;" text="💨 Vent : -- km/h" />
                                                    <Label fx:id="lblMeteoFeels" prefHeight="16.0" prefWidth="112.0" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11px;" text="🌡️ Ressenti : --°C" />
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Séparateur -->
                                        <Rectangle fill="rgba(255,255,255,0.25)" height="1.0" width="350.0" />

                                        <!-- Section alertes agricoles -->
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12px; -fx-font-weight: bold;" text="⚠️ Alertes Météo Agricoles" />
                                        <VBox fx:id="vboxAlertes" spacing="6.0" />
                                    </children>
                                </VBox>

                                <AnchorPane layoutX="-680.0" pickOnBounds="false" />
                                <Button layoutX="677.0" layoutY="500.0" mnemonicParsing="false" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.7); -fx-border-radius: 30; -fx-cursor: hand; -fx-padding: 12 35; -fx-font-size: 15px;" text="%dashboard.home" />
                                <Label fx:id="heroDescription" layoutX="39.0" layoutY="199.0" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 16px; -fx-line-spacing: 5;" text="%dashboard.subtitle" wrapText="true">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>

                                <!-- ══ NAVBAR ══ -->
                                <HBox alignment="CENTER_LEFT" layoutY="-4.0" prefHeight="66.0" prefWidth="1066.0" spacing="20.0" style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.6);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="-8.0" AnchorPane.topAnchor="-4.0">
                                    <children>
                                        <!-- Logo -->
                                        <ImageView fitHeight="52.0" fitWidth="81.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../../img/ardhi_logo.png" />
                                            </image>
                                        </ImageView>

                                        <Label fx:id="lblRole" prefHeight="22.0" prefWidth="115.0" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px; -fx-font-weight: bold;" text="%dashboard.role">
                                            <font>
                                                <Font size="17.0" />
                                            </font>
                                        </Label>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Navigation -->
                                        <HBox fx:id="navMenu" alignment="CENTER" spacing="15.0">
                                            <children>
                                                <Button fx:id="btnNavDiagnostics" onAction="#goToDiagnostic" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.diagnostic" />
                                                <Button fx:id="btnNavCultures" onAction="#goToCultures" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.cultures" />
                                                <Button fx:id="btnNavMaintenance" onAction="#goToMaintenance" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.maintenance" />
                                                <Button fx:id="btnNavEvents" onAction="#goToEvents" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.events" />
                                                <Button fx:id="btnNavEmployees" onAction="#goToEmployeListFromNavbar" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.employees" />
                                                <Button fx:id="btnNavMarketplace" onAction="#goToMarketplace" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="%dashboard.nav.marketplace" />
                                            </children>
                                        </HBox>

                                        <!-- 🔔 BADGE NOTIFICATIONS (rouge si non lues) -->
                                        <StackPane fx:id="notificationBadgeContainer" alignment="CENTER" onMouseClicked="#handleOpenNotifications" style="-fx-cursor: hand; -fx-padding: 5 8;">
                                            <!-- Cercle de fond (visible seulement quand rouge) -->
                                            <Circle fx:id="notificationBellBg" fill="transparent" mouseTransparent="true" radius="16.0" />
                                            <!-- Cloche -->
                                            <Label fx:id="notificationBell" mouseTransparent="true" style="-fx-font-size: 22px; -fx-text-fill: rgba(255,255,255,0.9);" text="🔔" />
                                        </StackPane>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Language Selector -->
                                        <HBox fx:id="languageSelector" alignment="CENTER" spacing="5.0">
                                            <children>
                                                <Button fx:id="btnLangFr" onAction="#switchToFrench" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 4 8; -fx-font-size: 14px;" text="Fr" />
                                                <Button fx:id="btnLangEn" onAction="#switchToEnglish" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 4 8; -fx-font-size: 14px;" text="En" />
                                                <Button fx:id="btnLangAr" onAction="#switchToArabic" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 4 8; -fx-font-size: 14px;" text="Tn" />
                                            </children>
                                        </HBox>

                                        <!-- Logout button -->
                                        <Button mnemonicParsing="false" onAction="#logout" style="-fx-background-color: rgba(231,76,60,0.8); -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 15; -fx-font-size: 12px;" text="%dashboard.logout">
                                            <effect>
                                                <DropShadow color="rgba(0,0,0,0.3)" radius="10" />
                                            </effect>
                                        </Button>
                                    </children>
                                </HBox>
                                <Button layoutX="706.0" layoutY="601.0" onAction="#ouvrirChatbot"
                                        prefHeight="44.0" prefWidth="170.0"
                                        text="🤖 Assistant IA"
                                        style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-padding: 10 22; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(45,106,79,0.55), 12, 0, 0, 4);" />
                                <Label fx:id="lblBienvenue" layoutX="79.0" layoutY="126.0" style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);" text="%dashboard.title" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="42.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>