<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: linear-gradient(135deg, #F5F7F0 0%, #E8EBE0 100%);" stylesheets="@../../Style/modern-lists.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.gestionemployecontroller.NotificationController">

    <VBox spacing="20" style="-fx-padding: 30 40;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
            <VBox>
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="%notification.title" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="%notification.subtitle" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Statistiques -->
            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER" style="-fx-background-color: #F8F9FA; -fx-background-radius: 15px; -fx-padding: 15px 25px;">
                    <Label fx:id="lblTotalNotifications" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #6B7F3F;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-font-weight: 600;" text="%notification.total" />
                </VBox>

                <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(135deg, #4ECDC4 0%, #3AAFA9 100%); -fx-background-radius: 15px; -fx-padding: 15px 25px;">
                    <Label fx:id="lblNonLues" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: 600;" text="%notification.unread" />
                </VBox>
            </HBox>
        </HBox>

        <!-- Actions -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button fx:id="btnMarkAllRead" onAction="#handleMarkAllRead" styleClass="button-modern" text="%notification.mark.all.read" textFill="#e0e0e0" />
            <Button onAction="#handleRefresh" styleClass="button-modern" text="%notification.refresh" textFill="#faf2f2" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Liste des notifications -->
        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <VBox fx:id="notificationList" spacing="15" style="-fx-padding: 5px;" />
        </ScrollPane>

    </VBox>

</StackPane>
