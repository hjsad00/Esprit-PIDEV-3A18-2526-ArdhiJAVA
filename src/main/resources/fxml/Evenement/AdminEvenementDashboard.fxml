<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.neuron.ardhi.controllers.Evenement.AdminEvenementDashboardController"
           stylesheets="@/Style/evenement-style.css"
           style="-fx-background-color: linear-gradient(to bottom right, #667A3F 0%, #8BC34A 100%);">

    <!-- MAIN CONTENT -->
    <BorderPane style="-fx-background-color: transparent;">

        <!-- HEADER SECTION -->
        <top>
            <VBox spacing="20"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-padding: 25 40;
                         -fx-background-radius: 0 0 25 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 8);">

                <!-- Title with Accent Bar -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Region style="-fx-background-color: #6B7F3F; -fx-pref-width: 5; -fx-pref-height: 35; -fx-background-radius: 3;"/>
                    <Label text="🔧 Dashboard Admin - Gestion des Événements"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2C3E50;"/>
                </HBox>

                <!-- KPI Cards Row -->
                <HBox spacing="25" alignment="CENTER">

                    <!-- Total Card -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15;
                                 -fx-padding: 20 40;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                                 -fx-border-color: rgba(52,152,219,0.3);
                                 -fx-border-width: 2;
                                 -fx-border-radius: 15;">
                        <Label text="📊" style="-fx-font-size: 30px;"/>
                        <Label text="Total Événements"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 11px;"/>
                        <Label fx:id="totalLabel" text="0"
                               style="-fx-font-size: 36px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #3498DB;"/>
                    </VBox>

                    <!-- Actifs Card -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15;
                                 -fx-padding: 20 40;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                                 -fx-border-color: rgba(80,200,120,0.3);
                                 -fx-border-width: 2;
                                 -fx-border-radius: 15;">
                        <Label text="✅" style="-fx-font-size: 30px;"/>
                        <Label text="Actifs"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 11px;"/>
                        <Label fx:id="actifLabel" text="0"
                               style="-fx-font-size: 36px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #50C878;"/>
                    </VBox>

                    <!-- Terminés Card -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15;
                                 -fx-padding: 20 40;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                                 -fx-border-color: rgba(149,165,166,0.3);
                                 -fx-border-width: 2;
                                 -fx-border-radius: 15;">
                        <Label text="✓" style="-fx-font-size: 30px;"/>
                        <Label text="Terminés"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 11px;"/>
                        <Label fx:id="termineLabel" text="0"
                               style="-fx-font-size: 36px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #95A5A6;"/>
                    </VBox>

                    <!-- Annulés Card -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15;
                                 -fx-padding: 20 40;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);
                                 -fx-border-color: rgba(231,76,60,0.3);
                                 -fx-border-width: 2;
                                 -fx-border-radius: 15;">
                        <Label text="❌" style="-fx-font-size: 30px;"/>
                        <Label text="Annulés"
                               style="-fx-text-fill: #666666;
                                      -fx-font-size: 11px;"/>
                        <Label fx:id="annuleLabel" text="0"
                               style="-fx-font-size: 36px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #E74C3C;"/>
                    </VBox>

                </HBox>

                <!-- Filters & Actions Bar -->
                <HBox spacing="15" alignment="CENTER_LEFT">

                    <TextField fx:id="searchField"
                               promptText="🔍 Rechercher un événement..."
                               style="-fx-background-color: white;
                                      -fx-background-radius: 20;
                                      -fx-padding: 10 20;
                                      -fx-font-size: 13px;
                                      -fx-border-color: #CCCCCC;
                                      -fx-border-width: 1.5;
                                      -fx-border-radius: 20;"
                               prefWidth="320"/>

                    <Label text="Type:"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #666;"/>
                    <ComboBox fx:id="filterTypeCombo"
                              prefWidth="140"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-padding: 8 15;
                                     -fx-font-size: 13px;
                                     -fx-border-color: #CCCCCC;
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 18;"/>

                    <Label text="Statut:"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #666;"/>
                    <ComboBox fx:id="filterStatutCombo"
                              prefWidth="140"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-padding: 8 15;
                                     -fx-font-size: 13px;
                                     -fx-border-color: #CCCCCC;
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 18;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="➕ Nouvel Événement"
                            onAction="#handleAddEvent"
                            style="-fx-background-color: linear-gradient(to right, #27AE60, #229954);
                                   -fx-text-fill: white;
                                   -fx-background-radius: 20;
                                   -fx-padding: 9 25;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;">
                        <effect>
                            <DropShadow color="rgba(39,174,96,0.4)" radius="12" offsetY="4"/>
                        </effect>
                    </Button>

                    <Button text="🔄 Actualiser"
                            onAction="#handleRefresh"
                            style="-fx-background-color: white;
                                   -fx-border-color: #6B7F3F;
                                   -fx-border-width: 2;
                                   -fx-border-radius: 20;
                                   -fx-background-radius: 20;
                                   -fx-text-fill: #6B7F3F;
                                   -fx-padding: 9 22;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;">
                        <effect>
                            <DropShadow color="rgba(107,127,63,0.2)" radius="8" offsetY="2"/>
                        </effect>
                    </Button>
                </HBox>
            </VBox>
        </top>

        <!-- TABLE SECTION -->
        <center>
            <VBox style="-fx-padding: 25 40 30 40;" spacing="20" VBox.vgrow="ALWAYS">

                <!-- Table Container -->
                <VBox style="-fx-background-color: white;
                             -fx-background-radius: 20;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 6);"
                      VBox.vgrow="ALWAYS">

                    <TableView fx:id="eventsTable"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 15;
                                      -fx-table-cell-border-color: #E0E0E0;
                                      -fx-font-size: 13px;">

                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" minWidth="50" prefWidth="50" maxWidth="60" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="titreColumn" text="Titre" minWidth="150" prefWidth="210" maxWidth="300"/>
                            <TableColumn fx:id="typeColumn" text="Type" minWidth="100" prefWidth="115" maxWidth="150" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="dateColumn" text="Date" minWidth="100" prefWidth="115" maxWidth="150" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="lieuColumn" text="Lieu" minWidth="120" prefWidth="145" maxWidth="200"/>
                            <TableColumn fx:id="participantsColumn" text="Participants" minWidth="90" prefWidth="105" maxWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="statutColumn" text="Statut" minWidth="100" prefWidth="120" maxWidth="150" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="actionsColumn" text="Actions" minWidth="550" prefWidth="280" maxWidth="390" style="-fx-alignment: CENTER;"/>
                        </columns>

                    </TableView>
                </VBox>

                <!-- Back Button -->
                <HBox alignment="CENTER_LEFT">
                    <Button text="← Retour"
                            onAction="#handleRetour"
                            style="-fx-background-color: rgba(255,255,255,0.95);
                                   -fx-background-radius: 20;
                                   -fx-text-fill: #6B7F3F;
                                   -fx-padding: 10 25;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-border-color: rgba(107,127,63,0.4);
                                   -fx-border-width: 2;
                                   -fx-border-radius: 20;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetY="2"/>
                        </effect>
                    </Button>
                </HBox>
            </VBox>
        </center>

    </BorderPane>
</StackPane>
