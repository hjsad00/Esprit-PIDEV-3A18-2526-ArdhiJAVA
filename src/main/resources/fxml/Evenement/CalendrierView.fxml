<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.neuron.ardhi.controllers.Evenement.CalendrierController"
           prefWidth="1060" prefHeight="710"
           stylesheets="@/Style/evenement-style.css"
           style="-fx-background-color: linear-gradient(to bottom right, #667A3F 0%, #8BC34A 100%);">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 28;">

            <!-- ── COMPACT HEADER ── -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-background-radius: 20;
                         -fx-padding: 22 40;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 6);">

                <HBox spacing="12" alignment="CENTER">
                    <Rectangle width="4" height="24"
                               style="-fx-fill: #9B59B6; -fx-arc-width: 0; -fx-arc-height: 0;"/>
                    <Label text="CALENDRIER"
                           style="-fx-text-fill: #9B59B6; -fx-font-size: 12px;
                                  -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>
                </HBox>

                <HBox spacing="16" alignment="CENTER">
                    <Label text="📅" style="-fx-font-size: 36px;"/>
                    <Label fx:id="monthYearLabel" text="FÉVRIER 2026"
                           style="-fx-text-fill: #2C3E50; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Navigation -->
                <HBox spacing="16" alignment="CENTER">
                    <Button text="◀ Précédent" onAction="#handlePreviousMonth"
                            style="-fx-background-color: #6B7F3F; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;">
                        <effect><DropShadow color="rgba(107,127,63,0.4)" radius="8" offsetY="2"/></effect>
                    </Button>
                    <Button text="📍 Aujourd'hui" onAction="#handleToday"
                            style="-fx-background-color: linear-gradient(to right, #3498DB, #2980B9);
                                   -fx-text-fill: white; -fx-background-radius: 20;
                                   -fx-padding: 8 24; -fx-font-weight: bold;
                                   -fx-font-size: 13px; -fx-cursor: hand;">
                        <effect><DropShadow color="rgba(52,152,219,0.4)" radius="8" offsetY="2"/></effect>
                    </Button>
                    <Button text="Suivant ▶" onAction="#handleNextMonth"
                            style="-fx-background-color: #6B7F3F; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;">
                        <effect><DropShadow color="rgba(107,127,63,0.4)" radius="8" offsetY="2"/></effect>
                    </Button>
                </HBox>
            </VBox>

            <!-- ── MAIN AREA ── -->
            <HBox spacing="18" alignment="TOP_CENTER">

                <!-- LEFT: Calendar Grid — compact -->
                <VBox spacing="12" prefWidth="710"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 18;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);">

                    <GridPane fx:id="calendarGrid" hgap="6" vgap="6"
                              style="-fx-background-color: transparent;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <!-- Header row -->
                            <RowConstraints prefHeight="36" vgrow="NEVER"/>
                            <!-- Day rows — smaller minHeight so grid fits in screen -->
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                            <RowConstraints minHeight="62" prefHeight="68" vgrow="ALWAYS"/>
                        </rowConstraints>
                    </GridPane>

                    <!-- Legend -->
                    <HBox spacing="18" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                        <HBox spacing="6" alignment="CENTER">
                            <Rectangle width="10" height="10"
                                       style="-fx-fill: #50C878; -fx-arc-width: 3; -fx-arc-height: 3;"/>
                            <Label text="À venir" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER">
                            <Rectangle width="10" height="10"
                                       style="-fx-fill: #F39C12; -fx-arc-width: 3; -fx-arc-height: 3;"/>
                            <Label text="En cours" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER">
                            <Rectangle width="10" height="10"
                                       style="-fx-fill: #95A5A6; -fx-arc-width: 3; -fx-arc-height: 3;"/>
                            <Label text="Terminé" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER">
                            <Rectangle width="10" height="10"
                                       style="-fx-fill: #E74C3C; -fx-arc-width: 3; -fx-arc-height: 3;"/>
                            <Label text="Annulé" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- RIGHT: Event details panel -->
                <VBox fx:id="eventDetailsBox" spacing="14" prefWidth="300"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 18;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);">

                    <VBox alignment="CENTER" spacing="6">
                        <Label text="📅" style="-fx-font-size: 30px;"/>
                        <Label text="Événements du jour"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <Label fx:id="selectedDateLabel" text="Date sélectionnée"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-style: italic;"/>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(0,0,0,0.1);"/>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox fx:id="eventsList" spacing="12" style="-fx-padding: 4;"/>
                    </ScrollPane>

                    <Button text="🔄 Actualiser" onAction="#handleRefresh"
                            style="-fx-background-color: #3498DB; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 10 16;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"
                            maxWidth="Infinity">
                        <effect><DropShadow color="rgba(52,152,219,0.4)" radius="8" offsetY="2"/></effect>
                    </Button>
                </VBox>
            </HBox>

            <!-- ── BACK BUTTON ── -->
            <Button text="← Retour à la Navigation" onAction="#handleRetour"
                    style="-fx-background-color: rgba(255,255,255,0.9);
                           -fx-text-fill: #6B7F3F;
                           -fx-background-radius: 20;
                           -fx-padding: 10 28;
                           -fx-font-weight: bold;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;
                           -fx-border-color: #6B7F3F;
                           -fx-border-width: 2;
                           -fx-border-radius: 20;">
                <effect><DropShadow color="rgba(0,0,0,0.1)" radius="6" offsetY="2"/></effect>
            </Button>

        </VBox>
    </ScrollPane>
</StackPane>
