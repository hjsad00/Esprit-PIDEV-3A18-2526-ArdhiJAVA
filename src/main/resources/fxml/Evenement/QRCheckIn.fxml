<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.neuron.ardhi.controllers.Evenement.QRCheckInController"
           prefWidth="900" prefHeight="750"
           style="-fx-background-color: linear-gradient(to bottom right, #667A3F 0%, #8BC34A 100%);"
           stylesheets="@/Style/evenement-style.css">

    <!-- CONTENT -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="25" alignment="TOP_CENTER" style="-fx-padding: 35;">

            <!-- ── HEADER ── -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 20;
                         -fx-padding: 25 40;
                         -fx-border-color: rgba(255,255,255,0.15);
                         -fx-border-width: 1;
                         -fx-border-radius: 20;">
                <Label text="📱 QR Code Check-in"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="evenementTitreLabel"
                       text="Sélectionnez un événement"
                       style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.7);"/>
            </VBox>

            <!-- ── STATS CARDS ── -->
            <HBox spacing="20" alignment="CENTER">

                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: rgba(80,200,120,0.15);
                             -fx-background-radius: 15;
                             -fx-padding: 20 35;
                             -fx-border-color: rgba(80,200,120,0.4);
                             -fx-border-width: 2;
                             -fx-border-radius: 15;">
                    <Label text="✅" style="-fx-font-size: 28px;"/>
                    <Label text="Présents"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    <Label fx:id="presentsLabel" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #50C878;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: rgba(52,152,219,0.15);
                             -fx-background-radius: 15;
                             -fx-padding: 20 35;
                             -fx-border-color: rgba(52,152,219,0.4);
                             -fx-border-width: 2;
                             -fx-border-radius: 15;">
                    <Label text="📊" style="-fx-font-size: 28px;"/>
                    <Label text="Inscrits"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    <Label fx:id="inscritsLabel" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498DB;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: rgba(243,156,18,0.15);
                             -fx-background-radius: 15;
                             -fx-padding: 20 35;
                             -fx-border-color: rgba(243,156,18,0.4);
                             -fx-border-width: 2;
                             -fx-border-radius: 15;">
                    <Label text="⏳" style="-fx-font-size: 28px;"/>
                    <Label text="En attente"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    <Label fx:id="enAttenteLabel" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F39C12;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: rgba(155,89,182,0.15);
                             -fx-background-radius: 15;
                             -fx-padding: 20 35;
                             -fx-border-color: rgba(155,89,182,0.4);
                             -fx-border-width: 2;
                             -fx-border-radius: 15;">
                    <Label text="📈" style="-fx-font-size: 28px;"/>
                    <Label text="Taux présence"
                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    <Label fx:id="tauxLabel" text="0%"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;"/>
                </VBox>

            </HBox>

            <!-- ── MAIN PANEL ── -->
            <HBox spacing="25" alignment="TOP_CENTER">

                <!-- LEFT: Sélection événement + scan manuel -->
                <VBox spacing="20" prefWidth="380"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 20;
                             -fx-padding: 30;">

                    <!-- Sélection événement -->
                    <VBox spacing="10">
                        <Label text="🎪 Événement"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <ComboBox fx:id="evenementCombo"
                                  prefWidth="320" prefHeight="45"
                                  onAction="#handleEvenementChange"
                                  style="-fx-background-radius: 12; -fx-background-color: #F8F9FA;
                                         -fx-font-size: 13px;"/>
                    </VBox>

                    <Separator/>

                    <!-- Zone de scan manuel -->
                    <VBox spacing="10">
                        <Label text="🔍 Scanner / Saisir un token"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <Label text="Collez le contenu du QR ou saisissez un token :"
                               style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>

                        <TextArea fx:id="qrInputField"
                                  promptText="ARDHI_CHECKIN|token|P123|E456&#10;— ou —&#10;token direct (32 caractères)"
                                  wrapText="true"
                                  prefRowCount="3"
                                  style="-fx-background-radius: 12; -fx-font-size: 13px;
                                         -fx-border-color: #DEE2E6; -fx-border-radius: 12;"/>

                        <Button text="✅ Valider le Check-in"
                                onAction="#handleManualScan"
                                prefWidth="320" prefHeight="48"
                                style="-fx-background-color: linear-gradient(to right, #27AE60, #2ECC71);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;
                                       -fx-background-radius: 12; -fx-cursor: hand;">
                            <effect>
                                <DropShadow color="rgba(39,174,96,0.4)" radius="12" offsetY="4"/>
                            </effect>
                        </Button>
                    </VBox>

                    <Separator/>

                    <!-- Résultat du scan -->
                    <VBox fx:id="resultBox" spacing="10" alignment="CENTER"
                          style="-fx-background-radius: 15; -fx-padding: 20; -fx-min-height: 100;"
                          visible="false" managed="false">
                        <Label fx:id="resultIcon" text="✅" style="-fx-font-size: 40px;"/>
                        <Label fx:id="resultLabel" text=""
                               wrapText="true"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                        <Label fx:id="resultDetailLabel" text=""
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-text-alignment: center;"/>
                    </VBox>

                    <!-- Bouton actualiser stats -->
                    <Button text="🔄 Actualiser les statistiques"
                            onAction="#handleRefreshStats"
                            prefWidth="320" prefHeight="40"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: #6B7F3F; -fx-border-width: 2;
                                   -fx-border-radius: 10; -fx-background-radius: 10;
                                   -fx-text-fill: #6B7F3F; -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>
                </VBox>

                <!-- RIGHT: Liste des participants -->
                <VBox spacing="15" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 20;
                             -fx-padding: 25;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="👥 Participants"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchParticipant"
                                   promptText="🔍 Filtrer..."
                                   prefWidth="180" prefHeight="36"
                                   style="-fx-background-radius: 18; -fx-font-size: 12px;
                                          -fx-border-color: #DEE2E6; -fx-border-radius: 18;"/>
                    </HBox>

                    <TableView fx:id="participantsTable"
                               prefHeight="420"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 10;
                                      -fx-font-size: 12px;">
                        <columns>
                            <TableColumn fx:id="colNom" text="Nom" prefWidth="130"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="370"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="200" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colAction" text="Action" prefWidth="300" style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>
                </VBox>

            </HBox>

            <!-- ── BACK BUTTON ── -->
            <Button text="← Retour"
                    onAction="#handleRetour"
                    style="-fx-background-color: rgba(255,255,255,0.9);
                           -fx-text-fill: #2C3E50;
                           -fx-border-color: rgba(255,255,255,0.5);
                           -fx-border-width: 2; -fx-border-radius: 20;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-padding: 10 30; -fx-font-size: 13px; -fx-font-weight: bold;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.1)" radius="8" offsetY="2"/>
                </effect>
            </Button>

        </VBox>
    </ScrollPane>

</StackPane>
