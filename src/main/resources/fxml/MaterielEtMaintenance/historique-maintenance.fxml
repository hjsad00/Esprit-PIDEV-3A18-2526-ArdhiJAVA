<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="860.0" prefWidth="1300.0"
            style="-fx-background-color: #f5f3ee;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.MaterielEtMaintenance.HistoriqueMaintenanceController">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #566734; -fx-padding: 16 28;">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="📋  Historique des Maintenances"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Filtres avancés · Tri multi-colonnes · Suivi des statuts"
                       style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 11px;"/>
            </VBox>
            <Button text="🔄  Actualiser" onAction="#handleActualiser"
                    style="-fx-background-color: white; -fx-text-fill: #566734;
                           -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-background-radius: 20; -fx-padding: 7 18; -fx-border-width: 0;"/>
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-border-color: rgba(255,255,255,0.5);
                           -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 7 18;"/>
        </HBox>

        <!-- CORPS -->
        <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 12 20 12 20;">

            <!-- 5 CARTES STAT — sans MTBF -->
            <HBox spacing="12" prefHeight="95" maxHeight="95">
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #C8D9A0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10 8;">
                    <Label text="📋" style="-fx-font-size: 20px;"/>
                    <Label text="Total" style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a;"/>
                    <Label fx:id="lblTotalMaintenances" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7A9148;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #C8D9A0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10 8;">
                    <Label text="📅" style="-fx-font-size: 20px;"/>
                    <Label text="Planifiées" style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a;"/>
                    <Label fx:id="lblMaintenancesPlanifiees" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f6a623;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #C8D9A0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10 8;">
                    <Label text="🔧" style="-fx-font-size: 20px;"/>
                    <Label text="En cours" style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a;"/>
                    <Label fx:id="lblMaintenancesEnCours" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7A9148;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #C8D9A0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10 8;">
                    <Label text="✅" style="-fx-font-size: 20px;"/>
                    <Label text="Terminées" style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a;"/>
                    <Label fx:id="lblMaintenancesTerminees" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6ab87a;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fff8f8; -fx-background-radius: 12;
                             -fx-border-color: #f5c6c6; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10 8;">
                    <Label text="⚠️" style="-fx-font-size: 20px;"/>
                    <Label text="En Retard" style="-fx-font-size: 10px; -fx-text-fill: #c0392b;"/>
                    <Label fx:id="lblMaintenancesEnRetard" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                </VBox>
            </HBox>

            <!-- BARRE PROGRESSION -->
            <VBox spacing="5" prefHeight="62" maxHeight="62"
                  style="-fx-background-color: white; -fx-background-radius: 11;
                         -fx-border-color: #C8D9A0; -fx-border-radius: 11; -fx-border-width: 1.5; -fx-padding: 8 16;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📈  Taux de complétion"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #566734;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTauxCompletion" text="0%"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6B7F3F;"/>
                </HBox>
                <ProgressBar fx:id="progressCompletion" progress="0"
                             maxWidth="Infinity" prefHeight="10"
                             style="-fx-accent: #6B7F3F; -fx-background-color: #e8f0d8;
                                    -fx-background-radius: 5; -fx-border-radius: 5;"/>
                <Label fx:id="lblStatutResume" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a;"/>
            </VBox>

            <!-- FILTRES SUR 1 LIGNE -->
            <VBox spacing="6" prefHeight="72" maxHeight="72"
                  style="-fx-background-color: white; -fx-background-radius: 11;
                         -fx-border-color: #C8D9A0; -fx-border-radius: 11; -fx-border-width: 1.5; -fx-padding: 8 16;">
                <Label text="🔍  Filtres avancés"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #566734;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Statut" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <ComboBox fx:id="cmbFiltreStatut" prefWidth="125" prefHeight="28"
                                  style="-fx-background-radius: 6; -fx-border-color: #C8D9A0; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Type" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <ComboBox fx:id="cmbFiltreType" prefWidth="125" prefHeight="28"
                                  style="-fx-background-radius: 6; -fx-border-color: #C8D9A0; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Matériel" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <ComboBox fx:id="cmbFiltreMateriel" prefWidth="140" prefHeight="28"
                                  style="-fx-background-radius: 6; -fx-border-color: #C8D9A0; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Date début" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <DatePicker fx:id="dateDebut" prefWidth="135" prefHeight="28"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Date fin" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <DatePicker fx:id="dateFin" prefWidth="135" prefHeight="28"/>
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Recherche" style="-fx-font-size: 9px; -fx-text-fill: #7a8c6a;"/>
                        <TextField fx:id="txtRecherche" prefHeight="28"
                                   promptText="🔎  Nom, description, type..."
                                   style="-fx-background-radius: 6; -fx-border-color: #C8D9A0; -fx-border-width: 1;"/>
                    </VBox>
                    <Button text="↺" onAction="#handleResetFiltres"
                            style="-fx-background-color: #f0f5e8; -fx-text-fill: #4a6428;
                                   -fx-cursor: hand; -fx-background-radius: 14;
                                   -fx-border-color: #C8D9A0; -fx-border-radius: 14;
                                   -fx-border-width: 1; -fx-font-weight: bold; -fx-font-size: 14px;"
                            prefHeight="28" prefWidth="34"/>
                    <TextField fx:id="txtCoutMin" visible="false" managed="false"/>
                    <TextField fx:id="txtCoutMax" visible="false" managed="false"/>
                </HBox>
            </VBox>

            <!-- TABLEAU -->
            <VBox VBox.vgrow="ALWAYS" spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 11;
                         -fx-border-color: #C8D9A0; -fx-border-radius: 11; -fx-border-width: 1.5;">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #3a5a2a; -fx-background-radius: 10 10 0 0; -fx-padding: 10 18;">
                    <Label text="📋  Liste des maintenances"
                           style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNbResultats" text=""
                           style="-fx-font-size: 10px; -fx-text-fill: #C8D9A0; -fx-font-style: italic;"/>
                    <Label text="  ·  💡 Cliquez sur un en-tête pour trier"
                           style="-fx-font-size: 10px; -fx-text-fill: rgba(200,217,160,0.65); -fx-font-style: italic;"/>
                </HBox>
                <TableView fx:id="tableMaintenances" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-width: 0;"
                           fixedCellSize="36">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId"            text="#"               prefWidth="45"  minWidth="38"  sortable="true"/>
                        <TableColumn fx:id="colMateriel"      text="🚜  Matériel"    prefWidth="170" minWidth="120" sortable="true"/>
                        <TableColumn fx:id="colType"          text="⚙️  Type"         prefWidth="140" minWidth="100" sortable="true"/>
                        <TableColumn fx:id="colStatut"        text="📊  Statut"       prefWidth="140" minWidth="110" sortable="true"/>
                        <TableColumn fx:id="colDatePlanifiee" text="📅  Planifiée"    prefWidth="118" minWidth="100" sortable="true"/>
                        <TableColumn fx:id="colDateRealisee"  text="✅  Réalisée"     prefWidth="118" minWidth="100" sortable="true"/>
                        <TableColumn fx:id="colCout" visible="false" prefWidth="0" minWidth="0" maxWidth="0"/>
                        <TableColumn fx:id="colDescription"   text="📝  Description"  minWidth="160"  sortable="false"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 24;">
                            <Label text="🌿" style="-fx-font-size: 30px;"/>
                            <Label text="Aucune maintenance trouvée"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7a8c6a;"/>
                        </VBox>
                    </placeholder>
                </TableView>
                <HBox alignment="CENTER" spacing="12"
                      style="-fx-padding: 7 18; -fx-background-color: #fafaf6;
                             -fx-background-radius: 0 0 10 10;
                             -fx-border-color: #eef2ee transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;">
                    <Button fx:id="btnPrecedent" text="←  Précédent" onAction="#handlePagePrecedente"
                            style="-fx-background-color: #f0f5e8; -fx-text-fill: #4a6428;
                                   -fx-cursor: hand; -fx-background-radius: 16;
                                   -fx-border-color: #C8D9A0; -fx-border-radius: 16;
                                   -fx-border-width: 1; -fx-font-weight: bold; -fx-padding: 4 14;"
                            prefHeight="26" disable="true"/>
                    <Label fx:id="lblPage" text="Page 1"
                           style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #566734;"/>
                    <Label fx:id="lblTotalPages" text="/ 1  (0 entrées)"
                           style="-fx-font-size: 11px; -fx-text-fill: #7a8c6a;"/>
                    <Button fx:id="btnSuivant" text="Suivant  →" onAction="#handlePageSuivante"
                            style="-fx-background-color: #6B7F3F; -fx-text-fill: white;
                                   -fx-cursor: hand; -fx-background-radius: 16;
                                   -fx-border-width: 0; -fx-font-weight: bold; -fx-padding: 4 14;"
                            prefHeight="26" disable="true"/>
                </HBox>
            </VBox>

            <!-- BOUTONS ACTIONS -->
            <HBox spacing="10" alignment="CENTER_LEFT" prefHeight="48" maxHeight="48"
                  style="-fx-background-color: white; -fx-background-radius: 11;
                         -fx-border-color: #C8D9A0; -fx-border-radius: 11;
                         -fx-border-width: 1.5; -fx-padding: 8 16;">
                <Button fx:id="btnDetails" text="👁️  Détails" onAction="#handleDetails"
                        style="-fx-background-color: #7A9148; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 16; -fx-border-width: 0; -fx-padding: 6 16;"
                        prefHeight="30" disable="true"/>
                <Button fx:id="btnTerminer" text="✅  Marquer terminée" onAction="#handleTerminer"
                        style="-fx-background-color: #6ab87a; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 16; -fx-border-width: 0; -fx-padding: 6 16;"
                        prefHeight="30" disable="true"/>
                <Button fx:id="btnAnnuler" text="🚫  Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #f6a623; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 16; -fx-border-width: 0; -fx-padding: 6 16;"
                        prefHeight="30" disable="true"/>
                <Button fx:id="btnSupprimer" text="🗑️  Supprimer" onAction="#handleSupprimer"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 16; -fx-border-width: 0; -fx-padding: 6 16;"
                        prefHeight="30" disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="← Sélectionnez une ligne pour activer les actions"
                       style="-fx-font-size: 10px; -fx-text-fill: #7a8c6a; -fx-font-style: italic;"/>
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>
