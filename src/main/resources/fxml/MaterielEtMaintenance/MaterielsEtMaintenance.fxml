<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="710.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.MaterielEtMaintenance.MaterielsEtMaintenanceController">
    <children>
        <!-- LAYER 1: BACKGROUND IMAGE -->
        <AnchorPane>
            <children>
                <ImageView fitHeight="710.0" fitWidth="1060.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <image>
                        <Image url="@/img/hero_2.jpg" />
                    </image>
                </ImageView>

                <!-- Dark Gradient Overlay for readability -->
                <Rectangle height="710.0" style="-fx-fill: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);" width="1060.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- LAYER 2: SCROLLABLE CONTENT -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                    <children>
                        <!-- MAIN LANDING SECTION (Full Viewport Height) -->
                        <AnchorPane minHeight="710.0" style="-fx-background-color: transparent;">
                            <children>

                                <!-- Left: Hero Text -->
                                <VBox maxWidth="500.0" spacing="15.0" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="180.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <Rectangle height="25" style="-fx-fill: #6B7F3F; -fx-arc-width: 0; -fx-arc-height: 0;" width="4" />
                                            <Label style="-fx-text-fill: #8BC34A; -fx-font-size: 13px; -fx-font-weight: bold; -fx-letter-spacing: 2px;" text="ARDHI MATÉRIELS &amp; MAINTENANCE" />
                                        </HBox>

                                        <Label fx:id="lblBienvenue" style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);" text="Bienvenue" wrapText="true">
                                            <font><Font name="System Bold" size="42.0" /></font>
                                        </Label>

                                        <Label style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 16px; -fx-line-spacing: 5;" text="Gérez votre parc matériel intelligemment. Ajoutez vos équipements, suivez leur état en temps réel et planifiez vos interventions de maintenance pour optimiser votre productivité." wrapText="true">
                                            <font><Font size="16.0" /></font>
                                        </Label>

                                        <HBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#goToDashboard" style="-fx-background-color: #6B7F3F; -fx-text-fill: white; -fx-background-radius: 30; -fx-cursor: hand; -fx-padding: 12 35; -fx-font-weight: bold; -fx-font-size: 15px;" text="← Accueil">
                                                    <effect><DropShadow color="rgba(107,127,63,0.5)" offsetY="5" radius="15" /></effect>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Right: Services List -->
                                <VBox alignment="TOP_CENTER" maxHeight="450.0" maxWidth="320.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 20;" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="160.0">
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="Services Matériels &amp; Maintenance" />

                                        <VBox spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 0;">
                                            <children>
                                                <!-- Service Item: Matériels -->
                                                <HBox fx:id="materielsCard" alignment="CENTER_LEFT" onMouseClicked="#goToMaterielsFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                    <children>
                                                        <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="🚜" />
                                                        <VBox>
                                                            <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Matériels" />
                                                            <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Gérer votre parc matériel" />
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- Service Item: Maintenance -->
                                                <HBox fx:id="maintenanceCard" alignment="CENTER_LEFT" onMouseClicked="#goToMaintenanceFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                    <children>
                                                        <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="🔧" />
                                                        <VBox>
                                                            <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Maintenance" />
                                                            <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Planifier vos interventions" />
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                            </children>
                        </AnchorPane>

                        <!-- GREEN FOOTER SECTION -->
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #334418; -fx-padding: 40 20; -fx-background-radius: 20 20 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, -5);">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 16px; -fx-font-weight: bold;" text="Restez connecté" />
                                <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 10 0;">
                                    <children>
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="FACEBOOK" />
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="INSTAGRAM" />
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="TWITTER" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="À propos" />
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="Contact" />
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="Confidentialité" />
                                </HBox>

                                <Label style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px; -fx-padding: 20 0 0 0;" text="© 2026 Ardhi. All rights reserved." />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- LAYER 3: FIXED HEADER (Sticky) -->
        <AnchorPane pickOnBounds="false" StackPane.alignment="TOP_CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.6);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <!-- Logo -->
                        <ImageView fitHeight="80.0" fitWidth="70.0" preserveRatio="true">
                            <image>
                                <Image url="/img/ardhi_logo.png" />
                            </image>
                        </ImageView>

                        <Label fx:id="lblRole" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px; -fx-font-weight: bold;" text="Matériels &amp; Maintenance">
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Navigation Menu -->
                        <HBox fx:id="navMenu" alignment="CENTER" spacing="15.0">
                            <children>
                                <Button fx:id="btnNavDiagnostics" mnemonicParsing="false" onAction="#goToDiagnostics"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Diagnostic IA" />
                                <Button fx:id="btnNavMarketplace" mnemonicParsing="false" onAction="#goToMarketplace"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Marketplace" />
                                <Button fx:id="btnNavMaintenance" mnemonicParsing="false" onAction="#goToMaintenance"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Maintenance" />
                                <Button fx:id="btnNavCultures" mnemonicParsing="false" onAction="#goToCultures"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cultures" />
                                <Button fx:id="btnNavEvents" mnemonicParsing="false" onAction="#goToEvents"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Évènements" />
                                <Button fx:id="btnNavEmployees" mnemonicParsing="false" onAction="#goToEmployees"
                                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Employés" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Logout button -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#logout" style="-fx-background-color: rgba(231,76,60,0.8); -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 15; -fx-font-size: 12px;" text="Déconnexion">
                                    <effect><DropShadow color="rgba(0,0,0,0.3)" radius="10" /></effect>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
