<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.marketplace.FarmerStatsController"
            prefHeight="860.0" prefWidth="1300.0"
            style="-fx-background-color: #F4F7F6;">

    <!-- ══════════════ NAVBAR ══════════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                <padding><Insets left="30" right="30"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png"/></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="ARDHI"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;"/>
                        <Label text="MARKETPLACE AGRICOLE"
                               style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
                <Label text="📊  Tableau de Bord — Mes Statistiques"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button onAction="#retour"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8;
                               -fx-font-size: 18px; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;"
                        text="←"/>
            </HBox>

            <!-- Sub-bar -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 42; -fx-min-height: 42;">
                <padding><Insets left="30" right="30"/></padding>
                <Label text="🌿" style="-fx-font-size: 13px;"/>
                <Label fx:id="lblSousTitre"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;"
                       text="Chargement des statistiques..."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Données en temps réel  ✓"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════════ BODY ══════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="24" style="-fx-background-color: #F4F7F6;">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                    <!-- ── LIGNE 1 : 4 CARTES RÉSUMÉ ── -->
                    <HBox spacing="18">

                        <!-- Carte Gains -->
                        <VBox fx:id="carteGains" spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);
                                     -fx-cursor: hand;">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="💰" style="-fx-font-size: 28px;"/>
                                <VBox spacing="3">
                                    <Label text="GAINS TOTAUX"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label fx:id="lblGains"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;"
                                           text="—"/>
                                    <Label text="DT cumulés"
                                           style="-fx-font-size: 10px; -fx-text-fill: #aab8b0;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Produits -->
                        <VBox fx:id="carteProduits" spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);
                                     -fx-cursor: hand;">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="🌾" style="-fx-font-size: 28px;"/>
                                <VBox spacing="3">
                                    <Label text="PRODUITS"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label fx:id="lblProduits"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"
                                           text="—"/>
                                    <Label text="produits listés"
                                           style="-fx-font-size: 10px; -fx-text-fill: #aab8b0;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Note -->
                        <VBox fx:id="carteNote" spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);
                                     -fx-cursor: hand;">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="⭐" style="-fx-font-size: 28px;"/>
                                <VBox spacing="3">
                                    <Label text="NOTE MOYENNE"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label fx:id="lblNote"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"
                                           text="—"/>
                                    <Label text="sur 5 étoiles"
                                           style="-fx-font-size: 10px; -fx-text-fill: #aab8b0;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Commandes -->
                        <VBox fx:id="carteCommandes" spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);
                                     -fx-cursor: hand;">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="📦" style="-fx-font-size: 28px;"/>
                                <VBox spacing="3">
                                    <Label text="COMMANDES"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label fx:id="lblCommandes"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"
                                           text="—"/>
                                    <Label text="commandes reçues"
                                           style="-fx-font-size: 10px; -fx-text-fill: #aab8b0;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                    </HBox>

                    <!-- ── LIGNE 2 : BARCHART + PIECHART ── -->
                    <HBox spacing="18">

                        <!-- BarChart Top Produits -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🏆" style="-fx-font-size: 16px;"/>
                                <VBox spacing="2">
                                    <Label text="TOP 5 PRODUITS"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label text="Par quantité vendue"
                                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"/>
                                </VBox>
                            </HBox>

                            <BarChart fx:id="barChartTop" prefHeight="280" animated="true"
                                      style="-fx-background-color: transparent;">
                                <xAxis>
                                    <CategoryAxis fx:id="barXAxis"
                                                  style="-fx-tick-label-fill: #6a8a78; -fx-font-size: 10px;"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="barYAxis" label="Quantité"
                                                style="-fx-tick-label-fill: #6a8a78; -fx-font-size: 10px;"/>
                                </yAxis>
                            </BarChart>
                        </VBox>

                        <!-- PieChart Répartition Stock -->
                        <VBox spacing="12" prefWidth="380"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🥧" style="-fx-font-size: 16px;"/>
                                <VBox spacing="2">
                                    <Label text="STOCK PAR CATÉGORIE"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                    <Label text="Répartition du stock"
                                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"/>
                                </VBox>
                            </HBox>

                            <PieChart fx:id="pieChartStock" prefHeight="280" animated="true"
                                      labelsVisible="true"
                                      style="-fx-background-color: transparent;"/>
                        </VBox>

                    </HBox>

                    <!-- ── LIGNE 3 : LINECHART TENDANCE ── -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">
                        <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📈" style="-fx-font-size: 16px;"/>
                            <VBox spacing="2">
                                <Label text="TENDANCE DES VENTES"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold;
                                              -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                <Label text="Chiffre d'affaires — 30 derniers jours"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <!-- Sélecteur période -->
                            <HBox spacing="8">
                                <Button fx:id="btn7j" onAction="#charger7j" text="7j"
                                        style="-fx-background-color: #F4F7F6; -fx-text-fill: #6a8a78;
                                               -fx-background-radius: 8; -fx-cursor: hand;
                                               -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Button fx:id="btn30j" onAction="#charger30j" text="30j"
                                        style="-fx-background-color: #4a7c47; -fx-text-fill: white;
                                               -fx-background-radius: 8; -fx-cursor: hand;
                                               -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Button fx:id="btn90j" onAction="#charger90j" text="90j"
                                        style="-fx-background-color: #F4F7F6; -fx-text-fill: #6a8a78;
                                               -fx-background-radius: 8; -fx-cursor: hand;
                                               -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                        </HBox>

                        <LineChart fx:id="lineChartTendance" prefHeight="260" animated="true"
                                   createSymbols="true"
                                   style="-fx-background-color: transparent;">
                            <xAxis>
                                <CategoryAxis fx:id="lineXAxis"
                                              style="-fx-tick-label-fill: #6a8a78; -fx-font-size: 9px;"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="lineYAxis" label="DT"
                                            style="-fx-tick-label-fill: #6a8a78; -fx-font-size: 10px;"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- ── LIGNE 4 : ALERTES STOCK BAS ── -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">
                        <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⚠️" style="-fx-font-size: 16px;"/>
                            <VBox spacing="2">
                                <Label text="ALERTES STOCK"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold;
                                              -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;"/>
                                <Label text="Produits en rupture ou stock critique"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblNbAlertes"
                                   style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                          -fx-font-size: 11px; -fx-font-weight: bold;
                                          -fx-background-radius: 20; -fx-padding: 3 12;"
                                   text="0"/>
                        </HBox>

                        <!-- Liste alertes -->
                        <VBox fx:id="listeAlertes" spacing="8"/>

                        <!-- État vide -->
                        <VBox fx:id="alertesVides" alignment="CENTER" spacing="8"
                              managed="false" visible="false"
                              style="-fx-padding: 20 0;">
                            <Label style="-fx-font-size: 32px;" text="✅"/>
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #6a8a78; -fx-font-weight: bold;"
                                   text="Tous vos stocks sont OK"/>
                        </VBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══════════════ FOOTER ══════════════ -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: #2b5329; -fx-padding: 12 30;">
            <Label text="© 2026 Ardhi — Marketplace Agricole  |  Tous droits réservés"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </HBox>
    </bottom>

</BorderPane>
