<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.neuron.ardhi.controllers.marketplace.AvisProduitController"
           prefHeight="680.0" prefWidth="540.0"
           style="-fx-background-color: linear-gradient(to bottom right, #2b5329, #1a3a25, #2b5329);">

    <!-- Background decorative circles -->
    <StackPane style="-fx-background-color: transparent;">
        <Rectangle width="200" height="200"
                   style="-fx-fill: rgba(107,127,63,0.08); -fx-arc-width: 200; -fx-arc-height: 200;"
                   translateX="-160" translateY="-100"/>
        <Rectangle width="150" height="150"
                   style="-fx-fill: rgba(39,174,96,0.06); -fx-arc-width: 150; -fx-arc-height: 150;"
                   translateX="170" translateY="200"/>
    </StackPane>

    <!-- Main Content -->
    <VBox spacing="0.0" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="24.0"/>
        </padding>

        <!-- ═══ HEADER ═══ -->
        <VBox spacing="4.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 16; -fx-border-color: rgba(107,127,63,0.3); -fx-border-radius: 16; -fx-border-width: 1;">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/>
            </padding>

            <!-- Product name -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="💬" style="-fx-font-size: 22px;"/>
                <Label fx:id="lblTitreProduit" text="Avis sur le produit" textFill="white">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>
            </HBox>

            <!-- Average rating display -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <padding><Insets top="8.0"/></padding>

                <!-- Big score badge -->
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #6B7F3F, #4A5A2B); -fx-background-radius: 12;" minWidth="64" minHeight="64">
                    <VBox alignment="CENTER" spacing="0.0">
                        <Label fx:id="lblScoreNum" text="0.0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <Label text="sur 5" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 10px;"/>
                    </VBox>
                </StackPane>

                <!-- Stars + count -->
                <VBox spacing="4.0">
                    <Label fx:id="lblEtoilesMoyenne" text="☆☆☆☆☆" style="-fx-text-fill: #f1c40f; -fx-font-size: 22px;"/>
                    <Label fx:id="lblNombreAvis" text="0 avis" style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Spacer -->
        <VBox prefHeight="12.0"/>

        <!-- ═══ REVIEWS LIST ═══ -->
        <Label text="Témoignages clients" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px; -fx-font-weight: bold;">
            <VBox.margin><Insets bottom="6.0"/></VBox.margin>
        </Label>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                    hbarPolicy="NEVER">
            <content>
                <VBox fx:id="vboxAvisList" spacing="10.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="6.0" left="2.0" right="6.0" top="2.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Spacer -->
        <VBox prefHeight="12.0"/>

        <!-- ═══ ADD REVIEW FORM ═══ -->
        <VBox spacing="12.0"
              style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(107,127,63,0.35); -fx-border-radius: 16; -fx-border-width: 1;">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="16.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="✏" style="-fx-font-size: 15px;"/>
                <Label text="Donner votre avis" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </HBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

            <!-- Star selector -->
            <VBox spacing="6.0">
                <Label text="Votre note" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
                <HBox alignment="CENTER_LEFT" spacing="4.0">
                    <HBox fx:id="hboxEtoiles" spacing="2.0"/>
                    <Label fx:id="lblNoteSelectionnee" text="— / 5"
                           style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-font-weight: bold;">
                        <HBox.margin><Insets left="8.0"/></HBox.margin>
                    </Label>
                </HBox>
            </VBox>

            <!-- Comment -->
            <VBox spacing="6.0">
                <Label text="Commentaire" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
                <TextArea fx:id="taCommentaire" prefHeight="80.0"
                          promptText="Partagez votre expérience avec ce produit..."
                          wrapText="true"
                          style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 10; -fx-border-color: rgba(107,127,63,0.4); -fx-border-radius: 10; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.35); -fx-control-inner-background: transparent;"/>
            </VBox>

            <!-- Submit button -->
            <Button fx:id="btnPublier" text="🚀  Publier mon avis"
                    mnemonicParsing="false" onAction="#publierAvis"
                    maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #6B7F3F, #4A5A2B); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;">
                <padding><Insets bottom="11.0" left="10.0" right="10.0" top="11.0"/></padding>
            </Button>
        </VBox>
    </VBox>
</StackPane>
