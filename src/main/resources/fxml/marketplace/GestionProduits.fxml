<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Layout : StackPane racine
    ├── BorderPane  (navbar + grille produits + footer)
    └── VBox fx:id="drawerOverlay"  (overlay sombre semi-transparent)
        └── VBox fx:id="drawerPanel"  (formulaire, slide depuis le bas)
-->
<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.neuron.ardhi.controllers.marketplace.GestionProduitsController"
           prefHeight="860.0" prefWidth="1300.0">

    <!-- ═══════════════════ PAGE PRINCIPALE ═══════════════════ -->
    <BorderPane style="-fx-background-color: #F4F7F6;">

        <!-- ── NAVBAR ── -->
        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                    <padding><Insets left="30" right="30" /></padding>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                            <image><Image url="@../../img/ardhi_logo.png" /></image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT" spacing="0">
                            <Label text="ARDHI"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;" />
                            <Label text="MARKETPLACE AGRICOLE"
                                   style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;" />
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="🛒  Gestion des Produits"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" />
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Bouton Ajouter dans la navbar -->
                    <Button onAction="#ouvrirDrawerAjout"
                            style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 9 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);"
                            text="✚  Ajouter un produit">
                        <HBox.margin><Insets right="12" /></HBox.margin>
                    </Button>

                    <Button onAction="#retour"
                            style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 18px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;"
                            text="←" />
                </HBox>

                <!-- Sub-bar -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #2b5329; -fx-pref-height: 42; -fx-min-height: 42;">
                    <padding><Insets left="30" right="30" /></padding>
                    <Label text="🌿" style="-fx-font-size: 13px;" />
                    <Label fx:id="lblTitreFormulaire"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;"
                           text="Cliquez sur un produit pour le modifier" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Produits agricoles certifiés  ✓"
                           style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;" />
                </HBox>
            </VBox>
        </top>

        <!-- ── BODY : grille pleine largeur ── -->
        <center>
            <VBox fx:id="mainContainer" spacing="0" style="-fx-background-color: #F4F7F6;"
                  onMouseClicked="#clicDehors">
                <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>

                <!-- Filtres -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(13,31,21,0.06), 12, 0, 0, 3);">
                    <VBox.margin><Insets bottom="20" /></VBox.margin>

                    <HBox style="-fx-background-color: #f5f8f5; -fx-background-radius: 14 14 0 0; -fx-padding: 12 16;">
                        <Label text="🔍  Recherche &amp; Filtres"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#resetFiltre"
                                style="-fx-background-color: transparent; -fx-text-fill: #4a7c47; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-width: 0; -fx-underline: true;"
                                text="Réinitialiser" />
                    </HBox>

                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 14 16 14 16;">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="ID" style="-fx-font-size: 9px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                            <TextField fx:id="tfFiltreId" prefWidth="80" promptText="Ex: 12"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 12px;" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="NOM" style="-fx-font-size: 9px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                            <TextField fx:id="tfFiltreNom" promptText="Nom du produit…"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 12px;" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="CATÉGORIE" style="-fx-font-size: 9px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                            <TextField fx:id="tfFiltreCategorie" promptText="Catégorie…"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 12px;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Grille produits pleine largeur -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="produitsContainer" hgap="18" vgap="18"
                                  style="-fx-background-color: transparent; -fx-padding: 4;" />
                    </content>
                </ScrollPane>
            </VBox>
        </center>

        <!-- ── FOOTER ── -->
        <bottom>
            <HBox alignment="CENTER" style="-fx-background-color: #2b5329; -fx-padding: 12 30;">
                <Label text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés"
                       style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);" />
            </HBox>
        </bottom>
    </BorderPane>

    <!-- ═══════════════════ DRAWER OVERLAY ═══════════════════
         Masqué par défaut — visible/managed géré par le controller
    ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="drawerOverlay"
          visible="false" managed="false"
          style="-fx-background-color: rgba(0,0,0,0.45);"
          onMouseClicked="#fermerDrawerSiOverlay"
          alignment="BOTTOM_CENTER">

        <!-- ── DRAWER PANEL ── -->
        <VBox fx:id="drawerPanel"
              style="-fx-background-color: white; -fx-background-radius: 24 24 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.30), 40, 0, 0, -10);"
              prefHeight="500" maxHeight="520">

            <!-- Drag handle + titre -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 14 0 10 0;">
                <!-- Handle pill -->
                <Region prefWidth="48" prefHeight="5"
                        style="-fx-background-color: #d0dbd2; -fx-background-radius: 10;" />

                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 28;">
                    <FontIcon iconLiteral="mdi-package-variant"
                              iconSize="20"
                              style="-fx-icon-color: #4a7c47;" />                    <Label fx:id="lblTitreFormulaire"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#fermerDrawer"
                            style="-fx-background-color: #F4F7F6; -fx-text-fill: #6a8a78; -fx-font-size: 14px; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-width: 0; -fx-pref-width: 32; -fx-pref-height: 32;"
                            text="✕" />
                </HBox>

                <Separator style="-fx-background-color: #eef2ef; -fx-padding: 0 28;" />
            </VBox>

            <!-- ── Contenu scrollable en 2 colonnes ── -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <HBox spacing="28" style="-fx-padding: 10 28 20 28;">

                        <!-- Colonne gauche -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS">

                            <!-- Nom -->
                            <VBox spacing="5">
                                <Label text="NOM DU PRODUIT  *"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <TextField fx:id="tfNom" promptText="Ex: Engrais organique"
                                           style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px; -fx-padding: 8 12;" />
                            </VBox>

                            <!-- Description -->
                            <VBox spacing="5">
                                <Label text="DESCRIPTION"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <TextArea fx:id="taDescription" prefRowCount="3" wrapText="true"
                                          promptText="Description détaillée…"
                                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 12px;" />
                            </VBox>

                            <!-- Prix + Stock -->
                            <HBox spacing="12">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="PRIX (DT)  *"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                    <TextField fx:id="tfPrix" promptText="29.99"
                                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px; -fx-padding: 8 12;" />
                                    <Label text="💡 En Dinar Tunisien (DT)"
                                           style="-fx-font-size: 9px; -fx-text-fill: #aab8b0;" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="STOCK  *"
                                           style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                    <TextField fx:id="tfStock" promptText="100"
                                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px; -fx-padding: 8 12;" />
                                </VBox>
                            </HBox>

                            <!-- Unité -->
                            <VBox spacing="5">
                                <Label text="UNITÉ DE MESURE  *"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <ComboBox fx:id="cbUniteMesure" maxWidth="1.7976931348623157E308"
                                          promptText="Sélectionner l'unité"
                                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px;" />
                            </VBox>

                        </VBox>

                        <!-- Colonne droite -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS">

                            <!-- Catégorie -->
                            <VBox spacing="5">
                                <Label text="CATÉGORIE  *"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <ComboBox fx:id="cbCategorie" maxWidth="1.7976931348623157E308"
                                          promptText="Sélectionner une catégorie"
                                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px;" />
                            </VBox>

                            <!-- Remise -->
                            <VBox spacing="5">
                                <Label text="REMISE / SOLDE"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <HBox spacing="10">
                                    <ComboBox fx:id="cbTypeRemise" maxWidth="1.7976931348623157E308"
                                              promptText="Aucune remise"
                                              style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 12px;"
                                              HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="tfRemise" prefWidth="80" promptText="Ex: 20"
                                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff; -fx-font-size: 13px; -fx-padding: 8 10;" />
                                </HBox>
                                <Label fx:id="lblRemiseHint" text=""
                                       style="-fx-font-size: 10px; -fx-text-fill: #e67e22;" />
                            </VBox>

                            <!-- Image -->
                            <VBox spacing="8" alignment="CENTER">
                                <Label text="IMAGE DU PRODUIT"
                                       style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <StackPane style="-fx-background-color: #f5f8f5; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-pref-height: 110; -fx-min-height: 110;">
                                    <ImageView fx:id="ivProduit" fitHeight="100" fitWidth="260"
                                               preserveRatio="true" pickOnBounds="true" />
                                </StackPane>
                                <Button onAction="#importerImage"
                                        style="-fx-background-color: #F4F7F6; -fx-text-fill: #4a7c47; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #b8dfc8; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 7 16;"
                                        text="📷  Choisir une image" />
                            </VBox>

                            <!-- Boutons action -->
                            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                <Button fx:id="btnAjouter" maxWidth="1.7976931348623157E308" onAction="#ajouter"
                                        style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 11 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 3);"
                                        text="✚   Ajouter le produit" />

                                <HBox spacing="8">
                                    <Button fx:id="btnModifier" maxWidth="1.7976931348623157E308" onAction="#modifier"
                                            visible="false"
                                            style="-fx-background-color: #1a5faa; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 10 0;"
                                            text="✎  Modifier" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnSupprimer" maxWidth="1.7976931348623157E280" onAction="#supprimer"
                                            visible="false"
                                            style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 10 0;"
                                            text="🗑  Supprimer" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <Button maxWidth="1.7976931348623157E308" onAction="#vider"
                                        style="-fx-background-color: #F4F7F6; -fx-text-fill: #6a8a78; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 8 0;"
                                        text="Vider le formulaire" />
                            </VBox>

                        </VBox>
                    </HBox>
                </content>
            </ScrollPane>

        </VBox>
    </VBox>

</StackPane>
