<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="710.0" prefWidth="1060.0"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.neuron.ardhi.controllers.marketplace.NotificationMarketController">
    <children>

        <!-- LAYER 1: BACKGROUND -->
        <AnchorPane>
            <children>
                <Rectangle height="710.0" width="1060.0"
                           style="-fx-fill: linear-gradient(to bottom right, #0d1a0f 0%, #1a2e1c 50%, #0d1a0f 100%);"
                           AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                           AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                <!-- Decorative circles -->
                <Rectangle height="400.0" width="400.0" arcWidth="400" arcHeight="400"
                           style="-fx-fill: radial-gradient(center 50% 50%, radius 50%, rgba(139,195,74,0.06), transparent);"
                           AnchorPane.leftAnchor="-100.0" AnchorPane.topAnchor="-100.0"/>
                <Rectangle height="300.0" width="300.0" arcWidth="300" arcHeight="300"
                           style="-fx-fill: radial-gradient(center 50% 50%, radius 50%, rgba(139,195,74,0.04), transparent);"
                           AnchorPane.rightAnchor="-50.0" AnchorPane.bottomAnchor="50.0"/>
            </children>
        </AnchorPane>

        <!-- LAYER 2: CONTENT -->
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20.0"
                  style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.6);">
                <children>
                    <ImageView fitHeight="80.0" fitWidth="70.0" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png"/></image>
                    </ImageView>
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px; -fx-font-weight: bold;"
                           text="Marketplace · Notifications">
                        <HBox.margin><Insets left="10.0"/></HBox.margin>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#retourMarketplace"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8);
                                   -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 18;
                                   -fx-font-size: 12px; -fx-font-weight: bold;"
                            text="← Retour"/>
                    <Button mnemonicParsing="false" onAction="#marquerToutesLues"
                            style="-fx-background-color: rgba(139,195,74,0.2); -fx-text-fill: #8BC34A;
                                   -fx-border-color: rgba(139,195,74,0.4); -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 18;
                                   -fx-font-size: 12px; -fx-font-weight: bold;"
                            text="✓ Tout marquer comme lu"/>
                </children>
            </HBox>

            <!-- BODY -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="0.0" style="-fx-padding: 40 120;">

                        <!-- Titre + compteur -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 0 0 30 0;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"
                                   text="🔔 Mes Notifications"/>
                            <Label fx:id="lblCompteurNonLues"
                                   style="-fx-background-color: #8BC34A; -fx-text-fill: white;
                                          -fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-background-radius: 20; -fx-padding: 3 12;"
                                   text="0 non lues"/>
                        </HBox>

                        <!-- Filtres -->
                        <HBox spacing="10.0" style="-fx-padding: 0 0 24 0;">
                            <Button fx:id="btnFiltreAll" mnemonicParsing="false" onAction="#filtrerToutes"
                                    style="-fx-background-color: #8BC34A; -fx-text-fill: white;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 6 18; -fx-font-size: 12px; -fx-font-weight: bold;"
                                    text="Toutes"/>
                            <Button fx:id="btnFiltreAchat" mnemonicParsing="false" onAction="#filtrerAchats"
                                    style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: rgba(255,255,255,0.7);
                                           -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.15);
                                           -fx-border-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 6 18; -fx-font-size: 12px;"
                                    text="🛒 Achats"/>
                            <Button fx:id="btnFiltreAvis" mnemonicParsing="false" onAction="#filtrerAvis"
                                    style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: rgba(255,255,255,0.7);
                                           -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.15);
                                           -fx-border-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 6 18; -fx-font-size: 12px;"
                                    text="⭐ Avis"/>
                        </HBox>

                        <!-- Liste des notifications -->
                        <VBox fx:id="listeNotifications" spacing="12.0"/>

                        <!-- État vide -->
                        <VBox fx:id="etatVide" alignment="CENTER" spacing="16.0"
                              managed="false" visible="false"
                              style="-fx-padding: 80 0;">
                            <Label style="-fx-font-size: 56px;" text="🔕"/>
                            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                                   text="Aucune notification"/>
                            <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 14px;"
                                   text="Vous serez notifié dès qu'une commande ou un avis arrive."/>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

    </children>
</StackPane>
