<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="860.0" prefWidth="1200.0"
            style="-fx-background-color: #F4F7F6;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.marketplace.CommandesController">

    <!-- ═══════════════════════ NAVBAR ═══════════════════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                <padding><Insets left="30" right="30" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="ARDHI"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;" />
                        <Label text="MARKETPLACE AGRICOLE"
                               style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblTitre"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;"
                       text="Mes Commandes" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#rafraichir"
                        style="-fx-background-color: #436d41; -fx-text-fill: #7fffc0; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;"
                        text="🔄  Actualiser">
                    <HBox.margin><Insets right="12" /></HBox.margin>
                </Button>

                <Button onAction="#retour"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 18px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;"
                        text="←" />
            </HBox>

            <!-- Stats bar -->
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-border-color: #1a3525; -fx-border-width: 1 0 0 0; -fx-pref-height: 56;">
                <padding><Insets left="30" right="30" /></padding>

                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #436d41; -fx-background-radius: 12; -fx-padding: 8 20 8 20; -fx-border-color: #5c835a; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="📦" style="-fx-font-size: 16px;" />
                    <VBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="COMMANDES" style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                        <Label fx:id="lblTotalCommandes" text="0"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>
                </HBox>

                <HBox style="-fx-padding: 0 20;" alignment="CENTER">
                    <Label text="·" style="-fx-text-fill: #5c835a; -fx-font-size: 20px;" />
                </HBox>

                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #436d41; -fx-background-radius: 12; -fx-padding: 8 20 8 20; -fx-border-color: #5c835a; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="💰" style="-fx-font-size: 16px;" />
                    <VBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="TOTAL DÉPENSÉ" style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                        <Label fx:id="lblTotalDepenses" text="0.00 DT"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />
                <Label text="Produits agricoles certifiés  ✓"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;" />
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════ BODY ═══════════════════════ -->
    <center>
        <HBox spacing="0" style="-fx-background-color: #F4F7F6;">

            <!-- ════════ SIDEBAR FILTRES ════════ -->
            <ScrollPane prefWidth="280" minWidth="280" maxWidth="280"
                        fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: white; -fx-background: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
                <content>
                    <VBox spacing="0" style="-fx-background-color: white;">
                        <padding><Insets top="24" right="20" bottom="24" left="20" /></padding>

                        <!-- Titre Filtres -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                            <Label text="🔍" style="-fx-font-size: 16px;" />
                            <Label text="Filtres"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                        </HBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                        </Separator>

                        <!-- Recherche par ID -->
                        <Label text="RECHERCHE PAR ID"
                               style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;">
                            <VBox.margin><Insets bottom="6" /></VBox.margin>
                        </Label>
                        <TextField fx:id="txtRechercheId"
                                   promptText="Ex: 42"
                                   style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 9 12; -fx-font-size: 12px; -fx-text-fill: #2b5329;">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                        </TextField>

                        <!-- Filtre Statut -->
                        <Label text="STATUT"
                               style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;">
                            <VBox.margin><Insets bottom="6" /></VBox.margin>
                        </Label>
                        <ComboBox fx:id="comboFiltreStatut" maxWidth="Infinity"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-font-size: 12px;">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                        </ComboBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                        </Separator>

                        <!-- Fourchette de prix -->
                        <Label text="MONTANT TOTAL (DT)"
                               style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;">
                            <VBox.margin><Insets bottom="10" /></VBox.margin>
                        </Label>

                        <!-- Affichage min/max -->
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <VBox.margin><Insets bottom="8" /></VBox.margin>
                            <Label fx:id="lblMinPrix" text="0 DT"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblMaxPrix" text="9999 DT"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;" />
                        </HBox>

                        <!-- Slider Min -->
                        <Label text="Min"
                               style="-fx-font-size: 9px; -fx-text-fill: #6b7280;">
                            <VBox.margin><Insets bottom="2" /></VBox.margin>
                        </Label>
                        <Slider fx:id="sliderMinPrix" min="0" max="9999" value="0"
                                showTickMarks="false" showTickLabels="false"
                                style="-fx-accent: #4a7c47;">
                            <VBox.margin><Insets bottom="8" /></VBox.margin>
                        </Slider>

                        <!-- Slider Max -->
                        <Label text="Max"
                               style="-fx-font-size: 9px; -fx-text-fill: #6b7280;">
                            <VBox.margin><Insets bottom="2" /></VBox.margin>
                        </Label>
                        <Slider fx:id="sliderMaxPrix" min="0" max="9999" value="9999"
                                showTickMarks="false" showTickLabels="false"
                                style="-fx-accent: #4a7c47;">
                            <VBox.margin><Insets bottom="24" /></VBox.margin>
                        </Slider>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="20" /></VBox.margin>
                        </Separator>

                        <!-- Bouton Réinitialiser -->
                        <Button text="✕  Réinitialiser les filtres"
                                onAction="#resetFiltre" maxWidth="Infinity"
                                style="-fx-background-color: #F4F7F6; -fx-text-fill: #6a8a78; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 10 0;" />
                    </VBox>
                </content>
            </ScrollPane>

            <!-- ════════ ZONE CONTENU ════════ -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="0" style="-fx-background-color: #F4F7F6;">
                        <padding><Insets top="32" right="40" bottom="48" left="40" /></padding>

                        <!-- Section title -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox.margin><Insets bottom="28" /></VBox.margin>
                            <Label text="📋" style="-fx-font-size: 22px;" />
                            <Label text="Historique de mes commandes"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                        </HBox>

                        <!-- Cards container -->
                        <FlowPane fx:id="commandesContainer" hgap="22" vgap="22"
                                  style="-fx-background-color: transparent;" />

                        <!-- Empty state -->
                        <VBox fx:id="emptyState" alignment="CENTER" spacing="14"
                              visible="false" managed="false"
                              style="-fx-padding: 80 0;">
                            <Label text="🌾" style="-fx-font-size: 56px;" />
                            <Label text="Aucune commande pour le moment"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
                            <Label text="Vos achats apparaîtront ici après votre première commande."
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Button onAction="#retour"
                                    style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 10 24;"
                                    text="🛒  Découvrir le marketplace" />
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>

        </HBox>
    </center>

    <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2b5329; -fx-padding: 12 30;">
            <Label text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);" />
        </HBox>
    </bottom>

</BorderPane>
