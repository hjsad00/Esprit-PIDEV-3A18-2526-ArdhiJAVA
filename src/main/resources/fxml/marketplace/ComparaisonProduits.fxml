<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="860.0" prefWidth="1200.0"
            style="-fx-background-color: #F4F7F6;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.marketplace.ComparaisonProduitsController">

    <!-- ═══════════════════ NAVBAR ═══════════════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                <padding><Insets left="30" right="30" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="ARDHI"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;" />
                        <Label text="MARKETPLACE AGRICOLE"
                               style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Titre centré -->
                <HBox alignment="CENTER" spacing="10">
                    <Label text="⚖️" style="-fx-font-size: 20px;" />
                    <Label text="Comparaison de produits"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Bouton retour -->
                <Button fx:id="btnRetour" onAction="#retourCatalogue"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 18;"
                        text="←  Retour au catalogue" />
            </HBox>

            <!-- Sub-bar info -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #ffffff; -fx-pref-height: 40;">
                <padding><Insets left="30" right="30" /></padding>
                <Label text="⚖️" style="-fx-font-size: 12px;" />
                <Label fx:id="lblNbProduits"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;"
                       text="2 produits en comparaison" />

            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════ BODY ═══════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="0" style="-fx-background-color: #F4F7F6;">
                    <padding><Insets top="32" right="48" bottom="48" left="48" /></padding>

                    <!-- ══════ TABLEAU COMPLET ══════ -->
                    <HBox spacing="0" alignment="CENTER">

                        <!-- Colonne libellés -->
                        <VBox fx:id="colonneLibelles" prefWidth="200" minWidth="200"
                              style="-fx-background-color: white;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1 0 1 1;
                                 -fx-background-radius: 20 0 0 20; -fx-border-radius: 20 0 0 20;">
                            <!-- Header vide aligné avec les headers produits -->
                            <VBox prefHeight="260" minHeight="260"
                                  style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" />
                            <!-- Lignes libellés injectées dynamiquement -->
                        </VBox>

                        <!-- Colonne Produit 1 -->
                        <VBox fx:id="colonneProduit1" prefWidth="340" minWidth="340"
                              style="-fx-background-color: white;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1 0 1 1;">
                            <!-- Header produit 1 injecté dynamiquement -->
                            <VBox fx:id="colProduit1Header" prefHeight="260" minHeight="260"
                                  alignment="CENTER" spacing="12"
                                  style="-fx-padding: 24 20 20 20;
                                     -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" />
                            <!-- Lignes valeurs injectées dynamiquement -->
                        </VBox>

                        <!-- Colonne Produit 2 -->
                        <VBox fx:id="colonneProduit2" prefWidth="340" minWidth="340"
                              style="-fx-background-color: white;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1 1 1 1;
                                 -fx-background-radius: 0 20 20 0; -fx-border-radius: 0 20 20 0;">
                            <!-- Header produit 2 injecté dynamiquement -->
                            <VBox fx:id="colProduit2Header" prefHeight="260" minHeight="260"
                                  alignment="CENTER" spacing="12"
                                  style="-fx-padding: 24 20 20 20;
                                     -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" />
                            <!-- Lignes valeurs injectées dynamiquement -->
                        </VBox>

                    </HBox>

                    <!-- ══════ BOUTONS PANIER ══════ -->
                    <HBox alignment="CENTER" spacing="0">
                        <VBox.margin><Insets top="24" /></VBox.margin>

                        <VBox prefWidth="200" minWidth="200" />

                        <VBox fx:id="colProduit1Actions"
                              prefWidth="340" minWidth="340" alignment="CENTER" spacing="10"
                              style="-fx-padding: 0 20 0 20;" />

                        <VBox fx:id="colProduit2Actions"
                              prefWidth="340" minWidth="340" alignment="CENTER" spacing="10"
                              style="-fx-padding: 0 20 0 20;" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
    <!-- ═══════════════════ FOOTER ═══════════════════ -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2b5329; -fx-padding: 12 30;">
            <Label text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);" />
        </HBox>
    </bottom>

</BorderPane>
