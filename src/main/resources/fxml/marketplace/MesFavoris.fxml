<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="860.0" prefWidth="1280.0"
            style="-fx-background-color: #F4F7F6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.marketplace.MesFavorisController">

    <!-- ══════════════════════════════════════════════════
         TOP NAVBAR
    ══════════════════════════════════════════════════ -->
    <top>
        <VBox>
            <!-- Main Navbar -->
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                <padding><Insets bottom="0" left="30" right="30" top="0" /></padding>

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="38" fitWidth="38" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;"
                               text="ARDHI" />
                        <Label style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;"
                               text="MARKETPLACE AGRICOLE" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Title -->
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="❤️  Mes Favoris" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge nb favoris -->
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: #436d41; -fx-background-radius: 20; -fx-padding: 6 16 6 12; -fx-border-color: #e74c3c; -fx-border-radius: 20; -fx-border-width: 1.5;">
                    <HBox.margin><Insets right="14"/></HBox.margin>
                    <Label style="-fx-font-size: 15px;" text="❤️" />
                    <Label fx:id="lblNbFavoris"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"
                           text="0 favori(s)" />
                </HBox>

                <!-- Back button -->
                <Button onAction="#retour" prefHeight="42" prefWidth="71.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 18px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;"
                        text="←">
                    <HBox.margin><Insets left="10" /></HBox.margin>
                </Button>
            </HBox>

            <!-- Sub-bar -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #ffffff; -fx-pref-height: 42; -fx-min-height: 42;">
                <padding><Insets left="30" right="30" /></padding>
                <Label style="-fx-font-size: 13px;" text="❤️" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                       text="Produits sauvegardés" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;"
                       text="Cliquer sur ❤ pour retirer un favori" />
            </HBox>
        </VBox>
    </top>

    <!-- ══════════════════════════════════════════════════
         BODY
    ══════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">
            <content>
                <StackPane>
                    <!-- Empty state (affiché si aucun favori) -->
                    <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="18"
                          style="-fx-background-color: #F4F7F6;"
                          visible="false" managed="false">
                        <padding><Insets top="100" /></padding>
                        <Label style="-fx-font-size: 64px;" text="❤️" />
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d4a36;"
                               text="Aucun produit en favori" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-text-alignment: center;"
                               text="Parcourez le catalogue et cliquez sur ♡ pour sauvegarder vos produits préférés."
                               wrapText="true" />
                        <Button onAction="#allerAuCatalogue" prefHeight="44" prefWidth="220"
                                style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;"
                                text="🛒  Aller au catalogue" />
                    </VBox>

                    <!-- Grille des favoris -->
                    <GridPane fx:id="favorisGrid" hgap="22"
                              style="-fx-background-color: #F4F7F6;" vgap="22">
                        <padding><Insets bottom="28" left="28" right="28" top="28" /></padding>
                    </GridPane>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <!-- ══════════════════════════════════════════════════
         FOOTER
    ══════════════════════════════════════════════════ -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #2b5329;">
            <padding><Insets bottom="12" left="30" right="30" top="12" /></padding>
            <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.40);"
                   text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés" />
        </HBox>
    </bottom>

</BorderPane>
