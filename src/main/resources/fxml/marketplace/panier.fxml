<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.neuron.ardhi.controllers.marketplace.PanierController"
      prefHeight="800.0" prefWidth="1200.0"
      style="-fx-background-color: #F4F7F6; -fx-padding: 30;" spacing="0">

    <!-- Main Container -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
        
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #2b5329; -fx-background-radius: 12 12 0 0; -fx-padding: 15 25;">
            <Label text="🛒 Récapitulatif de commande" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" style="-fx-background-color: #436d41; -fx-background-radius: 20; -fx-padding: 5 15; -fx-border-color: #5c835a; -fx-border-radius: 20;">
                <Label fx:id="lblTotalProduitsHeader" text="Articles" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
            </HBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding: 25;" VBox.vgrow="ALWAYS">
            <!-- TableView -->
            <TableView fx:id="tablePanier" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: transparent; -fx-selection-bar: #f0fdf4; -fx-selection-bar-non-focused: transparent;">
                <columns>
                    <TableColumn fx:id="colNom" text="PRODUIT" prefWidth="300.0" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colPrix" text="PRIX UNITAIRE" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                    <TableColumn fx:id="colQuantite" text="QUANTITÉ" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    <TableColumn fx:id="colSousTotal" text="SOUS-TOTAL" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                    <TableColumn fx:id="colActions" text="" prefWidth="100.0" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Bottom Cards Row -->
            <HBox spacing="15" alignment="TOP_CENTER">
                
                <!-- Card 1: Code Promo -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS" prefWidth="220" maxWidth="300">
                    <Label text="🏷️ CODE PROMO" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                    <HBox spacing="10">
                        <TextField fx:id="tfCodeCoupon" promptText="Entrez votre code..." style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAppliquerCoupon" text="Appliquer" onAction="#appliquerCoupon" style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
                    </HBox>
                    <Label fx:id="lblMessageCoupon" text="" style="-fx-font-size: 11px;"/>
                </VBox>

                <!-- Card 2: Livraison -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS" prefWidth="250" maxWidth="300">
                    <Label text="🚚 LIVRAISON" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                    <VBox spacing="8">
                        <RadioButton fx:id="rbRecuperation" text="Récupération sur place&#10;Gratuit — 0 DT" onAction="#onModeLivraisonChange" selected="true" style="-fx-border-color: #4a7c47; -fx-border-radius: 6; -fx-background-color: #f0fdf4; -fx-background-radius: 6; -fx-padding: 10; -fx-text-fill: #166534; -fx-font-size: 12px; -fx-font-weight: bold;" maxWidth="10000"/>
                        <RadioButton fx:id="rbLivraison" text="Livraison à domicile&#10;)" onAction="#onModeLivraisonChange" style="-fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-color: white; -fx-background-radius: 6; -fx-padding: 10; -fx-text-fill: #6b7280; -fx-font-size: 12px;" maxWidth="10000"/>
                        <Label fx:id="lblInfoLivraison" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                    </VBox>
                </VBox>

                <!-- Card 3: Paiement -->
                <VBox fx:id="boxPaiementPoints" spacing="10" style="-fx-background-color: #fffbeb; -fx-border-color: #fde68a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS" prefWidth="250" maxWidth="300">
                    <Label text="💳 PAIEMENT" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                    <VBox spacing="8">
                        <RadioButton fx:id="rbCarte" text="Payer par Carte&#10;Visa, Mastercard — via Stripe" selected="true" style="-fx-border-color: #f59e0b; -fx-border-radius: 6; -fx-background-color: white; -fx-background-radius: 6; -fx-padding: 10; -fx-text-fill: #92400e; -fx-font-size: 12px; -fx-font-weight: bold;" maxWidth="10000"/>
                        <RadioButton fx:id="rbPoints" text="Points de Fidélité" style="-fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-color: white; -fx-background-radius: 6; -fx-padding: 10; -fx-text-fill: #6b7280; -fx-font-size: 12px;" maxWidth="10000"/>
                        <Label fx:id="lblSoldePoints" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                    </VBox>
                </VBox>

                <!-- Card 4: Summary -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="250" maxWidth="300">
                    <VBox spacing="15" style="-fx-background-color: #2b5329; -fx-background-radius: 8; -fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="📦 Articles" style="-fx-text-fill: #a7f3d0; -fx-font-size: 13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalProduits" text="0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </HBox>
                        <HBox fx:id="boxReduction" alignment="CENTER_LEFT" managed="false" visible="false">
                            <Label text="Réduction" style="-fx-text-fill: #fca5a5; -fx-font-size: 13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblReduction" text="-0.00 DT" style="-fx-text-fill: #fca5a5; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </HBox>
                        <HBox fx:id="boxFraisLivraison" alignment="CENTER_LEFT" managed="false" visible="false">
                            <Label text="Livraison" style="-fx-text-fill: #a7f3d0; -fx-font-size: 13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblFraisLivraison" text="+0.00 DT" style="-fx-text-fill: #a7f3d0; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </HBox>
                        
                        <Separator style="-fx-background-color: #436d41; -fx-opacity: 0.5;"/>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalMontant" text="0.00 DT" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                        </HBox>
                        
                        <Button fx:id="btnValiderCommande" text="🛡️ Confirmer la commande" onAction="#validerCommande" style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12; -fx-cursor: hand;" maxWidth="10000"/>
                    </VBox>
                    <Button fx:id="btnViderPanier" text="🗑️ Vider le panier" onAction="#viderPanier" style="-fx-background-color: white; -fx-text-fill: #ef4444; -fx-border-color: #fca5a5; -fx-border-radius: 6; -fx-padding: 10; -fx-cursor: hand;" maxWidth="10000"/>
                    <Button fx:id="btnContinuerAchats" text="← Continuer mes achats" onAction="#continuerAchats" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 5;" maxWidth="10000"/>
                </VBox>

            </HBox>
        </VBox>
    </VBox>
</VBox>
