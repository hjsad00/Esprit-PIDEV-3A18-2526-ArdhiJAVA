<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="710.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.marketplace.MarketplaceController">
    <children>
        <!-- LAYER 1: BACKGROUND SLIDESHOW -->
        <AnchorPane>
            <children>
                <ImageView fx:id="heroBackground" fitHeight="710.0" fitWidth="1060.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <image>
                        <Image url="@../../img/marketplace_bg.jpg" />
                    </image>
                </ImageView>
                <ImageView fx:id="heroBackgroundOverlay" fitHeight="710.0" fitWidth="1060.0" opacity="0.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

                <!-- Dark Gradient Overlay for readability -->
                <Rectangle height="710.0" style="-fx-fill: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);" width="1060.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- LAYER 2: SCROLLABLE CONTENT -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                    <children>
                        <!-- MAIN LANDING SECTION (Full Viewport Height) -->
                        <AnchorPane minHeight="710.0" style="-fx-background-color: transparent;">
                            <children>

                                <!-- Left: Hero Text -->
                                <VBox maxWidth="500.0" spacing="15.0" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="180.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <Rectangle height="25" style="-fx-fill: #6B7F3F; -fx-arc-width: 0; -fx-arc-height: 0;" width="4" />
                                            <Label style="-fx-text-fill: #8BC34A; -fx-font-size: 13px; -fx-font-weight: bold; -fx-letter-spacing: 2px;" text="ARDHI MARKETPLACE" />
                                        </HBox>

                                        <Label fx:id="lblBienvenue" style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);" text="Bienvenue sur le Marketplace" wrapText="true">
                                            <font><Font name="System Bold" size="42.0" /></font>
                                        </Label>

                                        <Label fx:id="heroDescription" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 16px; -fx-line-spacing: 5;" text="Achetez et vendez vos produits agricoles en toute confiance. Gérez vos commandes et suivez vos ventes depuis un seul endroit." wrapText="true">
                                            <font><Font size="16.0" /></font>
                                        </Label>

                                        <!-- Pagination Dots -->
                                        <HBox fx:id="paginationContainer" alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 10 0;">
                                        </HBox>

                                        <HBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#goToCatalogueFromCard" style="-fx-background-color: #6B7F3F; -fx-text-fill: white; -fx-background-radius: 30; -fx-cursor: hand; -fx-padding: 12 35; -fx-font-weight: bold; -fx-font-size: 15px;" text="Explorer le catalogue">
                                                    <effect><DropShadow color="rgba(107,127,63,0.5)" offsetY="5" radius="15" /></effect>
                                                </Button>
                                                <Button mnemonicParsing="false" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.7); -fx-border-radius: 30; -fx-cursor: hand; -fx-padding: 12 35; -fx-font-size: 15px;" text="← Accueil" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Right: Marketplace Services List -->
                                <VBox alignment="TOP_CENTER" maxHeight="450.0" maxWidth="320.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 20;" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="160.0">
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="Services Marketplace" />

                                        <ScrollPane fx:id="servicesScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED">
                                            <content>
                                                <VBox spacing="12.0" style="-fx-background-color: transparent; -fx-padding: 0 15 0 0;">
                                                    <children>
                                                        <!-- Service Item: Catalogue -->
                                                        <HBox alignment="CENTER_LEFT" onMouseClicked="#goToCatalogueFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="🛒" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Catalogue" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Parcourir les produits" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                        <!-- Service Item: Mes Commandes -->
                                                        <HBox alignment="CENTER_LEFT" onMouseClicked="#goToCommandesFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="📦" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Mes Commandes" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Suivre mes achats" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                        <!-- Service Item: Mes Favoris -->
                                                        <HBox alignment="CENTER_LEFT" onMouseClicked="#goToMesFavorisFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="❤️" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Mes Favoris" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Mes produits sauvegardés" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                        <!-- Service Item: Mes Produits (AGRICULTEUR only) -->
                                                        <HBox fx:id="productManagementCard" alignment="CENTER_LEFT" managed="false" onMouseClicked="#goToProductManagementFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);" visible="false">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="🌾" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Mes Produits" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Gérer mes produits" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox fx:id="statsCard" alignment="CENTER_LEFT" managed="false"
                                                              onMouseClicked="#goToStatsFromCard" spacing="15.0"
                                                              style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12;
             -fx-padding: 12; -fx-cursor: hand;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);"
                                                              visible="false">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black;
                      -fx-font-family: 'Segoe UI Emoji';" text="📊"/>
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold;
                          -fx-font-size: 14px;" text="Mes Statistiques"/>
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;"
                                                                           text="Performances &amp; ventes"/>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <!-- Service Item: Commandes Reçues (AGRICULTEUR only) -->
                                                        <HBox fx:id="ordersReceivedCard" alignment="CENTER_LEFT" managed="false" onMouseClicked="#goToCommandesVendeurFromCard" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);" visible="false">
                                                            <children>
                                                                <Label style="-fx-font-size: 24px; -fx-text-fill: black; -fx-font-family: 'Segoe UI Emoji';" text="📥" />
                                                                <VBox>
                                                                    <Label style="-fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 14px;" text="Commandes reçues" />
                                                                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Gérer les commandes" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>

                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>

                                <!-- Left Arrow -->
                                <Button mnemonicParsing="false" onAction="#prevSlide" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 50; -fx-cursor: hand; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-padding: 0;" text="❮" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="335.0">
                                    <effect><DropShadow color="rgba(0,0,0,0.3)" radius="10" /></effect>
                                </Button>

                                <!-- Right Arrow -->
                                <Button mnemonicParsing="false" onAction="#nextSlide" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 50; -fx-cursor: hand; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-padding: 0;" text="❯" AnchorPane.rightAnchor="440.0" AnchorPane.topAnchor="335.0">
                                    <effect><DropShadow color="rgba(0,0,0,0.3)" radius="10" /></effect>
                                </Button>

                            </children>
                        </AnchorPane>

                        <!-- SECTION RECOMMANDATIONS -->
                        <VBox fx:id="sectionRecommandations" spacing="0" style="-fx-background-color: rgba(0,0,0,0.75);">

                            <!-- Bloc 1 : Derniers achats -->
                            <VBox fx:id="blocDerniersAchats" managed="false" spacing="20.0" style="-fx-padding: 40 60 20 60;" visible="false">
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #8BC34A; -fx-font-weight: bold; -fx-letter-spacing: 2px;" text="VOS DERNIERS ACHATS" />
                                    <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#goToCatalogueAction" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 11px; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 20; -fx-padding: 4 14;" text="Voir le catalogue →" />
                                </HBox>
                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Rachetez vos favoris" />
                                <ScrollPane fx:id="scrollDerniersAchats" fitToHeight="true" hbarPolicy="NEVER" prefHeight="200.0" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="cartesDerniersAchats" spacing="16.0" style="-fx-background-color: transparent; -fx-padding: 5 0 10 0;" />
                                    </content>
                                </ScrollPane>
                            </VBox>

                            <!-- Séparateur discret -->
                            <javafx.scene.layout.Region fx:id="separateurRec" managed="false" prefHeight="1.0" style="-fx-background-color: rgba(255,255,255,0.1);" visible="false" />

                            <!-- Bloc 2 : Nouveautés -->
                            <VBox spacing="20.0" style="-fx-padding: 20 60 40 60;">
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #8BC34A; -fx-font-weight: bold; -fx-letter-spacing: 2px;" text="NOUVEAUTÉS DU MOMENT" />
                                    <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#goToCatalogueAction" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 11px; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 20; -fx-padding: 4 14;" text="Tout voir →" />
                                </HBox>
                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Derniers produits ajoutés" />
                                <ScrollPane fitToHeight="true" hbarPolicy="NEVER" prefHeight="200.0" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="cartesNouveautes" spacing="16.0" style="-fx-background-color: transparent; -fx-padding: 5 0 10 0;" />
                                    </content>
                                </ScrollPane>
                            </VBox>
                        </VBox>

                        <!-- GREEN FOOTER SECTION -->
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #334418; -fx-padding: 40 20; -fx-background-radius: 20 20 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, -5);">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 16px; -fx-font-weight: bold;" text="Restez connecté" />
                                <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 10 0;">
                                    <children>
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="FACEBOOK" />
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="INSTAGRAM" />
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 5; -fx-padding: 5 10;" text="TWITTER" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="À propos" />
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="Contact" />
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-cursor: hand; -fx-font-size: 12px;" text="Confidentialité" />
                                </HBox>

                                <Label style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 10px; -fx-padding: 20 0 0 0;" text="© 2026 Ardhi. All rights reserved." />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- LAYER 3: FIXED HEADER (Sticky) -->
        <AnchorPane pickOnBounds="false" StackPane.alignment="TOP_CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.6);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <!-- Logo -->
                        <ImageView fitHeight="80.0" fitWidth="70.0" preserveRatio="true">
                            <image>
                                <Image url="@../../img/ardhi_logo.png" />
                            </image>
                        </ImageView>

                        <Label fx:id="lblRole" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px; -fx-font-weight: bold;" text="Marketplace">
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </Label>

                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

                        <!-- Navigation Menu -->
                        <HBox fx:id="navMenu" alignment="CENTER" spacing="15.0">
                            <children>
                                <Button fx:id="btnNavDiagnostics" mnemonicParsing="false" onAction="#goToDiagnostics" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Diagnostic IA" />
                                <Button fx:id="btnNavMaintenance" mnemonicParsing="false" onAction="#goToMaintenance" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Maintenance" />
                                <Button fx:id="btnNavCultures" mnemonicParsing="false" onAction="#goToCultures" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cultures" />
                                <Button fx:id="btnNavEvents" mnemonicParsing="false" onAction="#goToEvents" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Évènements" />
                                <Button fx:id="btnNavEmployees" mnemonicParsing="false" onAction="#goToEmployees" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Employés" />
                            </children>
                        </HBox>

                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

                        <!-- Logout / Back buttons -->
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>

                                <!-- 🔔 Bouton notification avec badge -->
                                <StackPane fx:id="btnNotifWrapper" onMouseClicked="#ouvrirNotifications"
                                           style="-fx-cursor: hand;">
                                    <!-- Cloche -->
                                    <Button mnemonicParsing="false"
                                            style="-fx-background-color: rgba(255,255,255,0.12);
                           -fx-text-fill: white; -fx-font-size: 18px;
                           -fx-background-radius: 50;
                           -fx-border-color: rgba(255,255,255,0.2);
                           -fx-border-radius: 50; -fx-cursor: hand;
                           -fx-min-width: 42px; -fx-min-height: 42px;
                           -fx-max-width: 42px; -fx-max-height: 42px;
                           -fx-padding: 0;"
                                            text="🔔"/>

                                    <!-- Badge rouge (nombre non lues) -->
                                    <Label fx:id="badgeNotif"
                                           managed="false" visible="false"
                                           style="-fx-background-color: #e74c3c;
                          -fx-text-fill: white;
                          -fx-font-size: 9px; -fx-font-weight: bold;
                          -fx-background-radius: 20;
                          -fx-padding: 1 5;
                          -fx-min-width: 18; -fx-min-height: 18;
                          -fx-alignment: center;"
                                           text="0"
                                           StackPane.alignment="TOP_RIGHT">
                                        <StackPane.margin>
                                            <javafx.geometry.Insets top="-4.0" right="-4.0"/>
                                        </StackPane.margin>
                                    </Label>
                                </StackPane>

                                <!-- Bouton Déconnexion (inchangé) -->
                                <Button mnemonicParsing="false" onAction="#logout"
                                        style="-fx-background-color: rgba(231,76,60,0.8); -fx-text-fill: white;
                       -fx-background-radius: 20; -fx-cursor: hand;
                       -fx-padding: 6 15; -fx-font-size: 12px;"
                                        text="Déconnexion">
                                    <effect>
                                        <javafx.scene.effect.DropShadow color="rgba(0,0,0,0.3)" radius="10"/>
                                    </effect>
                                </Button>

                            </children>
                        </HBox>

                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>