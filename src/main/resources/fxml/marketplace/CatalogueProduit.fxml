<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="860.0" prefWidth="1380.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.marketplace.CatalogueProduitController">

    <!-- ═══════════════════════════════════════════════════════
         TOP NAVBAR
    ═══════════════════════════════════════════════════════ -->
    <top>
        <VBox>
            <!-- Main Navbar -->
            <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #2b5329; -fx-pref-height: 70; -fx-min-height: 70;">
                <padding><Insets bottom="0" left="30" right="30" top="0" /></padding>

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="38" fitWidth="38" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label prefHeight="30.0" prefWidth="80.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 3px;" text="ARDHI">
                            <font><Font size="28.0" /></font>
                        </Label>
                        <Label style="-fx-font-size: 8px; -fx-text-fill: #6a8a78; -fx-letter-spacing: 1.5px;" text="MARKETPLACE AGRICOLE" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge Points de Fidélité -->
                <HBox alignment="CENTER" prefHeight="70.0" prefWidth="160.0" spacing="8" style="-fx-background-color: #436d41; -fx-background-radius: 22; -fx-padding: 8 18 8 14; -fx-border-color: #f39c12; -fx-border-radius: 22; -fx-border-width: 1.5;">
                    <HBox.margin><Insets right="12" /></HBox.margin>
                    <Label style="-fx-font-size: 15px;" text="🎁" />
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #f39c12; -fx-font-weight: bold;" text="MES POINTS" />
                        <Label fx:id="lblPointsFideliteNavbar" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" text="0.00 pts" />
                    </VBox>
                </HBox>

                <!-- Panier info pill -->
                <HBox alignment="CENTER" onMouseClicked="#ouvrirPanierClick" prefHeight="70.0" prefWidth="170.0" spacing="8" style="-fx-background-color: #436d41; -fx-background-radius: 22; -fx-padding: 8 18 8 14; -fx-border-color: #5c835a; -fx-border-radius: 22; -fx-border-width: 1.5; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 15px;" text="🛒" />
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label fx:id="panierCountLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" text="0 article(s)" />
                        <Label fx:id="panierTotalLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="0.00 DT" />
                    </VBox>
                </HBox>

                <!-- Chatbot button -->
                <Button onAction="#toggleChatbot" prefHeight="42" prefWidth="42" style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(4,100,54,0.5), 10, 0, 0, 3);" text="🤖">
                    <HBox.margin><Insets left="14" /></HBox.margin>
                </Button>

                <!-- Back button -->
                <Button onAction="#retour" prefHeight="42" prefWidth="71.0" style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 18px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5;" text="←">
                    <HBox.margin><Insets left="10" /></HBox.margin>
                </Button>
            </HBox>

            <!-- Sub-bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-pref-height: 42; -fx-min-height: 42;">
                <padding><Insets left="30" right="30" /></padding>
                <Label style="-fx-font-size: 13px;" text="🌿" />
                <Label fx:id="lblNombreProduits" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" text="Chargement…" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="produits disponibles" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;" text="Produits agricoles certifiés  ✓" />
                <Button onAction="#rafraichirProduits" prefHeight="30.0" prefWidth="50.0" style="-fx-background-color: #ffffff; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 8; -fx-border-width: 1; -fx-text-fill: #7fffc0;" text="🔄" />
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════
         BODY
    ═══════════════════════════════════════════════════════ -->
    <center>
        <HBox spacing="0" style="-fx-background-color: #F4F7F6;">

            <!-- ─── LEFT FILTER PANEL ──────────────────────────── -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxWidth="280" minWidth="280" prefWidth="280" style="-fx-background-color: white; -fx-background: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
                <content>
                    <VBox spacing="0" style="-fx-background-color: white;">
                        <padding><Insets bottom="28" left="24" right="24" top="28" /></padding>

                        <!-- Filter Header -->
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" text="  ✉ Filtres" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#rafraichirProduits" style="-fx-background-color: transparent; -fx-text-fill: #4a7c47; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-width: 0; -fx-underline: true;" text="Tout réinitialiser" />
                        </HBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="16" /></VBox.margin>
                        </Separator>

                        <!-- Catégorie -->
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1.5px;" text="CATÉGORIE" />
                        <ComboBox fx:id="categorieComboBox" prefWidth="232" style="-fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff;">
                            <VBox.margin><Insets bottom="4" top="8" /></VBox.margin>
                        </ComboBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="22" /></VBox.margin>
                        </Separator>

                        <!-- Tri -->
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1.5px;" text="TRIER PAR" />
                        <ComboBox fx:id="sortComboBox" prefWidth="232" style="-fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff;">
                            <VBox.margin><Insets bottom="4" top="8" /></VBox.margin>
                        </ComboBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="22" /></VBox.margin>
                        </Separator>

                        <!-- Devise -->
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1.5px;" text="DEVISE D'AFFICHAGE" />
                        <ComboBox fx:id="deviseComboBox" prefWidth="232" style="-fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-background-color: #ffffff;">
                            <VBox.margin><Insets bottom="4" top="8" /></VBox.margin>
                        </ComboBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="22" /></VBox.margin>
                        </Separator>

                        <!-- Recherche rapide -->
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1.5px;" text="RECHERCHE RAPIDE" />
                        <HBox alignment="CENTER" prefHeight="42" spacing="0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;">
                            <VBox.margin><Insets top="8" /></VBox.margin>
                            <Button fx:id="btnRechercher" onAction="#handleSearch" prefHeight="42" prefWidth="38" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-width: 0;" text="🔍" />
                            <TextField fx:id="searchField" prefHeight="42" prefWidth="188" promptText="Nom du produit…" style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-border-width: 0; -fx-text-fill: #2b5329;" />
                        </HBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="22" /></VBox.margin>
                        </Separator>

                        <!-- ══════════════════════════════════════════
                             FOURCHETTE DE PRIX
                        ══════════════════════════════════════════ -->
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1.5px;" text="FOURCHETTE DE PRIX" />

                        <!-- Affichage min / max -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <VBox.margin><Insets bottom="2" top="10" /></VBox.margin>

                            <VBox alignment="CENTER" spacing="2">
                                <Label style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" text="MIN" />
                                <Label fx:id="lblPrixMin" prefWidth="96" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a7c47; -fx-background-color: #e6f5ee; -fx-background-radius: 8; -fx-padding: 5 12; -fx-border-color: #b8dfc8; -fx-border-radius: 8; -fx-border-width: 1;" text="0 DT" />
                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <VBox alignment="CENTER" spacing="2">
                                <Label style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" text="MAX" />
                                <Label fx:id="lblPrixMax" prefWidth="96" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329; -fx-background-color: #f0f4f1; -fx-background-radius: 8; -fx-padding: 5 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1;" text="500 DT" />
                            </VBox>
                        </HBox>

                        <!-- Slider MIN -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <VBox.margin><Insets top="10" /></VBox.margin>
                            <Label style="-fx-font-size: 10px;" text="🟢" />
                            <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="Prix min" />
                        </HBox>
                        <Slider fx:id="sliderPrixMin" blockIncrement="5" majorTickUnit="100" max="500" min="0" minorTickCount="4" prefWidth="232" showTickLabels="true" showTickMarks="true" style="-fx-base: #4a7c47; -fx-control-inner-background: #c8e6c9;" value="0">
                            <VBox.margin><Insets bottom="4" top="4" /></VBox.margin>
                        </Slider>

                        <!-- Slider MAX -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <VBox.margin><Insets top="8" /></VBox.margin>
                            <Label style="-fx-font-size: 10px;" text="🔵" />
                            <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1a5faa;" text="Prix max" />
                        </HBox>
                        <Slider fx:id="sliderPrixMax" blockIncrement="5" majorTickUnit="100" max="500" min="0" minorTickCount="4" prefWidth="232" showTickLabels="true" showTickMarks="true" style="-fx-base: #4a7c47; -fx-control-inner-background: #c8e6c9;" value="500">
                            <VBox.margin><Insets top="4" /></VBox.margin>
                        </Slider>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="22" top="20" /></VBox.margin>
                        </Separator>

                        <!-- En Solde -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="checkSolde" style="-fx-font-size: 13px; -fx-text-fill: #2b5329; -fx-font-weight: bold; -fx-cursor: hand;" text="En Solde uniquement 🔖" />
                        </HBox>

                        <Separator style="-fx-background-color: #e5e7eb;">
                            <VBox.margin><Insets bottom="16" top="20" /></VBox.margin>
                        </Separator>

                        <!-- Actions secondaires -->
                        <Button onAction="#ouvrirReclamation" prefHeight="42" prefWidth="232" style="-fx-background-color: #fff5eb; -fx-text-fill: #c0621a; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #f0d0b0; -fx-border-radius: 12; -fx-border-width: 1.5;" text="📝  Faire une réclamation">
                            <VBox.margin><Insets bottom="10" /></VBox.margin>
                        </Button>
                        <Button fx:id="btnLancerComparaison" disable="true" onAction="#lancerComparaison" prefHeight="42" prefWidth="232" style="-fx-background-color: #e8f0fe; -fx-text-fill: #1a5faa; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #b8d0f0; -fx-border-radius: 12; -fx-border-width: 1.5;" text="⚖️  Comparer (0)">
                            <VBox.margin><Insets bottom="10" /></VBox.margin>
                        </Button>
                        <Button fx:id="btnToggleChatbot" onAction="#toggleChatbot" prefHeight="42" prefWidth="232" style="-fx-background-color: #e6f5ee; -fx-text-fill: #4a7c47; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #b8dfc8; -fx-border-radius: 12; -fx-border-width: 1.5;" text="🤖  Assistant IA" />
                    </VBox>
                </content>
            </ScrollPane>

            <!-- ─── RIGHT PRODUCT AREA ──────────────────────────── -->
            <VBox spacing="0" style="-fx-background-color: #F4F7F6;" HBox.hgrow="ALWAYS">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <GridPane fx:id="produitsGrid" hgap="22" style="-fx-background-color: transparent;" vgap="22">
                            <padding><Insets bottom="28" left="28" right="28" top="28" /></padding>
                        </GridPane>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- ─── CHATBOT PANEL ── -->
            <VBox fx:id="chatbotPanel" managed="false" maxWidth="380" minWidth="380" prefWidth="380" spacing="0" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 1;" visible="false">

                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to right, #1a6b3c, #27ae60); -fx-pref-height: 64; -fx-min-height: 64;">
                    <padding><Insets left="16" right="16" /></padding>
                    <Label style="-fx-font-size: 22px;" text="🤖" />
                    <VBox spacing="1">
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Assistant Marketplace" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #a8f0c8;" text="En ligne ●" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#toggleChatbot" prefHeight="30" prefWidth="30" style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-font-size: 20px; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-width: 0;" text="✕" />
                </HBox>

                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f5f8f5; -fx-background: #f5f8f5; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="chatMessagesBox" spacing="10" style="-fx-background-color: #f5f8f5;">
                            <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox fx:id="chatLoadingBox" alignment="CENTER_LEFT" managed="false" spacing="8" style="-fx-background-color: white; -fx-padding: 6 16 0 16;" visible="false">
                    <ProgressIndicator prefHeight="14" prefWidth="14" style="-fx-progress-color: #27ae60;" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="L'assistant réfléchit…" />
                </HBox>

                <HBox fx:id="recordingIndicatorBox" alignment="CENTER_LEFT" managed="false" spacing="8" style="-fx-background-color: #fff5f5; -fx-padding: 4 16 0 16;" visible="false">
                    <Label fx:id="recordingDot" style="-fx-font-size: 12px; -fx-text-fill: #e74c3c;" text="●" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" text="Écoute en cours…" />
                </HBox>

                <HBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0; -fx-padding: 10 12 10 12;">
                    <TextArea fx:id="chatInputField" prefRowCount="2" promptText="Votre message… (Ctrl+Entrée)" style="-fx-font-size: 12px; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d0dce8; -fx-background-color: #f8fafc; -fx-padding: 6 10 6 10;" wrapText="true" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnMicrophone" onAction="#toggleMicrophone" prefHeight="42" prefWidth="60" style="-fx-background-color: #f0f4f1; -fx-text-fill: #4a7c47; -fx-font-size: 16px; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-color: #b8dfc8; -fx-border-radius: 50; -fx-border-width: 1.5;" text="🎤" />
                    <Button fx:id="chatSendButton" onAction="#envoyerMessageChat" prefHeight="42" prefWidth="42" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 50; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.4), 6, 0, 0, 2);" text="➤" />
                </HBox>
            </VBox>

        </HBox>
    </center>

    <!-- ═══════════════════════════════════════════════════════
         FOOTER
    ═══════════════════════════════════════════════════════ -->
    <bottom>
        <StackPane>

            <!-- Footer standard -->
            <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #2b5329;">
                <padding><Insets bottom="12" left="30" right="30" top="12" /></padding>
                <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.40);" text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés" />
            </HBox>

            <!-- Barre flottante comparaison -->
            <HBox fx:id="barreComparaison" alignment="CENTER_LEFT" managed="false" spacing="16" style="-fx-background-color: #2b5329;                      -fx-border-color: #7fffc0; -fx-border-width: 1.5 0 0 0;                      -fx-pref-height: 68; -fx-min-height: 68;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 24, 0, 0, -8);" visible="false">
                <padding><Insets left="28" right="28" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px;" text="⚖️" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" text="COMPARAISON" />
                        <Label fx:id="lblComparaisonCount" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7fffc0;" text="0 produit(s) sélectionné(s)" />
                    </VBox>
                </HBox>

                <HBox fx:id="comparaisonProduitsBox" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS" />

                <Button onAction="#viderComparaison" style="-fx-background-color: transparent; -fx-text-fill: #6a8a78; -fx-font-size: 11px;                            -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;                            -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 6 14;" text="✕  Vider" />

                <Button fx:id="btnLancerComparaisonBarre" disable="true" onAction="#lancerComparaison" style="-fx-background-color: #6b7280; -fx-text-fill: #6a8a78; -fx-font-size: 13px;                            -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: default; -fx-padding: 10 24;" text="⚖️  Lancer la comparaison" />
            </HBox>

        </StackPane>
    </bottom>

</BorderPane>
