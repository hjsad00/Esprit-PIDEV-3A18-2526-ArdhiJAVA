<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="920.0" prefWidth="1300.0"
            style="-fx-background-color: #F4F7F6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.marketplace.DetailProduitController">

    <!-- ══════ NAVBAR ══════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #2b5329; -fx-pref-height: 68; -fx-min-height: 68;">
                <padding><Insets left="30" right="30" /></padding>

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitHeight="36" fitWidth="36" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../img/ardhi_logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;" text="ARDHI" />
                        <Label style="-fx-font-size: 8px; -fx-text-fill: #6a8a78;" text="MARKETPLACE AGRICOLE" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Fil d'Ariane -->
                <HBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #6a8a78; -fx-cursor: hand;"
                           text="← Catalogue" onMouseClicked="#retourCatalogue" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #446655;" text="›" />
                    <Label fx:id="lblBreadcrumb"
                           style="-fx-font-size: 11px; -fx-text-fill: #8BC34A; -fx-font-weight: bold;"
                           text="Détail produit" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Back button -->
                <Button onMouseClicked="#retourCatalogue"
                        style="-fx-background-color: transparent; -fx-text-fill: #c8d8c8; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand; -fx-border-color: #5c835a; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 18 8 18;"
                        text="← Retour au catalogue" />
            </HBox>
        </VBox>
    </top>

    <!-- ══════ BODY ══════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="0" style="-fx-background-color: #F4F7F6;">
                    <padding><Insets bottom="40" left="40" right="40" top="32" /></padding>

                    <!-- ══ Section 1 : Image + Infos côte à côte ══ -->
                    <HBox spacing="36" alignment="TOP_LEFT">

                        <!-- IMAGE PANEL -->
                        <VBox spacing="14" minWidth="460" maxWidth="460">
                            <StackPane fx:id="imgZone" prefHeight="360" minHeight="360" maxHeight="360"
                                       style="-fx-background-color: #e8efe8; -fx-background-radius: 22;">
                                <ImageView fx:id="imgProduit" fitWidth="460" fitHeight="360"
                                           preserveRatio="true" smooth="true" />
                                <!-- Badge SOLDE -->
                                <Label fx:id="soldeBadge" text=""
                                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 0 0 14 0; -fx-padding: 6 14 6 14;"
                                       visible="false" managed="false">
                                    <StackPane.alignment>TOP_LEFT</StackPane.alignment>
                                </Label>
                            </StackPane>
                        </VBox>

                        <!-- INFO PANEL -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- Badges catégorie + stock -->
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="lblCategorieBadge"
                                       style="-fx-background-color: #e8f5e9; -fx-text-fill: #4a7c47; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 5 14 5 14; -fx-border-color: #b8dfc8; -fx-border-radius: 20; -fx-border-width: 1;"
                                       text="Catégorie" />
                                <Label fx:id="lblStockBadge"
                                       style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 5 14 5 14;"
                                       text="En stock" />
                            </HBox>

                            <!-- Nom produit -->
                            <Label fx:id="lblNomProduit"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"
                                   text="Nom du produit" wrapText="true" />

                            <!-- Vendeur -->
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label style="-fx-font-size: 14px;" text="🌍" />
                                <Label fx:id="lblVendeur"
                                       style="-fx-font-size: 13px; -fx-text-fill: #6a8a78;"
                                       text="Vendeur inconnu" />
                            </HBox>

                            <!-- Rating -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="lblEtoiles"
                                       style="-fx-font-size: 18px; -fx-text-fill: #f0a500;"
                                       text="☆☆☆☆☆" />
                                <Label fx:id="lblScoreRating"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2b5329;"
                                       text="0.0" />
                                <Label fx:id="lblNombreAvis"
                                       style="-fx-font-size: 12px; -fx-text-fill: #6a8a78;"
                                       text="(0 avis)" />
                            </HBox>

                            <Separator style="-fx-background-color: #dce8dc;" />

                            <!-- Prix -->
                            <VBox spacing="4">
                                <Label fx:id="lblPrixBarre"
                                       style="-fx-font-size: 14px; -fx-text-fill: #bbb; -fx-strikethrough: true;"
                                       text="" visible="false" managed="false" />
                                <HBox spacing="6" alignment="BOTTOM_LEFT">
                                    <Label fx:id="lblPrixFinal"
                                           style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;"
                                           text="0.00" />
                                    <Label fx:id="lblDevise"
                                           style="-fx-font-size: 16px; -fx-text-fill: #6a8a78; -fx-padding: 0 0 8 0;"
                                           text=" DT" />
                                </HBox>
                                <Label fx:id="lblEconomie"
                                       style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"
                                       text="" visible="false" managed="false" />
                            </VBox>

                            <!-- Stock + Unité -->
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label fx:id="lblQuantiteChip"
                                       style="-fx-background-color: #f0f4f1; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-border-color: #dceade; -fx-border-radius: 20; -fx-border-width: 1;"
                                       text="📦  Stock : —" />
                                <Label fx:id="lblUniteChip"
                                       style="-fx-background-color: #f0f4f1; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-border-color: #dceade; -fx-border-radius: 20; -fx-border-width: 1;"
                                       text="📐  Unité : —" />
                            </HBox>

                            <!-- Description -->
                            <VBox spacing="6">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6a8a78;"
                                       text="DESCRIPTION" />
                                <Label fx:id="lblDescription"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2d4a36; -fx-line-spacing: 4;"
                                       text="" wrapText="true" maxWidth="580" />
                            </VBox>

                            <Separator style="-fx-background-color: #dce8dc;" />

                            <!-- Spinner + boutons -->
                            <HBox spacing="14" alignment="BOTTOM_LEFT">
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6a8a78;"
                                           text="QUANTITÉ" />
                                    <Spinner fx:id="quantiteSpinner" prefWidth="100" prefHeight="44"
                                             style="-fx-background-color: #f0f4f1; -fx-background-radius: 12; -fx-border-color: #dce8dc; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-font-size: 14px;" />
                                </VBox>

                                <Button fx:id="btnAjouterPanier" onAction="#ajouterAuPanier"
                                        prefHeight="44" prefWidth="230"
                                        style="-fx-background-color: #4a7c47; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);"
                                        text="🛒  Ajouter au panier" />

                                <Button fx:id="btnFavori" onAction="#toggleFavori"
                                        prefHeight="44" prefWidth="44"
                                        style="-fx-background-color: white; -fx-font-size: 20px; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #dce8dc; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 6, 0, 0, 2); -fx-text-fill: #aaa;"
                                        text="♡" />
                            </HBox>

                        </VBox>
                    </HBox>

                    <!-- Spacer -->
                    <Region prefHeight="40" />

                    <!-- ══ Section Avis (fond sombre) ══ -->
                    <VBox spacing="20"
                          style="-fx-background-color: #2b5329; -fx-background-radius: 24; -fx-padding: 36;">

                        <!-- En-tête score -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"
                                   text="⭐  Avis clients" />
                            <Region HBox.hgrow="ALWAYS" />
                            <VBox alignment="CENTER_RIGHT" spacing="2">
                                <Label fx:id="lblScoreGros"
                                       style="-fx-font-size: 52px; -fx-font-weight: bold; -fx-text-fill: #f0a500;"
                                       text="—" />
                                <Label fx:id="lblEtoilesMoy"
                                       style="-fx-font-size: 20px; -fx-text-fill: #f0a500;"
                                       text="☆☆☆☆☆" />
                                <Label fx:id="lblTotalAvis"
                                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.45);"
                                       text="0 avis" />
                            </VBox>
                        </HBox>

                        <!-- Liste avis (remplie dynamiquement) -->
                        <VBox fx:id="vboxAvisList" spacing="14" />

                        <!-- Formulaire avis -->
                        <VBox spacing="14"
                              style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 24;">

                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"
                                   text="✍️  Laisser un avis" />

                            <!-- Étoiles interactives (remplies en Java) -->
                            <HBox fx:id="hboxEtoiles" spacing="6" alignment="CENTER_LEFT" />

                            <TextArea fx:id="taCommentaire"
                                      promptText="Partagez votre expérience avec ce produit..."
                                      prefHeight="100" wrapText="true"
                                      style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.35); -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px;" />

                            <Button fx:id="btnPublierAvis" onAction="#publierAvis"
                                    prefHeight="42" prefWidth="200"
                                    style="-fx-background-color: #8BC34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12; -fx-cursor: hand;"
                                    text="✓  Publier mon avis" />
                        </VBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══════ FOOTER ══════ -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2b5329;">
            <padding><Insets bottom="12" top="12" /></padding>
            <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"
                   text="© 2025 Ardhi — Marketplace Agricole  |  Tous droits réservés" />
        </HBox>
    </bottom>

</BorderPane>
