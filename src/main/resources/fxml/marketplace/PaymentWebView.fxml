<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.web.WebView?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.neuron.ardhi.controllers.marketplace.PaymentWebViewController"
      prefWidth="900" prefHeight="680"
      style="-fx-background-color: #1a1a2e;">

    <!-- Barre supérieure -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: #16213e; -fx-padding: 10 16 10 16;">
        <Label text="🔒 Paiement sécurisé – Ardhi"
               style="-fx-text-fill: #a8d5ba; -fx-font-size: 14px; -fx-font-weight: bold;" />
        <HBox HBox.hgrow="ALWAYS" />
        <Label fx:id="lblStatus" text="Chargement..."
               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px;" />
        <Button fx:id="btnAnnuler" text="✕ Annuler le paiement"
                onAction="#annulerPaiement"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-background-radius: 6; -fx-padding: 6 14;" />
    </HBox>

    <!-- Barre de chargement -->
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="4"
                 style="-fx-accent: #43a047;" />

    <!-- WebView principale -->
    <WebView fx:id="webView" VBox.vgrow="ALWAYS" />

</VBox>
