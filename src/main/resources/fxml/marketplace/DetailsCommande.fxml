<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="0"
      prefWidth="480" minWidth="480" maxWidth="480"
      prefHeight="550" maxHeight="550"
      style="-fx-background-color: #F4F7F6;"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.neuron.ardhi.controllers.marketplace.DetailsCommandeController">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: linear-gradient(to right, #2b5329, #1a3525); -fx-padding: 18 20 18 20; -fx-min-height: 64; -fx-max-height: 64;">
        <Label text="📦" style="-fx-font-size: 22px;" />
        <VBox spacing="2">
            <Label text="Détails de la commande"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label fx:id="lblSousTitreHeader" text=""
                   style="-fx-font-size: 10px; -fx-text-fill: #7fffc0;" />
        </VBox>
    </HBox>

    <!-- ── Scrollable body ─────────────────────────────────────── -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefHeight="486" maxHeight="486"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="14" style="-fx-background-color: #F4F7F6;">
                <padding><Insets top="18" right="18" bottom="18" left="18" /></padding>

                <!-- ── Info card ──────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">

                    <HBox style="-fx-background-color: #f5f8f5; -fx-background-radius: 14 14 0 0; -fx-padding: 12 16;">
                        <Label text="ℹ️  Informations générales"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 0.5px;" />
                    </HBox>

                    <VBox spacing="12" style="-fx-padding: 16 16 16 16;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📅" style="-fx-font-size: 16px;" />
                            <VBox spacing="1">
                                <Label text="DATE"
                                       style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <Label fx:id="lblDate" text="—"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                            </VBox>
                        </HBox>

                        <Separator style="-fx-background-color: #eef2ef;" />

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="🏷️" style="-fx-font-size: 16px;" />
                            <VBox spacing="1">
                                <Label text="STATUT"
                                       style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <Label fx:id="lblStatut" text="—"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                            </VBox>
                        </HBox>

                        <Separator style="-fx-background-color: #eef2ef;" />

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="🚚" style="-fx-font-size: 16px;" />
                            <VBox spacing="1">
                                <Label text="LIVRAISON"
                                       style="-fx-font-size: 8px; -fx-text-fill: #6b7280; -fx-letter-spacing: 1px;" />
                                <Label fx:id="lblModeLivraison" text="—"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2b5329;" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ── Prix card ──────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">

                    <HBox style="-fx-background-color: #f5f8f5; -fx-background-radius: 14 14 0 0; -fx-padding: 12 16;">
                        <Label text="💰  Récapitulatif du prix"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 0.5px;" />
                    </HBox>

                    <VBox spacing="10" style="-fx-padding: 16 16 16 16;">
                        <HBox fx:id="rowSousTotal" alignment="CENTER_LEFT" spacing="0"
                              visible="false" managed="false">
                            <Label text="Sous-total"
                                   style="-fx-font-size: 12px; -fx-text-fill: #6a8a78;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSousTotal" text="—"
                                   style="-fx-font-size: 12px; -fx-text-fill: #6a8a78;" />
                        </HBox>

                        <HBox fx:id="rowReduction" alignment="CENTER_LEFT" spacing="8"
                              visible="false" managed="false">
                            <Label text="PROMO"
                                   style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: white;
                  -fx-background-color: #e74c3c; -fx-background-radius: 4;
                  -fx-padding: 2 6 2 6; -fx-letter-spacing: 0.5px;" />
                            <Label text="Réduction appliquée"
                                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblReduction" text="—"
                                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" />
                        </HBox>

                        <Separator fx:id="sepReduction" visible="false" managed="false"
                                   style="-fx-background-color: #eef2ef;" />

                        <HBox fx:id="rowFraisLivraison" alignment="CENTER_LEFT" spacing="8"
                              visible="false" managed="false">
                            <Label text="🚚"
                                   style="-fx-font-size: 13px;" />
                            <Label text="Frais de livraison"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2980b9;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblFraisLivraison" text="—"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2980b9; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="0"
                              style="-fx-background-color: #e6f5ee; -fx-background-radius: 10; -fx-padding: 10 14;">
                            <Label text="✅  Total payé"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTotal" text="—"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4a7c47;" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ── Produits card ───────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3);">

                    <HBox style="-fx-background-color: #f5f8f5; -fx-background-radius: 14 14 0 0; -fx-padding: 12 16;">
                        <Label fx:id="lblProduitsTitre" text="📦  Produits commandés"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-letter-spacing: 0.5px;" />
                    </HBox>

                    <VBox fx:id="produitsContainer" spacing="0" style="-fx-padding: 8 0 8 0;" />

                </VBox>

            </VBox>
        </content>
    </ScrollPane>

</VBox>
