<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="710.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.neuron.ardhi.controllers.UserDiagAndCommController">
    <children>
        <!-- LAYER 1: BACKGROUND -->
        <AnchorPane>
            <children>
                <ImageView fitHeight="710.0" fitWidth="1060.0" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <image>
                        <Image url="@../../img/DiagComm_bg.png" />
                    </image>
                </ImageView>
                <!-- Dark Overlay -->
                <javafx.scene.shape.Rectangle height="710.0" width="1060.0" opacity="0.4" fill="BLACK" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </children>
        </AnchorPane>

        <!-- LAYER 2: INTERFACE -->
        <AnchorPane>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 5 40; -fx-background-color: rgba(0,0,0,0.2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <!-- Logo -->
                        <ImageView fitHeight="45.0" fitWidth="120.0" onMouseClicked="#goToLandingPage" preserveRatio="true" style="-fx-cursor: hand;">
                            <image>
                                <Image url="@../../img/ardhi_logo.png" />
                            </image>
                        </ImageView>

                        <!-- Spacer Left -->
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

                        <!-- Navigation Menu -->
                        <HBox fx:id="navMenu" alignment="CENTER" spacing="15.0">
                            <children>
                                <!-- Highlighted Item: Diagnostic IA -->
                                <VBox alignment="CENTER" spacing="2">
                                    <Button fx:id="btnNavDiagnostics" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Diagnostic IA"/>
                                    <AnchorPane prefHeight="3.0" prefWidth="25.0" style="-fx-background-color: white; -fx-background-radius: 2;" />
                                </VBox>

                                <Button fx:id="btnNavMarketplace" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Marketplace"/>
                                <Button fx:id="btnNavMaintenance" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Maintenance"/>
                                <Button fx:id="btnNavCultures" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cultures"/>
                                <Button fx:id="btnNavEvents" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Évènements"/>
                                <Button fx:id="btnNavEmployees" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.9); -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Employés"/>
                            </children>
                        </HBox>

                        <!-- Spacer Right -->
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

                        <!-- Authentication Area -->
                        <StackPane>
                            <children>
                                <!-- Profile Icon -->
                                <HBox fx:id="profileContainer" alignment="CENTER" maxHeight="45.0" maxWidth="45.0" minHeight="45.0" minWidth="45.0" onMouseClicked="#goToProfil" style="-fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 100; -fx-border-color: rgba(255,255,255,0.5); -fx-border-radius: 100;">
                                    <children>
                                        <Label text="👤" textFill="WHITE">
                                            <font>
                                                <Font size="24.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <!-- Main Content -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;"
                            AnchorPane.topAnchor="90.0" AnchorPane.bottomAnchor="0.0"
                            AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="30.0" prefWidth="900.0" style="-fx-background-color: transparent;">
                            <children>
                                <!-- Welcome Message -->
                                <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 30;">
                                    <children>
                                        <Label fx:id="lblBienvenue" text="Bienvenue sur Ardhi" style="-fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);">
                                            <font>
                                                <Font name="System Bold" size="28.0"/>
                                            </font>
                                        </Label>
                                        <Label text="Gérez votre exploitation agricole intelligemment" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);">
                                            <font>
                                                <Font size="14.0"/>
                                            </font>
                                        </Label>
                                        <!-- Gamification Widget -->
                                        <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F5F5F5; -fx-background-radius: 20; -fx-padding: 20;">
                                            <children>
                                                <Label fx:id="lblLevel" text="Niveau 1" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 14;" />
                                                <javafx.scene.control.ProgressBar fx:id="barLevel" prefWidth="150.0" progress="0.0" style="-fx-accent: #116530; -fx-control-inner-background: white;"/>
                                                <Label fx:id="lblPoints" text="0 pts" style="-fx-text-fill: #333333; -fx-font-weight: bold;">
                                                    <font>
                                                        <Font size="13.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>

                                        <!-- Badges Section -->
                                        <VBox spacing="10.0" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                                            <Label text="Mes Badges" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);"/>
                                            <javafx.scene.layout.FlowPane fx:id="badgesContainer" hgap="15.0" vgap="10.0" alignment="CENTER" prefWrapLength="400.0"/>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Weather Widget -->
                                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, rgba(52, 152, 219, 0.9), rgba(41, 128, 185, 0.95)); -fx-background-radius: 15; -fx-padding: 20;" maxWidth="900.0">
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.15)" radius="10"/>
                                    </effect>
                                    <children>
                                        <Label fx:id="lblWeatherIcon" text="🌤️" style="-fx-font-size: 48; -fx-text-fill: white;"/>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0" minWidth="150.0">
                                            <children>
                                                <Label fx:id="lblTemperature" text="-- °C" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="24.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblCondition" text="Chargement..." style="-fx-text-fill: rgba(255,255,255,0.9);">
                                                    <font>
                                                        <Font size="14.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblHumidity" text="Humidité: --%" style="-fx-text-fill: rgba(255,255,255,0.8);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 10;">
                                            <children>
                                                <Label text="💡 Conseil Agronome du Jour" style="-fx-text-fill: #f1c40f;">
                                                    <font>
                                                        <Font name="System Bold" size="14.0"/>
                                                    </font>
                                                    <VBox.margin>
                                                        <Insets bottom="5.0"/>
                                                    </VBox.margin>
                                                </Label>
                                                <Label fx:id="lblAdvice" text="Connexion aux services météo..." wrapText="true" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font size="13.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- User Action Cards -->
                                <HBox alignment="CENTER" spacing="30.0">
                                    <children>
                                        <!-- Profile Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(52, 73, 94, 0.9), rgba(44, 62, 80, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToProfil">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(44, 62, 80, 0.3)" radius="12"/>
                                            </effect>
                                            <children>
                                                <Label text="👤" style="-fx-font-size: 40; -fx-text-fill: white;"/>
                                                <Label text="Mon Profil" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Gérer mes informations&#10;personnelles" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <!-- Subscription Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(196, 165, 116, 0.9), rgba(160, 133, 85, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToAbonnement">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(196,165,116,0.3)" radius="15"/>
                                            </effect>
                                            <children>
                                                <Label text="💎" style="-fx-font-size: 40;"/>
                                                <Label text="Abonnement" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Découvrir nos offres&#10;Premium &amp; VIP" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <!-- AI Diagnosis Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(17, 101, 48, 0.9), rgba(74, 140, 63, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToDiagnostics">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.15)" radius="12"/>
                                            </effect>
                                            <children>
                                                <Label text="🌱" style="-fx-font-size: 40;"/>
                                                <Label text="Diagnostic IA" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Analyser vos cultures&#10;avec l'intelligence artificielle" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Second Row of Cards -->
                                <HBox alignment="CENTER" spacing="30.0">
                                    <children>
                                        <!-- Diagnostic History Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(91, 153, 163, 0.9), rgba(58, 122, 133, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToHistoriqueDiagnostics">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(91,153,163,0.3)" radius="15"/>
                                            </effect>
                                            <children>
                                                <Label text="📜" style="-fx-font-size: 40;"/>
                                                <Label text="Historique" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Consultez vos&#10;diagnostics précédents" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <!-- Community Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(155, 89, 182, 0.9), rgba(142, 68, 173, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToCommunity">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(155, 89, 182, 0.3)" radius="15"/>
                                            </effect>
                                            <children>
                                                <Label text="👥" style="-fx-font-size: 40;"/>
                                                <Label text="Communauté" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Entraide et conseils&#10;entre agriculteurs" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <!-- Disease Map Card -->
                                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(231, 76, 60, 0.9), rgba(192, 57, 43, 0.95)); -fx-background-radius: 15; -fx-padding: 35; -fx-cursor: hand;" prefWidth="220.0" onMouseClicked="#goToMap">
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="rgba(231, 76, 60, 0.3)" radius="15"/>
                                            </effect>
                                            <children>
                                                <Label text="🌍" style="-fx-font-size: 40;"/>
                                                <Label text="Carte Maladies" style="-fx-text-fill: white;">
                                                    <font>
                                                        <Font name="System Bold" size="18.0"/>
                                                    </font>
                                                </Label>
                                                <Label text="Épidémiologie des&#10;maladies végétales" textAlignment="CENTER" style="-fx-text-fill: rgba(255,255,255,0.85);">
                                                    <font>
                                                        <Font size="12.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Leaderboard Section -->
                                <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.35); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5); -fx-padding: 20;" maxWidth="900.0">
                                    <children>
                                        <Label text="🏆 Leaderboard - Top Agriculteurs" style="-fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 0, 1);">
                                            <font>
                                                <Font name="System Bold" size="20.0"/>
                                            </font>
                                        </Label>
                                        <VBox fx:id="leaderboardContainer" spacing="10.0">
                                            <children>
                                                <Label text="Chargement du classement..." textFill="WHITE"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Logout Button -->
                                <Button mnemonicParsing="false" onAction="#logout" style="-fx-background-color: rgba(231, 76, 60, 0.25); -fx-background-radius: 30; -fx-border-color: rgba(231, 76, 60, 0.8); -fx-border-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);" text="Se déconnecter" textFill="WHITE" prefWidth="250.0">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                    <padding>
                                        <Insets bottom="12.0" top="12.0"/>
                                    </padding>
                                    <VBox.margin>
                                        <Insets top="30.0" bottom="50.0"/>
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </AnchorPane>
    </children>
</StackPane>