<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="1060.0"
            style="-fx-background-color: #f8faf7;"
            xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.neuron.ardhi.controllers.Parcelle_Cultures.AgriculteurCulturesController">
    <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="20.0">
        <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 25; -fx-border-color: rgba(0,0,0,0.05); -fx-border-radius: 12;">
                <effect>
                    <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="10"/>
                </effect>
                <Button mnemonicParsing="false" onAction="#retour"
                        style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: rgba(0,0,0,0.05); -fx-border-radius: 8; -fx-cursor: hand;"
                        text="← Retour" textFill="#116530">
                    <font><Font name="System Bold" size="12.0"/></font>
                    <padding><Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/></padding>
                </Button>
                <ImageView fitHeight="50.0" fitWidth="50.0" preserveRatio="true">
                    <image>
                        <Image url="@../img/ardhi_logo.png"/>
                    </image>
                </ImageView>
                <Label text="Mes Cultures" style="-fx-text-fill: #116530;">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Label>
                <Label text="🌿 Plantations"
                       style="-fx-text-fill: #43A047; -fx-background-color: #E8F5E9; -fx-background-radius: 5; -fx-padding: 4 10;">
                    <font>
                        <Font name="System Bold" size="11.0"/>
                    </font>
                </Label>
            </HBox>

            <!-- Main Content -->
            <VBox fx:id="mainContainer" spacing="12.0" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Search & Filter Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 20;">
                        <effect>
                            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.08)" radius="8"/>
                        </effect>
                        <children>
                            <Label text="🔍" style="-fx-font-size: 18;"/>
                            <TextField fx:id="tfRecherche" promptText="Rechercher par nom, type, parcelle..."
                                       prefWidth="200.0"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 8;">
                                <font>
                                    <Font size="12.0"/>
                                </font>
                            </TextField>
                            <ComboBox fx:id="cbFilterTypeCulture" promptText="Type" prefWidth="130.0"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                            <ComboBox fx:id="cbFilterSaison" promptText="Saison" prefWidth="130.0"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                            <ComboBox fx:id="cbFilterEtat" promptText="État" prefWidth="130.0"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;"/>
                            <Button onAction="#rafraichir"
                                    style="-fx-background-color: #116530; -fx-background-radius: 5; -fx-cursor: hand;"
                                    text="Actualiser" textFill="WHITE">
                                <font>
                                    <Font size="11.0"/>
                                </font>
                                <padding>
                                    <Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/>
                                </padding>
                            </Button>

                            <Label fx:id="lblInfo" text="" style="-fx-text-fill: #888888;">
                                <font>
                                    <Font size="11.0"/>
                                </font>
                                <HBox.margin>
                                    <Insets left="15.0"/>
                                </HBox.margin>
                            </Label>
                        </children>
                    </HBox>

                    <!-- Content Area -->
                    <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Table -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 0; -fx-effect: dropshadow(gaussian, #00000014, 8, 0, 0, 0); -fx-border-color: rgba(0,0,0,0.05); -fx-border-radius: 10;"
                                  HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="💡 Contrainte: date_plantation &lt; date_récolte prévue"
                                           style="-fx-text-fill: #888888;">
                                        <font>
                                            <Font name="System Italic" size="12.0"/>
                                        </font>
                                        <padding>
                                            <Insets left="15.0" top="10.0" bottom="5.0"/>
                                        </padding>
                                    </Label>
                                    <TableView fx:id="tableCultures"
                                               style="-fx-background-radius: 10; -fx-border-color: transparent;"
                                               VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                                            <TableColumn fx:id="colTypeCulture" prefWidth="100.0" text="Variété"/>
                                            <TableColumn fx:id="colSaison" prefWidth="80.0" text="Saison"/>
                                            <TableColumn fx:id="colEtatCulture" prefWidth="100.0" text="Etat"/>
                                            <TableColumn fx:id="colDatePlantation" prefWidth="100.0" text="Plantation"/>
                                            <TableColumn fx:id="colDateRecolte" prefWidth="100.0"
                                                         text="Récolte Prévue"/>
                                            <TableColumn fx:id="colParcelle" prefWidth="120.0" text="Parcelle"/>
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>

                            <!-- Form / Details Panel -->
                            <VBox spacing="12.0"
                                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #00000014, 8, 0, 0, 0);"
                                  prefWidth="300.0">
                                <children>
                                    <Label fx:id="lblTitreFormulaire" text="Ajouter une culture"
                                           style="-fx-text-fill: #116530;">
                                        <font>
                                            <Font name="System Bold" size="16.0"/>
                                        </font>
                                        <VBox.margin>
                                            <Insets bottom="5.0"/>
                                        </VBox.margin>
                                    </Label>

                                    <!-- Dynamic Parcelle Indication Box -->
                                    <VBox fx:id="vboxIndicationParcelle" spacing="4.0"
                                          style="-fx-background-color: #FFF3E0; -fx-background-radius: 8; -fx-padding: 10;"
                                          managed="false" visible="false">
                                        <Label fx:id="lblIndicationParcelle" text=""
                                               wrapText="true"
                                               style="-fx-text-fill: #E65100; -fx-font-weight: bold; -fx-font-size: 11;"/>
                                        <Label fx:id="lblIndicationDetail" text=""
                                               wrapText="true"
                                               style="-fx-text-fill: #BF360C; -fx-font-size: 10;"/>
                                    </VBox>

                                    <javafx.scene.control.ScrollPane fitToWidth="true"
                                                                     style="-fx-background-color: transparent; -fx-background: transparent;"
                                                                     VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox spacing="12.0" style="-fx-background-color: transparent;">
                                                <children>
                                                    <Label text="Type de Culture *"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <TextField fx:id="tfTypeCulture" promptText="Ex: Tomate, Olivier, Blé, Carotte..."
                                                               style="-fx-background-radius: 5;"/>
                                                    <Label text="💡 Variété ou espèce spécifique à cultiver"
                                                           style="-fx-text-fill: #aab0b5; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Saison"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <ComboBox fx:id="cbSaison" promptText="Détectée automatiquement"
                                                              maxWidth="Infinity" style="-fx-background-radius: 5;">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="Hiver 2025"/>
                                                                <String fx:value="Printemps 2025"/>
                                                                <String fx:value="Été 2025"/>
                                                                <String fx:value="Automne 2025"/>
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                    <Label text="💡 Détectée automatiquement selon la date de plantation"
                                                           style="-fx-text-fill: #2E7D32; -fx-font-size: 9; -fx-font-style: italic;"/>
                                                    
                                                    <Label text="Etat de la Culture *"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <ComboBox fx:id="cbEtatCulture" promptText="Sélectionner l'état"
                                                              maxWidth="Infinity" style="-fx-background-radius: 5;">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="en_croissance"/>
                                                                <String fx:value="récoltée"/>
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                    <Label fx:id="lblIndicationEtat" text="✅ Une nouvelle culture est automatiquement &quot;en croissance&quot;"
                                                           wrapText="true"
                                                           style="-fx-text-fill: #2E7D32; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Surface utilisée (ha) *" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <TextField fx:id="tfSurfaceUtilisee" promptText="Ex: 1.2" style="-fx-background-radius: 5;"/>
                                                    <Label fx:id="lblIndicationSurface" text="💡 Surface en hectares que cette culture occupera sur la parcelle"
                                                           wrapText="true"
                                                           style="-fx-text-fill: #aab0b5; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Rendement estimé (t/ha)" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <TextField fx:id="tfRendementEstime" promptText="Ex: 4.5" style="-fx-background-radius: 5;"/>
                                                    <Label text="💡 Production estimée en tonnes par hectare (optionnel)"
                                                           style="-fx-text-fill: #aab0b5; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Date de Plantation *"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <DatePicker fx:id="dpDatePlantation" promptText="Sélectionner"
                                                                style="-fx-background-radius: 5;" maxWidth="Infinity"/>
                                                    <Label text="💡 Par défaut aujourd'hui — la saison se met à jour automatiquement"
                                                           style="-fx-text-fill: #2E7D32; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Date de Récolte Prévue *"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <DatePicker fx:id="dpDateRecolte" promptText="Sélectionner"
                                                                style="-fx-background-radius: 5;" maxWidth="Infinity"/>
                                                    <Label text="💡 Les dates avant la plantation sont bloquées automatiquement"
                                                           style="-fx-text-fill: #2E7D32; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <Label text="Parcelle *"
                                                           style="-fx-text-fill: #b2bec3; -fx-font-size: 11;"/>
                                                    <ComboBox fx:id="cbParcelle" promptText="Choisir une parcelle"
                                                              maxWidth="Infinity" style="-fx-background-radius: 5;"/>
                                                    <Label fx:id="lblIndicationNbCultures" text="💡 Sélectionnez une parcelle pour voir les cultures possibles"
                                                           wrapText="true"
                                                           style="-fx-text-fill: #aab0b5; -fx-font-size: 9; -fx-font-style: italic;"/>

                                                    <VBox style="-fx-background-color: #E3F2FD; -fx-background-radius: 8; -fx-padding: 10;">
                                                        <Label text="📋 Règle métier"
                                                               style="-fx-text-fill: #1565C0; -fx-font-weight: bold; -fx-font-size: 11;"/>
                                                        <Label text="La date de plantation doit être antérieure à la date de récolte prévue."
                                                               wrapText="true"
                                                               style="-fx-text-fill: #1565C0; -fx-font-size: 10;"/>
                                                        <Label text="La surface utilisée ne doit pas dépasser la surface restante de la parcelle."
                                                               wrapText="true"
                                                               style="-fx-text-fill: #1565C0; -fx-font-size: 10;"/>
                                                        <Label text="Si la parcelle a une répartition, vous pouvez ajouter plusieurs cultures."
                                                               wrapText="true"
                                                               style="-fx-text-fill: #1565C0; -fx-font-size: 10;"/>
                                                    </VBox>
                                                </children>
                                            </VBox>
                                        </content>
                                    </javafx.scene.control.ScrollPane>

                                    <!-- Buttons -->
                                    <HBox spacing="10.0" alignment="CENTER" VBox.vgrow="ALWAYS">
                                        <padding>
                                            <Insets top="15.0"/>
                                        </padding>
                                        <children>
                                            <Button fx:id="btnAjouter" onAction="#ajouterCulture" text="Ajouter"
                                                    style="-fx-background-color: #116530; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                                    prefWidth="90.0"/>
                                            <Button fx:id="btnModifier" onAction="#modifierCulture" text="Modifier"
                                                    style="-fx-background-color: #4a8c3f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                                    prefWidth="90.0" visible="false"/>
                                            <Button fx:id="btnSupprimer" onAction="#supprimerCulture" text="Supprimer"
                                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"
                                                    prefWidth="90.0" visible="false"/>
                                        </children>
                                    </HBox>
                                    <Button onAction="#viderChamps" text="Annuler"
                                            style="-fx-background-color: transparent; -fx-text-fill: #95a5a6; -fx-underline: true; -fx-cursor: hand;"
                                            maxWidth="Infinity"/>

                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</AnchorPane>
