<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<VBox spacing="0" prefHeight="520.0" prefWidth="720.0"
      style="-fx-background-color: linear-gradient(to bottom right, #F5F7F0, #E8EBE0);"
      xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.neuron.ardhi.controllers.Parcelle_Cultures.MapPickerController">

    <!-- ===== HEADER ===== -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: white; -fx-padding: 14 22; -fx-border-color: #E0E8D0; -fx-border-width: 0 0 1 0;">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.07)" radius="8"/>
        </effect>
        <Rectangle width="4" height="22"
                   style="-fx-fill: #6B7F3F; -fx-arc-width: 3; -fx-arc-height: 3;"/>
        <VBox spacing="2">
            <Label text="📍 Sélection de l'Emplacement"
                   style="-fx-text-fill: #3D5B1A; -fx-font-weight: bold; -fx-font-size: 16;"/>
            <Label text="Cliquez sur la carte pour choisir la position de votre parcelle"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#confirmer" text="✅  Valider la position"
                style="-fx-background-color: #6B7F3F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 22;">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(107,127,63,0.35)" radius="10"/>
            </effect>
        </Button>
    </HBox>

    <!-- ===== MAP ===== -->
    <StackPane VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-color: #C8D5A0; -fx-border-width: 0 0 1 0;">
        <WebView fx:id="webView"/>
    </StackPane>

    <!-- ===== COORDINATES BAR ===== -->
    <HBox spacing="0" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 10 22; -fx-border-color: #E0E8D0; -fx-border-width: 1 0 0 0;">
        <!-- Latitude -->
        <VBox spacing="2" prefWidth="130">
            <Label text="Latitude" style="-fx-font-size: 10; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblLat" text="—"
                   style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #3D5B1A;"/>
        </VBox>
        <Separator orientation="VERTICAL" style="-fx-padding: 0 8;"/>
        <!-- Longitude -->
        <VBox spacing="2" prefWidth="140">
            <Label text="Longitude" style="-fx-font-size: 10; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblLon" text="—"
                   style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #3D5B1A;"/>
        </VBox>
        <Separator orientation="VERTICAL" style="-fx-padding: 0 8;"/>
        <!-- Address -->
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Adresse détectée" style="-fx-font-size: 10; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblAdresse" text="En attente de clic sur la carte..."
                   wrapText="true"
                   style="-fx-font-size: 12; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </HBox>

</VBox>
